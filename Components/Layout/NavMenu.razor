                <NavLink class="nav-link d-flex align-items-center" href="my-referrals">
                    <span class="bi bi-people-fill" style="font-size: 1.25rem; margin-right: 0.75rem; line-height: 1; vertical-align: text-bottom;" aria-hidden="true"></span> 
                    <span>My Referrals</span>
                </NavLink>

                <NavLink class="nav-link d-flex align-items-center" href="contact-us">
                    <span class="bi bi-chat-text-fill" style="font-size: 1.25rem; margin-right: 0.75rem; line-height: 1; vertical-align: text-bottom;" aria-hidden="true"></span> 
                    <span>Contact Us</span>
                </NavLink>
            }
        </div>
        <AuthorizeView>
            <Authorized>
                
@if (isAdmin)
                {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link d-flex align-items-center" href="admin/transactions">
                            <span class="bi bi-arrow-left-right" style="font-size: 1.25rem; margin-right: 0.75rem; line-height: 1;" aria-hidden="true"></span> 
                            <span>Transactions</span>
                            @if (transactionTasks > 0)
                            {
        
                                 <span class="badge rounded-pill bg-danger ms-2">@transactionTasks</span>
                            }
                        </NavLink>
                    
 </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link d-flex align-items-center" href="admin/creditlimits">
