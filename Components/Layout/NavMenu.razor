                    <div class="nav-item px-3">
                        <NavLink class="nav-link d-flex align-items-center" href="admin/referrals">
                            <span class="bi bi-person-lines-fill" style="font-size: 1.25rem; margin-right: 0.75rem; line-height: 1;" aria-hidden="true"></span> 
                            <span>Referrals</span>
                            @if (referralTasks > 0)
                            {
