                    </div>

                    <div class="nav-item px-3">
                        <NavLink class="nav-link d-flex align-items-center" href="admin/coverage">
                            <span class="bi bi-calendar-week" style="font-size: 1.25rem; margin-right: 0.75rem; line-height: 1;" aria-hidden="true"></span> 
                            <span>Coverage Schedule</span>
