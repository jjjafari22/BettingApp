                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
         
                    <NavLink class="nav-link" href="Account/Register">
                        <span class="bi bi-person-nav-menu" aria-hidden="true"></span> Register
                    </NavLink>
                </div>
                <div class="nav-item px-3">
     
                    <NavLink class="nav-link" href="Account/Login">
                        <span class="bi bi-person-badge-nav-menu" aria-hidden="true"></span> Login
                    </NavLink>
                </div>
            </NotAuthorized>
       
  </AuthorizeView>
    </nav>
</div>

@code {
    private string? currentUrl;
    private bool isAdmin;
    private int adminHomeTasks = 0;
    private int transactionTasks = 0;
    private int userTasks = 0;
    private int referralTasks = 0;

    private readonly SemaphoreSlim _refreshLock = new(1, 1);
    private System.Timers.Timer? _debounceTimer;
    private bool _isDisposed = false;
    private bool _hasPendingRefresh = false;

    protected override async Task OnInitializedAsync()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user.Identity?.IsAuthenticated == true)
            {
                using var context = DbFactory.CreateDbContext();
                var dbUser = await context.Users
                    .AsNoTracking()
                    .FirstOrDefaultAsync(u => u.UserName == user.Identity.Name);
                isAdmin = dbUser?.IsAdmin ?? false;

                if (isAdmin)
                {
                    UiNotifier.OnAdminNotification += HandleAdminNotification;
                    await RefreshTasksAsync();
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "NavMenu initialization error.");
        }
    }

    private void HandleAdminNotification(string? message)
    {
        if (_isDisposed) return;
        TriggerDebouncedRefresh();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        if (!_isDisposed)
        {
            try { _ = InvokeAsync(StateHasChanged); } catch { }
        }
        if (isAdmin)
        {
            TriggerDebouncedRefresh();
        }
    }

    private void TriggerDebouncedRefresh()
    {
        if (_isDisposed || !isAdmin) return;

        if (_debounceTimer == null)
        {
            _debounceTimer = new System.Timers.Timer(300); // 300ms debounce
            _debounceTimer.AutoReset = false;
            _debounceTimer.Elapsed += async (s, e) =>
            {
                await RefreshTasksAsync();
            };
        }

        _debounceTimer.Stop();
        _debounceTimer.Start();
    }

    private async Task RefreshTasksAsync()
    {
        if (_isDisposed || !isAdmin) return;

        // If another refresh is already in progress, flag it so a follow-up check runs after it finishes
        if (!await _refreshLock.WaitAsync(0))
        {
            _hasPendingRefresh = true;
            return;
        }

        try
        {
            do
            {
                _hasPendingRefresh = false;
                using var context = DbFactory.CreateDbContext();
                await LoadAdminTasks(context);
            } while (_hasPendingRefresh && !_isDisposed);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error refreshing admin tasks.");
        }
        finally
        {
            _refreshLock.Release();
        }
    }

    private async Task LoadAdminTasks(ApplicationDbContext context)
    {
        var twoMinsAgo = DateTime.UtcNow.AddMinutes(-2);

        // 1. Admin Home: pending bets + stuck processing bets + active approved bets
        var pendingBets = await context.Bets
            .AsNoTracking()
            .CountAsync(b => b.Status == "Pending" || (b.Status == "Processing" && b.CreatedAt < twoMinsAgo));
        var activeBets = await context.Bets
            .AsNoTracking()
            .CountAsync(b => b.Status == "Approved");
        int newAdminHomeTasks = pendingBets + activeBets;

        // 2. Transactions: pending withdrawals
        int newTransactionTasks = await context.Transactions
            .AsNoTracking()
            .CountAsync(t => t.Type == "Withdrawal" && t.Status == "Pending");

        // 3. All Users: unconfirmed registrations awaiting approval
        int newUserTasks = await context.Users
            .AsNoTracking()
            .CountAsync(u => !u.EmailConfirmed);

        // 4. Referrals: active eligible tiers + possible referrals
        int activeReferralTasks = 0;
        var activeRefs = await context.Referrals
            .AsNoTracking()
            .Where(r => !(r.Tier1Paid && r.Tier2Paid && r.Tier3Paid))
            .ToListAsync();

        if (activeRefs.Any())
        {
            var userIds = activeRefs.Select(r => r.ReferredUserId).Distinct().ToList();
            var turnovers = await context.Bets
                .AsNoTracking()
                .Where(b => userIds.Contains(b.UserId) && (b.Status == "Won" || b.Status == "Lost") && b.Odds >= 1.50m)
                .GroupBy(b => b.UserId)
                .Select(g => new { UserId = g.Key, Turnover = g.Sum(b => b.AmountNOK ?? 0) })
                .ToDictionaryAsync(x => x.UserId, x => x.Turnover);

            activeReferralTasks = activeRefs.Count(r => {
                var t = turnovers.GetValueOrDefault(r.ReferredUserId, 0);
                return (t >= 5000 && !r.Tier1Paid) || (t >= 15000 && !r.Tier2Paid) || (t >= 30000 && !r.Tier3Paid);
            });
        }

        var referredUserIds = await context.Referrals
            .AsNoTracking()
            .Select(r => r.ReferredUserId)
            .ToListAsync();

        var possibleReferrals = await context.Users
            .AsNoTracking()
            .Where(u => u.EmailConfirmed 
                     && !string.IsNullOrEmpty(u.ReferredBy) 
                     && !u.IsReferralDiscarded
                     && !referredUserIds.Contains(u.Id))
            .CountAsync();

        int newReferralTasks = activeReferralTasks + possibleReferrals;

        // Atomic assignment to instance variables only after all async work completes
        bool hasChanged = adminHomeTasks != newAdminHomeTasks ||
                          transactionTasks != newTransactionTasks ||
                          userTasks != newUserTasks ||
                          referralTasks != newReferralTasks;

        if (hasChanged && !_isDisposed)
        {
            adminHomeTasks = newAdminHomeTasks;
            transactionTasks = newTransactionTasks;
            userTasks = newUserTasks;
            referralTasks = newReferralTasks;
            try
            {
                await InvokeAsync(StateHasChanged);
            }
            catch (Exception) when (_isDisposed)
            {
                // Component disposed during invocation, ignore safely
            }
        }
    }

    public void Dispose()
    {
        _isDisposed = true;
        NavigationManager.LocationChanged -= OnLocationChanged;
        UiNotifier.OnAdminNotification -= HandleAdminNotification;
        if (_debounceTimer != null)
        {
            _debounceTimer.Stop();
            _debounceTimer.Dispose();
            _debounceTimer = null;
        }
        _refreshLock.Dispose();
    }
}