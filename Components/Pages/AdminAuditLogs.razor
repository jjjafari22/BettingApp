@page "/admin/auditlogs"
<PageTitle>Audit Logs - Castle of Happiness</PageTitle>
@using BettingApp.Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Authorization
@using BettingApp.Services
@using BettingApp.Components.Shared
@using System.Text.RegularExpressions
@attribute [Authorize]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject UiNotificationService UiNotifier
@implements IDisposable
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="d-flex align-items-center gap-2">
        <h3 class="mb-0"><i class="bi bi-clock-history me-2 text-primary"></i>Audit Logs</h3>
        <span class="badge bg-secondary rounded-pill fs-6">@totalLogs.ToString("N0")</span>
    </div>
</div>

@if (isInitializing)
{
    <LoadingData Text="Loading Audit Logs..." />
}
else if (!isAdmin)
{
    <div class="alert alert-danger">You are not authorized to view this page.</div>
}
else
{
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show mb-3 shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    <!-- Standardized Search & Filter Toolbar -->
    <div class="card shadow-sm border-0 mb-3">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <!-- 1. ID Filter (Smart Bet / Tx ID) -->
                <div class="col-6 col-md-2 col-lg-2">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white text-muted"><i class="bi bi-hash"></i></span>
                        <input type="text" class="form-control" 
                               @bind="idFilter" 
                               @bind:event="oninput"
                               @onkeyup="HandleKeyUp"
                               placeholder="Bet or Tx ID..." 
                               disabled="@isLoading" />
                        @if (!string.IsNullOrEmpty(idFilter))
                        {
                            <button class="btn btn-outline-secondary" type="button" disabled="@isLoading" @onclick="async () => { idFilter = string.Empty; await SearchLogs(); }">
                                <i class="bi bi-x"></i>
                            </button>
                        }
                    </div>
                </div>

                <!-- 2. Admin Dropdown Filter -->
                <div class="col-6 col-md-3 col-lg-2">
                    <select class="form-select form-select-sm" @bind="adminFilter" @bind:after="SearchLogs" disabled="@isLoading">
                        <option value="">All Admins</option>
                        @foreach (var opt in adminOptions)
                        {
                            <option value="@opt.Value">@opt.Label</option>
                        }
                    </select>
                </div>

                <!-- 3. User / Details Search -->
                <div class="col-12 col-md-4 col-lg-3">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control" 
                               @bind="targetFilter" 
                               @bind:event="oninput"
                               @onkeyup="HandleKeyUp"
                               placeholder="Search user or details..." 
                               disabled="@isLoading" />
                        @if (!string.IsNullOrEmpty(targetFilter))
                        {
                            <button class="btn btn-outline-secondary" type="button" disabled="@isLoading" @onclick="async () => { targetFilter = string.Empty; await SearchLogs(); }">
                                <i class="bi bi-x"></i>
                            </button>
                        }
                    </div>
                </div>

                <!-- 4. Action Dropdown Filter -->
                <div class="col-12 col-md-3 col-lg-2">
                    <select class="form-select form-select-sm" @bind="actionFilter" @bind:after="SearchLogs" disabled="@isLoading">
                        <option value="">All Actions</option>
                        <optgroup label="Bets">
                            <option value="group:bets">All Bet Actions</option>
                            <option value="Bet Approved">Bet Approved</option>
                            <option value="Bet Rejected">Bet Rejected</option>
                            <option value="Bet Won">Bet Won</option>
                            <option value="Bet Lost">Bet Lost</option>
                            <option value="Bet Void">Bet Void</option>
                            <option value="Bet Updated">Bet Updated</option>
                            <option value="Bet Undone">Bet Undone</option>
                            <option value="Auto-Settled Bet">Auto-Settled Bet</option>
                        </optgroup>
                        <optgroup label="Transactions">
                            <option value="group:transactions">All Transaction Actions</option>
                            <option value="Added Deposit">Added Deposit</option>
                            <option value="Added Withdrawal">Added Withdrawal</option>
                            <option value="Confirmed Withdrawal">Confirmed Withdrawal</option>
                            <option value="Rejected Withdrawal">Rejected Withdrawal</option>
                            <option value="Edited Pending Withdrawal">Edited Pending Withdrawal</option>
                            <option value="Cleared Fulfilled Withdrawal">Cleared Fulfilled Withdrawal</option>
                            <option value="Added Transfer">Added Transfer</option>
                            <option value="Paid Referral Bonus">Paid Referral Bonus</option>
                        </optgroup>
                        <optgroup label="Users & Security">
                            <option value="group:users">All User Admin Actions</option>
                            <option value="Approve Registration">Approve Registration</option>
                            <option value="Reject Registration">Reject Registration</option>
                            <option value="Toggle Verification">Toggle Verification</option>
                            <option value="Toggle Admin Role">Toggle Admin Role</option>
                            <option value="Toggle Test User">Toggle Test User</option>
                        </optgroup>
                        <optgroup label="Limits & System">
                            <option value="Changed Credit Limit">Changed Credit Limit</option>
                            <option value="Changed Max Liability">Changed Max Liability</option>
                            <option value="Changed System Settings">Changed System Settings</option>
                            <option value="Created Referral">Created Referral</option>
                            <option value="Deleted Referral">Deleted Referral</option>
                        </optgroup>
                    </select>
                </div>

                <!-- 5. Search & Reset Buttons -->
                <div class="col-12 col-md-12 col-lg-3 d-flex gap-2 justify-content-md-end">
                    <button class="btn btn-sm btn-primary flex-grow-1 flex-md-grow-0 px-3 fw-bold shadow-sm" @onclick="SearchLogs" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                            <span>Searching...</span>
                        }
                        else
                        {
                            <i class="bi bi-search me-1"></i>
                            <span>Search</span>
                        }
                    </button>
                    @if (HasActiveFilters)
                    {
                        <button class="btn btn-sm btn-outline-danger" @onclick="ClearFilters" disabled="@isLoading" title="Reset all filters">
                            <i class="bi bi-x-circle me-1"></i> Reset
                        </button>
                    }
                </div>
            </div>

            <!-- Bottom Row: Date Range Picker & Record Count -->
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-2 pt-2 border-top">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="text-muted small fw-bold"><i class="bi bi-calendar3 me-1"></i>Date Range:</span>
                    <DateRangePicker @bind-StartDate="startDate" @bind-EndDate="endDate" OnFilterApplied="SearchLogs" />
                </div>

                <div class="text-muted small">
                    Showing <strong class="text-dark">@logs.Count</strong> of <strong class="text-dark">@totalLogs.ToString("N0")</strong> logs
                </div>
            </div>
        </div>
    </div>

    <!-- Audit Logs Table -->
    <div class="card shadow-sm border-0 mb-3">
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="min-width: 95px;">Time</th>
                        <th style="min-width: 120px;">Admin</th>
                        <th style="min-width: 150px;">Action</th>
                        <th style="min-width: 95px;">Ref ID</th>
                        <th style="min-width: 160px;">Target User</th>
                        <th style="min-width: 220px;">Details</th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <div class="spinner-border text-primary mb-2" role="status"></div>
                                <div class="text-muted fw-semibold">Loading audit logs...</div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var log in logs)
                        {
                            var (refType, refId) = GetReferenceInfo(log);
                            var localTime = log.Timestamp.AddMinutes(-TimezoneOffset);
                            <tr>
                                <!-- Timestamp: Local time (HH:mm:ss on top, dd.MM.yyyy below) -->
                                <td class="text-nowrap py-1">
                                    <div class="fw-bold">@localTime.ToString("HH:mm:ss")</div>
                                    <div class="small text-muted">@localTime.ToString("dd.MM.yyyy")</div>
                                </td>

                                <!-- Admin: Full name display -->
                                <td>
                                    @if (log.AdminUserName == "SYSTEM_AUTO")
                                    {
                                        <span>SYSTEM_AUTO</span>
                                    }
                                    else
                                    {
                                        string displayName = adminNameLookup.TryGetValue(log.AdminUserName, out var name) && !string.IsNullOrEmpty(name) ? name : log.AdminUserName;
                                        <span>@displayName</span>
                                    }
                                </td>

                                <!-- Action -->
                                <td>
                                    <span class="badge @GetActionBadgeClass(log.Action) text-wrap text-start">@log.Action</span>
                                </td>

                                <!-- Ref ID: Unified Bet / Tx / Ref badge without trailing punctuation -->
                                <td>
                                    @if (refType == "Bet")
                                    {
                                        <span class="badge bg-primary text-white"><i class="bi bi-ticket-detailed me-1"></i>Bet #@refId</span>
                                    }
                                    else if (refType == "Tx")
                                    {
                                        <span class="badge bg-success text-white"><i class="bi bi-arrow-left-right me-1"></i>Tx #@refId</span>
                                    }
                                    else if (refType == "Ref")
                                    {
                                        <span class="badge bg-info text-dark"><i class="bi bi-people me-1"></i>Ref #@refId</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>

                                <!-- Target User: Discord username primary, Full name secondary -->
                                <td>
                                    @if (log.TargetUserName == "System")
                                    {
                                        <span class="badge bg-light text-dark border">System</span>
                                    }
                                    else if (log.TargetUserName == "Multiple")
                                    {
                                        <span class="badge bg-info text-dark">Multiple</span>
                                    }
                                    else if (userLookup.TryGetValue(log.TargetUserName, out var u))
                                    {
                                        @if (!string.IsNullOrEmpty(u.DiscordName))
                                        {
                                            <div><strong class="text-dark">@u.DiscordName</strong></div>
                                            <div class="small text-muted" title="@log.TargetUserName">@($"{u.FirstName} {u.LastName}".Trim())</div>
                                        }
                                        else if (!string.IsNullOrWhiteSpace(u.FirstName) || !string.IsNullOrWhiteSpace(u.LastName))
                                        {
                                            <div><strong>@($"{u.FirstName} {u.LastName}".Trim())</strong></div>
                                            <div class="small text-muted" title="@log.TargetUserName">@log.TargetUserName</div>
                                        }
                                        else
                                        {
                                            <span title="@log.TargetUserName">@log.TargetUserName</span>
                                        }
                                    }
                                    else
                                    {
                                        <span title="@log.TargetUserName">@log.TargetUserName</span>
                                    }
                                </td>

                                <!-- Details -->
                                <td class="small text-break" style="min-width: 220px;">
                                    @log.Details
                                </td>
                            </tr>
                        }
                        @if (logs.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">
                                    <i class="bi bi-inbox fs-3 d-block mb-1"></i>
                                    No logs found matching criteria.
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    @* Pagination Controls *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <button class="btn btn-sm @(currentPage <= 1 || isLoading ? "btn-outline-secondary" : "btn-primary shadow-sm")" @onclick="PrevPage" disabled="@(currentPage <= 1 || isLoading)">
            <i class="bi bi-arrow-left"></i> Previous
        </button>
        <span class="text-muted fw-bold small">
            @if (isLoading)
            {
                <span class="spinner-border spinner-border-sm text-secondary me-1" role="status"></span>
                <span>Loading...</span>
            }
            else
            {
                <span>Page @currentPage of @totalPages</span>
            }
        </span>
        <button class="btn btn-sm @(!hasNextPage || isLoading ? "btn-outline-secondary" : "btn-primary shadow-sm fw-bold")" @onclick="NextPage" disabled="@(!hasNextPage || isLoading)">
            Next <i class="bi bi-arrow-right"></i>
        </button>
    </div>
}

@code {
    private List<AuditLog> logs = new();
    private Dictionary<string, (string DiscordName, string FirstName, string LastName)> userLookup = new();
    private List<AdminOption> adminOptions = new();
    private Dictionary<string, string> adminNameLookup = new();
    
    private string targetFilter = "";
    private string actionFilter = "";
    private string adminFilter = "";
    private string idFilter = "";
    private DateTime? startDate;
    private DateTime? endDate;

    private bool HasActiveFilters => !string.IsNullOrWhiteSpace(targetFilter) 
                                  || !string.IsNullOrWhiteSpace(actionFilter) 
                                  || !string.IsNullOrWhiteSpace(adminFilter) 
                                  || !string.IsNullOrWhiteSpace(idFilter) 
                                  || startDate.HasValue 
                                  || endDate.HasValue;
    
    private int currentPage = 1;
    private const int pageSize = 25;
    private int totalLogs = 0;
    private bool isAdmin = false;
    private bool isInitializing = true;
    private int totalPages => totalLogs == 0 ? 1 : (int)Math.Ceiling((double)totalLogs / pageSize);
    private bool hasNextPage => currentPage < totalPages;
    private int TimezoneOffset { get; set; }
    private bool isLoading = false;
    private string? errorMessage;
    private CancellationTokenSource? _searchCts;

    private class AdminOption
    {
        public string Value { get; set; } = "";
        public string Label { get; set; } = "";
    }

    private static (string Type, string Id) GetReferenceInfo(AuditLog log)
    {
        if (string.IsNullOrEmpty(log.Details)) return ("", "");

        // 1. Explicit Bet patterns
        var betMatch = Regex.Match(log.Details, @"Bet ID:\s*(\d+)", RegexOptions.IgnoreCase);
        if (betMatch.Success)
        {
            return ("Bet", betMatch.Groups[1].Value);
        }

        // 2. Explicit Transaction patterns (matches single or comma-separated numbers, strips trailing punctuation)
        var txMatch = Regex.Match(log.Details, @"(?:Transaction ID|Tx ID|Trans ID):\s*([0-9]+(?:\s*,\s*[0-9]+)*)", RegexOptions.IgnoreCase);
        if (txMatch.Success)
        {
            var cleanId = txMatch.Groups[1].Value.Trim().TrimEnd(',', ' ', '.');
            return ("Tx", cleanId);
        }

        // 3. Transactions / withdrawals with "ID: 123"
        if (log.Action.Contains("Withdrawal") || log.Action.Contains("Deposit") || log.Action.Contains("Transfer") || log.Action.Contains("Transaction"))
        {
            var idMatch = Regex.Match(log.Details, @"(?:^|[\s,])ID:\s*([0-9]+(?:\s*,\s*[0-9]+)*)", RegexOptions.IgnoreCase);
            if (idMatch.Success)
            {
                var cleanId = idMatch.Groups[1].Value.Trim().TrimEnd(',', ' ', '.');
                return ("Tx", cleanId);
            }
        }

        // 4. Referral patterns
        if (log.Action.Contains("Referral"))
        {
            var refMatch = Regex.Match(log.Details, @"(?:Referral ID|Ref ID):\s*(\d+)", RegexOptions.IgnoreCase);
            if (refMatch.Success)
            {
                return ("Ref", refMatch.Groups[1].Value);
            }
        }

        // 5. Generic fallback
        var genericMatch = Regex.Match(log.Details, @"(?:^|[\s,])ID:\s*(\d+)", RegexOptions.IgnoreCase);
        if (genericMatch.Success)
        {
            return (log.Action.StartsWith("Bet") ? "Bet" : "Ref", genericMatch.Groups[1].Value);
        }

        return ("", "");
    }

    private static string GetActionBadgeClass(string action)
    {
        if (string.IsNullOrWhiteSpace(action)) return "bg-secondary";
        if (action.Contains("Approved") || action.Contains("Deposit") || action.Contains("Confirmed") || action.Contains("Approve Registration"))
            return "bg-success";
        if (action.Contains("Rejected") || action.Contains("Lost") || action.Contains("Reject Registration"))
            return "bg-danger";
        if (action.Contains("Won") || action.Contains("Paid Referral"))
            return "bg-primary";
        if (action.Contains("Void") || action.Contains("Undone") || action.Contains("Edited") || action.Contains("Cleared"))
            return "bg-warning text-dark";
        if (action.Contains("Updated") || action.Contains("Auto-Settled") || action.Contains("Created Referral"))
            return "bg-info text-dark";
        return "bg-secondary";
    }

    private async Task LoadAdminsAsync()
    {
        try
        {
            using var context = DbFactory.CreateDbContext();
            var adminUsers = await context.Users
                .Where(u => u.IsAdmin)
                .Select(u => new { u.UserName, u.Email, u.FirstName, u.LastName, u.DiscordUsername })
                .ToListAsync();

            foreach (var a in adminUsers)
            {
                string fullName = $"{a.FirstName} {a.LastName}".Trim();
                string displayName = !string.IsNullOrEmpty(fullName) 
                    ? fullName 
                    : (!string.IsNullOrEmpty(a.DiscordUsername) ? a.DiscordUsername : (a.UserName ?? "Admin"));

                if (!string.IsNullOrEmpty(a.UserName)) adminNameLookup[a.UserName] = displayName;
                if (!string.IsNullOrEmpty(a.Email)) adminNameLookup[a.Email] = displayName;
            }

            var options = new List<AdminOption>();

            foreach (var a in adminUsers)
            {
                string fullName = $"{a.FirstName} {a.LastName}".Trim();
                string displayName = !string.IsNullOrEmpty(fullName) 
                    ? fullName 
                    : (!string.IsNullOrEmpty(a.DiscordUsername) ? a.DiscordUsername : (a.UserName ?? "Admin"));

                if (!string.IsNullOrEmpty(a.UserName)) adminNameLookup[a.UserName] = displayName;
                if (!string.IsNullOrEmpty(a.Email)) adminNameLookup[a.Email] = displayName;

                if (!string.IsNullOrEmpty(a.UserName) && !options.Any(o => o.Label == displayName))
                {
                    options.Add(new AdminOption { Value = a.UserName, Label = displayName });
                }
            }

            adminNameLookup["SYSTEM_AUTO"] = "SYSTEM_AUTO";
            options.Add(new AdminOption { Value = "SYSTEM_AUTO", Label = "SYSTEM_AUTO" });

            adminOptions = options.OrderBy(o => o.Label == "SYSTEM_AUTO" ? 1 : 0).ThenBy(o => o.Label).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[AdminAuditLogs] Error loading admins: {ex.Message}");
        }
    }

    private async Task PopulateUserLookup(IEnumerable<string> targetUserNames)
    {
        var missingNames = targetUserNames
            .Where(n => !string.IsNullOrEmpty(n) && n != "System" && n != "Multiple")
            .Except(userLookup.Keys)
            .Distinct()
            .ToList();

        if (missingNames.Any())
        {
            using var context = DbFactory.CreateDbContext();
            var users = await context.Users
                .Where(u => missingNames.Contains(u.UserName!) || (u.Email != null && missingNames.Contains(u.Email)))
                .Select(u => new { u.UserName, u.Email, u.DiscordUsername, u.FirstName, u.LastName })
                .ToListAsync();

            foreach (var u in users)
            {
                var data = (u.DiscordUsername ?? "", u.FirstName ?? "", u.LastName ?? "");
                if (!string.IsNullOrEmpty(u.UserName)) userLookup[u.UserName] = data;
                if (!string.IsNullOrEmpty(u.Email)) userLookup[u.Email] = data;
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            using var context = DbFactory.CreateDbContext();
            if (user.Identity?.IsAuthenticated == true)
            {
                var dbUser = await context.Users.AsNoTracking().FirstOrDefaultAsync(u => u.UserName == user.Identity.Name);
                isAdmin = dbUser?.IsAdmin ?? false;
            }

            if (!isAdmin)
            {
                Nav.NavigateTo("/");
                return;
            }

            await LoadAdminsAsync();
            await LoadLogs();
            UiNotifier.OnAdminNotification += HandleAdminNotification;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[AdminAuditLogs] Error initializing: {ex.Message}");
        }
        finally
        {
            isInitializing = false;
        }
    }

    private bool _isDisposed = false;
    private System.Timers.Timer? _debounceTimer;

    private void HandleAdminNotification(string? msg)
    {
        if (_isDisposed) return;
        if (_debounceTimer == null)
        {
            _debounceTimer = new System.Timers.Timer(1000);
            _debounceTimer.AutoReset = false;
            _debounceTimer.Elapsed += async (s, e) =>
            {
                try
                {
                    if (_isDisposed) return;
                    await InvokeAsync(async () =>
                    {
                        try
                        {
                            await LoadLogs();
                            StateHasChanged();
                        }
                        catch { }
                    });
                }
                catch { }
            };
        }
        _debounceTimer.Stop();
        _debounceTimer.Start();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                TimezoneOffset = await JS.InvokeAsync<int>("getBrowserTimeZoneOffset");
                StateHasChanged();
            }
            catch { }
        }
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchLogs();
        }
    }

    private async Task ClearFilters()
    {
        targetFilter = "";
        actionFilter = "";
        adminFilter = "";
        idFilter = "";
        startDate = null;
        endDate = null;
        currentPage = 1;
        errorMessage = null;
        await LoadLogs();
    }

    private async Task SearchLogs()
    {
        currentPage = 1;
        await LoadLogs();
    }

    private async Task LoadLogs()
    {
        if (_isDisposed) return;

        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = new CancellationTokenSource();
        var ct = _searchCts.Token;

        isLoading = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            using var context = DbFactory.CreateDbContext();
            var query = context.AuditLogs.AsNoTracking();

            if (!string.IsNullOrWhiteSpace(targetFilter))
            {
                var term = targetFilter.Trim();
                var matchingUserNames = await context.Users
                    .Where(u => (u.DiscordUsername != null && u.DiscordUsername.Contains(term)) 
                             || (u.FirstName != null && u.FirstName.Contains(term))
                             || (u.LastName != null && u.LastName.Contains(term))
                             || (u.UserName != null && u.UserName.Contains(term))
                             || (u.Email != null && u.Email.Contains(term)))
                    .Select(u => u.UserName)
                    .ToListAsync(ct);

                query = query.Where(l => matchingUserNames.Contains(l.TargetUserName) 
                                      || l.TargetUserName.Contains(term)
                                      || l.Details.Contains(term));
            }

            if (!string.IsNullOrWhiteSpace(actionFilter))
            {
                if (actionFilter == "group:bets")
                {
                    query = query.Where(l => l.Action.StartsWith("Bet ") || l.Action == "Auto-Settled Bet");
                }
                else if (actionFilter == "group:transactions")
                {
                    query = query.Where(l => l.Action.Contains("Withdrawal") || l.Action.Contains("Deposit") || l.Action.Contains("Transfer") || l.Action.Contains("Referral Bonus"));
                }
                else if (actionFilter == "group:users")
                {
                    query = query.Where(l => l.Action.Contains("Registration") || l.Action.StartsWith("Toggle "));
                }
                else
                {
                    query = query.Where(l => l.Action.StartsWith(actionFilter));
                }
            }

            if (!string.IsNullOrWhiteSpace(adminFilter))
            {
                query = query.Where(l => l.AdminUserName == adminFilter);
            }

            if (!string.IsNullOrWhiteSpace(idFilter))
            {
                var rawTerm = idFilter.Trim();
                var numMatch = Regex.Match(rawTerm, @"\d+");
                var term = numMatch.Success ? numMatch.Value : rawTerm;

                bool isBetIntent = rawTerm.Contains("bet", StringComparison.OrdinalIgnoreCase)
                                   || rawTerm.StartsWith("#")
                                   || actionFilter == "group:bets" 
                                   || actionFilter.StartsWith("Bet ") 
                                   || actionFilter == "Auto-Settled Bet"
                                   || (int.TryParse(term, out int idVal) && idVal > 1000);

                bool isTxIntent = rawTerm.Contains("tx", StringComparison.OrdinalIgnoreCase)
                                  || rawTerm.Contains("trans", StringComparison.OrdinalIgnoreCase)
                                  || actionFilter == "group:transactions";

                var betPrefixComma = $"Bet ID: {term},";
                var betPrefixSpace = $"Bet ID: {term} ";
                var betPrefixDot = $"Bet ID: {term}.";

                if (isBetIntent)
                {
                    query = query.Where(l => l.Details.StartsWith(betPrefixComma) 
                                          || l.Details.StartsWith(betPrefixSpace)
                                          || l.Details.StartsWith(betPrefixDot));
                }
                else if (isTxIntent)
                {
                    var txPrefixComma = $"Transaction ID: {term},";
                    var txPrefixSpace = $"Transaction ID: {term} ";
                    var idComma = $"ID: {term},";
                    var idSpace = $"ID: {term} ";
                    var idColon = $"ID:{term}";
                    query = query.Where(l => l.Details.StartsWith(txPrefixComma)
                                          || l.Details.StartsWith(txPrefixSpace)
                                          || l.Details.Contains(idComma)
                                          || l.Details.Contains(idSpace)
                                          || l.Details.Contains(idColon)
                                          || l.Details.EndsWith("ID: " + term));
                }
                else
                {
                    var idComma = $"ID: {term},";
                    var idSpace = $"ID: {term} ";
                    query = query.Where(l => l.Details.StartsWith(betPrefixComma) 
                                          || l.Details.StartsWith(betPrefixSpace) 
                                          || l.Details.Contains(idComma) 
                                          || l.Details.Contains(idSpace) 
                                          || l.Details.EndsWith("ID: " + term));
                }
            }

            if (startDate.HasValue)
            {
                var startUtc = startDate.Value;
                query = query.Where(l => l.Timestamp >= startUtc);
            }

            if (endDate.HasValue)
            {
                var endUtc = endDate.Value;
                query = query.Where(l => l.Timestamp <= endUtc);
            }

            var pageResults = await query
                .OrderByDescending(l => l.Timestamp)
                .Skip((currentPage - 1) * pageSize)
                .Take(pageSize + 1)
                .ToListAsync(ct);

            if (currentPage == 1 && pageResults.Count <= pageSize)
            {
                totalLogs = pageResults.Count;
                logs = pageResults;
            }
            else
            {
                logs = pageResults.Take(pageSize).ToList();
                totalLogs = await query.CountAsync(ct);
            }

            await PopulateUserLookup(logs.Select(l => l.TargetUserName));
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[AdminAuditLogs] Error loading logs: {ex.Message}");
            errorMessage = "Failed to load audit logs. Please try narrowing your search criteria.";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task NextPage()
    {
        if (hasNextPage)
        {
            currentPage++;
            await LoadLogs();
        }
    }

    private async Task PrevPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            await LoadLogs();
        }
    }

    public void Dispose()
    {
        _isDisposed = true;
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        UiNotifier.OnAdminNotification -= HandleAdminNotification;
        _debounceTimer?.Dispose();
    }
}
