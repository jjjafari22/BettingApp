@page "/admin/settings"
<PageTitle>Settings - Castle of Happiness</PageTitle>
@using BettingApp.Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.SignalR
@using Microsoft.AspNetCore.SignalR.Client
@using BettingApp.Hubs
@attribute [Authorize]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject IHubContext<BetHub> HubContext
@inject BettingApp.Services.DiscordNotificationService DiscordService
@implements IAsyncDisposable
@rendermode @(new InteractiveServerRenderMode(prerender: true))

<h3>Admin Settings</h3>

@if (isLoading)
{
    <LoadingData Text="Loading Settings..." />
}
else if (!hasAccess)
{
    <div class="alert alert-danger">You are not authorized to view this page.</div>
}
else
{
    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    Global Betting Limits
                </div>
                <div class="card-body">
                    @if (showSuccess)
                    {
                        <div class="alert alert-success alert-dismissible fade show position-fixed top-0 start-50 translate-middle-x mt-4 shadow" role="alert" style="z-index: 1055; min-width: 300px;">
                            Settings updated successfully!
                            <button type="button" class="btn-close" @onclick="() => showSuccess = false"></button>
                        </div>
                    }

                    <EditForm Model="settings" OnValidSubmit="SaveSettings">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="mb-3">
                            <label for="minBet" class="form-label">Minimum Bet Amount (NOK)</label>
                            <InputNumber id="minBet" class="form-control" @bind-Value="settings.MinBetAmount" />
                            <div class="form-text">The minimum amount required for a single bet.</div>
                        </div>

                        @* Max Payout removed from here (now managed per-user in Credit / Liability) *@

                        <button type="submit" class="btn btn-primary">Save Changes</button>
                    </EditForm>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    Discord Integration
                </div>
                <div class="card-body">
                    @if (showDiscordSuccess)
                    {
                        var alertClass = discordMessage.StartsWith("Error") ? "alert-danger" : (discordMessage.StartsWith("Warning") ? "alert-warning" : "alert-success");
                        <div class="alert @alertClass alert-dismissible fade show position-fixed top-0 start-50 translate-middle-x mt-4 shadow" role="alert" style="z-index: 1055; min-width: 300px;">
                            @discordMessage
                            <button type="button" class="btn-close" @onclick="() => showDiscordSuccess = false"></button>
                        </div>
                    }
                    <p class="form-text mb-3">Manually invalidate the Discord channel cache. Use this to immediately recognize newly created user admin channels without waiting for the automatic 60-minute refresh.</p>
                    <button type="button" class="btn btn-secondary" @onclick="RefreshDiscordCache">
                        <i class="bi bi-arrow-clockwise"></i> Refresh Discord Channels Cache
                    </button>
                    <hr class="my-4" />
                    <p class="form-text mb-3">Sort all user text channels alphabetically within the <strong>Admins</strong>, <strong>Active Users</strong>, and <strong>Inactive Users</strong> categories.</p>
                    <button type="button" class="btn btn-outline-primary" @onclick="SortDiscordChannels">
                        <i class="bi bi-sort-alpha-down"></i> Sort Channels Alphabetically
                        @if (isSorting) {
                            <span class="spinner-border spinner-border-sm ms-2" role="status" aria-hidden="true"></span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private SystemSetting settings = new();
    private bool hasAccess = false;
    private bool isLoading = true;
    private bool showSuccess = false;
    private bool showDiscordSuccess = false;
    private string discordMessage = "";
    private bool isSorting = false;
    private string? currentAdminName;
    private HubConnection? hubConnection;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (HttpContext != null) return; // Prerendering: exit instantly to show spinner

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        currentAdminName = user.Identity?.Name;

        using var context = DbFactory.CreateDbContext();
        if (user.Identity?.IsAuthenticated == true)
        {
            var dbUser = await context.Users.AsNoTracking()
                .FirstOrDefaultAsync(u => u.UserName == user.Identity.Name);
            hasAccess = dbUser?.IsAdmin ?? false;
        }

        if (!hasAccess)
        {
            Nav.NavigateTo("/");
            return;
        }
            await LoadSettings(context);
            // --- SignalR Listener ---
            hubConnection = new HubConnectionBuilder()
                .WithUrl(Nav.ToAbsoluteUri("/bethub"))
                .Build();
            hubConnection.On<string>("ReceiveAdminNotification", async (message) =>
            {
                // If notification contains "Settings", reload
                if (message.Contains("Settings"))
                {
                    using var ctx = DbFactory.CreateDbContext();
                    await LoadSettings(ctx);
                    await InvokeAsync(StateHasChanged);
                }
            });
            await hubConnection.StartAsync();
            await hubConnection.InvokeAsync("JoinAdminGroup");
        isLoading = false;
    }

    private async Task LoadSettings(ApplicationDbContext context)
    {
        var existingSettings = await context.Settings.OrderBy(s => s.Id).FirstOrDefaultAsync();
        if (existingSettings == null)
        {
            // Default MinBet 100
            settings = new SystemSetting { MinBetAmount = 100m };
            context.Settings.Add(settings);
            await context.SaveChangesAsync();
        }
        else
        {
            settings = existingSettings;
        }
    }

    private async Task SaveSettings()
    {
        showSuccess = false;
        using var context = DbFactory.CreateDbContext();
        
        var dbSettings = await context.Settings.OrderBy(s => s.Id).FirstOrDefaultAsync();
        if (dbSettings != null)
        {
            var oldMinBet = dbSettings.MinBetAmount;

            dbSettings.MinBetAmount = settings.MinBetAmount;
            
            context.AuditLogs.Add(new AuditLog
            {
                AdminUserName = currentAdminName ?? "Unknown",
                Action = "Changed System Settings",
                TargetUserName = "System",
                Details = $"MinBet: {oldMinBet}->{settings.MinBetAmount}"
            });
            await context.SaveChangesAsync();
            
            // Notify other admins
            await HubContext.Clients.Group("Admins").SendAsync("ReceiveAdminNotification", "System Settings Updated");
            showSuccess = true;
        }
    }

    private void RefreshDiscordCache()
    {
        DiscordService.InvalidateChannelCache();
        discordMessage = "Discord cache refreshed successfully!";
        showDiscordSuccess = true;
    }

    private async Task SortDiscordChannels()
    {
        isSorting = true;
        StateHasChanged();

        try
        {
            discordMessage = await DiscordService.SortUserChannelsAlphabeticallyAsync();
            showDiscordSuccess = true;
        }
        catch (Exception ex)
        {
            discordMessage = $"Error sorting channels: {ex.Message}";
            showDiscordSuccess = true;
        }
        finally
        {
            isSorting = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}
