@page "/admin/settings"
<PageTitle>Settings - Castle of Happiness</PageTitle>
@using BettingApp.Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.SignalR
@using Microsoft.AspNetCore.SignalR.Client
@using BettingApp.Hubs
@attribute [Authorize]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject IHubContext<BetHub> HubContext
@inject BettingApp.Services.DiscordNotificationService DiscordService
@inject IJSRuntime JS
@implements IAsyncDisposable
@rendermode @(new InteractiveServerRenderMode(prerender: true))

<h3>Admin Settings</h3>

@if (isLoading)
{
    <LoadingData Text="Loading Settings..." />
}
else if (!hasAccess)
{
    <div class="alert alert-danger">You are not authorized to view this page.</div>
}
else
{
    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    Global Betting Limits
                </div>
                <div class="card-body">
                    @if (showSuccess)
                    {
                        <div class="alert alert-success alert-dismissible fade show position-fixed top-0 start-50 translate-middle-x mt-4 shadow" role="alert" style="z-index: 9999; min-width: 300px;">
                            Settings updated successfully!
                            <button type="button" class="btn-close" @onclick="() => showSuccess = false"></button>
                        </div>
                    }

                    <EditForm Model="settings" OnValidSubmit="SaveSettings">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="mb-3">
                            <label for="minBet" class="form-label">Minimum Bet Amount (NOK)</label>
                            <InputNumber id="minBet" class="form-control" @bind-Value="settings.MinBetAmount" />
                            <div class="form-text">The minimum amount required for a single bet.</div>
                        </div>

                        @* Max Payout removed from here (now managed per-user in Credit / Liability) *@

                        <button type="submit" class="btn btn-primary">Save Changes</button>
                    </EditForm>
                </div>
            </div>
            
        </div>
        <div class="col-md-6 mt-4 mt-md-0">
            <div class="card">
                <div class="card-header">
                    Discord Integration
                </div>
                <div class="card-body">
                    @if (showDiscordSuccess)
                    {
                        var alertClass = discordMessage.StartsWith("Error") ? "alert-danger" : (discordMessage.StartsWith("Warning") ? "alert-warning" : "alert-success");
                        <div class="alert @alertClass alert-dismissible fade show position-fixed top-0 start-50 translate-middle-x mt-4 shadow" role="alert" style="z-index: 9999; min-width: 300px;">
                            @discordMessage
                            <button type="button" class="btn-close" @onclick="() => showDiscordSuccess = false"></button>
                        </div>
                    }
                    <p class="form-text mb-3">Manually invalidate the Discord channel cache. Use this to immediately recognize newly created user admin channels without waiting for the automatic 60-minute refresh.</p>
                    <button type="button" class="btn btn-secondary" @onclick="RefreshDiscordCache">
                        <i class="bi bi-arrow-clockwise"></i> Refresh Discord Channels Cache
                    </button>
                    <hr class="my-4" />
                    <p class="form-text mb-3">Sort all user text channels alphabetically within the <strong>Admins</strong>, <strong>Active Users</strong>, and <strong>Inactive Users</strong> categories.</p>
                    <button type="button" class="btn btn-outline-primary" @onclick="SortDiscordChannels">
                        <i class="bi bi-sort-alpha-down"></i> Sort Channels Alphabetically
                        @if (isSorting) {
                            <span class="spinner-border spinner-border-sm ms-2" role="status" aria-hidden="true"></span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-secondary text-white">
                    <i class="bi bi-phone"></i> My Device Preferences
                </div>
                <div class="card-body">
                    @if (showPwaSuccess)
                    {
                        <div class="alert alert-success alert-dismissible fade show position-fixed top-0 start-50 translate-middle-x mt-4 shadow" role="alert" style="z-index: 9999; min-width: 300px;">
                            Preferences saved successfully!
                            <button type="button" class="btn-close" @onclick="() => showPwaSuccess = false"></button>
                        </div>
                    }
                    <p class="form-text mb-3">
                        <strong class="text-danger">⚠️ Applies to THIS browser/device only</strong><br />
                        By default, external bookmaker links (like Unibet) open in a new browser tab to keep you on the Admin page. If you have the native mobile app or PWA installed and prefer links to open inside the app instead, turn this on. (Note: Desktop computers will always safely ignore this setting).
                    </p>
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" id="openNativeAppsSwitch" checked="@openInNativeApp" @onchange="ToggleOpenNativeApp">
                        <label class="form-check-label fw-bold" for="openNativeAppsSwitch">Open bookies in installed apps (Disables new tabs)</label>
                    </div>
                    @if (openInNativeApp)
                    {
                        <div class="mb-3 mt-3 p-3 bg-light border rounded">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Unibet SE Android PWA Package</label>
                                    <div class="input-group">
                                        <input type="text" class="form-control" @bind="pwaPackageName" placeholder="e.g. org.chromium.webapk.a12345" />
                                        <button type="button" class="btn btn-primary" @onclick='() => SavePwaPackageName("unibetPwaPackageName", pwaPackageName)'>Save</button>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Pinnacle Android PWA Package</label>
                                    <div class="input-group">
                                        <input type="text" class="form-control" @bind="pwaPackagePinnacle" placeholder="e.g. org.chromium.webapk..." />
                                        <button type="button" class="btn btn-primary" @onclick='() => SavePwaPackageName("pinnaclePwaPackageName", pwaPackagePinnacle)'>Save</button>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Bet365 Android PWA Package</label>
                                    <div class="input-group">
                                        <input type="text" class="form-control" @bind="pwaPackageBet365" placeholder="e.g. org.chromium.webapk..." />
                                        <button type="button" class="btn btn-primary" @onclick='() => SavePwaPackageName("bet365PwaPackageName", pwaPackageBet365)'>Save</button>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Betsson Android PWA Package</label>
                                    <div class="input-group">
                                        <input type="text" class="form-control" @bind="pwaPackageBetsson" placeholder="e.g. org.chromium.webapk..." />
                                        <button type="button" class="btn btn-primary" @onclick='() => SavePwaPackageName("betssonPwaPackageName", pwaPackageBetsson)'>Save</button>
                                    </div>
                                </div>

                            </div>
                            <div class="form-text mt-3">
                                If your Android app was installed directly from Google Chrome (a WebAPK), Android may block normal links. 
                                Open a new tab in Chrome, go to <strong>chrome://webapks</strong>, find the bookie, and paste its exact Package Name here to force it to open.
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private SystemSetting settings = new();
    private bool hasAccess = false;
    private bool isLoading = true;
    private bool showSuccess = false;
    private bool showDiscordSuccess = false;
    private bool showPwaSuccess = false;
    private string discordMessage = "";
    private bool isSorting = false;
    private string? currentAdminName;
    private HubConnection? hubConnection;
    private bool openInNativeApp = false;
    private string pwaPackageName = "";
    private string pwaPackagePinnacle = "";
    private string pwaPackageBet365 = "";
    private string pwaPackageBetsson = "";

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (HttpContext != null) return; // Prerendering: exit instantly to show spinner

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        currentAdminName = user.Identity?.Name;

        using var context = DbFactory.CreateDbContext();
        if (user.Identity?.IsAuthenticated == true)
        {
            var dbUser = await context.Users.AsNoTracking()
                .FirstOrDefaultAsync(u => u.UserName == user.Identity.Name);
            hasAccess = dbUser?.IsAdmin ?? false;
        }

        if (!hasAccess)
        {
            Nav.NavigateTo("/");
            return;
        }
            await LoadSettings(context);
            // --- SignalR Listener ---
            hubConnection = new HubConnectionBuilder()
                .WithUrl(Nav.ToAbsoluteUri("/bethub"))
                .Build();
            hubConnection.On<string>("ReceiveAdminNotification", async (message) =>
            {
                // If notification contains "Settings", reload
                if (message.Contains("Settings"))
                {
                    using var ctx = DbFactory.CreateDbContext();
                    await LoadSettings(ctx);
                    await InvokeAsync(StateHasChanged);
                }
            });
            await hubConnection.StartAsync();
            await hubConnection.InvokeAsync("JoinAdminGroup");
        isLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && HttpContext == null)
        {
            try
            {
                var value = await JS.InvokeAsync<string>("localStorage.getItem", "openInNativeApp");
                if (!string.IsNullOrEmpty(value))
                {
                    openInNativeApp = value == "true";
                }
                var pkg = await JS.InvokeAsync<string>("localStorage.getItem", "unibetPwaPackageName");
                if (!string.IsNullOrEmpty(pkg)) pwaPackageName = pkg;

                var pkgPin = await JS.InvokeAsync<string>("localStorage.getItem", "pinnaclePwaPackageName");
                if (!string.IsNullOrEmpty(pkgPin)) pwaPackagePinnacle = pkgPin;

                var pkgBetsson = await JS.InvokeAsync<string>("localStorage.getItem", "betssonPwaPackageName");
                if (!string.IsNullOrEmpty(pkgBetsson)) pwaPackageBetsson = pkgBetsson;

                var pkgBet365 = await JS.InvokeAsync<string>("localStorage.getItem", "bet365PwaPackageName");
                if (!string.IsNullOrEmpty(pkgBet365)) pwaPackageBet365 = pkgBet365;


                if (!string.IsNullOrEmpty(value) || !string.IsNullOrEmpty(pkg) || !string.IsNullOrEmpty(pkgPin))
                {
                    StateHasChanged();
                }
            }
            catch { }
        }
    }

    private async Task ToggleOpenNativeApp(ChangeEventArgs e)
    {
        openInNativeApp = (bool)(e.Value ?? false);
        showPwaSuccess = false;
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", "openInNativeApp", openInNativeApp.ToString().ToLower());
            showPwaSuccess = true;
        }
        catch { }
    }

    private async Task SavePwaPackageName(string key, string value)
    {
        showPwaSuccess = false;
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", key, value.Trim());
            showPwaSuccess = true;
            StateHasChanged();
        }
        catch { }
    }

    private async Task LoadSettings(ApplicationDbContext context)
    {
        var existingSettings = await context.Settings.OrderBy(s => s.Id).FirstOrDefaultAsync();
        if (existingSettings == null)
        {
            // Default MinBet 100
            settings = new SystemSetting { MinBetAmount = 100m };
            context.Settings.Add(settings);
            await context.SaveChangesAsync();
        }
        else
        {
            settings = existingSettings;
        }
    }

    private async Task SaveSettings()
    {
        showSuccess = false;
        using var context = DbFactory.CreateDbContext();
        
        var dbSettings = await context.Settings.OrderBy(s => s.Id).FirstOrDefaultAsync();
        if (dbSettings != null)
        {
            var oldMinBet = dbSettings.MinBetAmount;

            dbSettings.MinBetAmount = settings.MinBetAmount;
            
            context.AuditLogs.Add(new AuditLog
            {
                AdminUserName = currentAdminName ?? "Unknown",
                Action = "Changed System Settings",
                TargetUserName = "System",
                Details = $"MinBet: {oldMinBet}->{settings.MinBetAmount}"
            });
            await context.SaveChangesAsync();
            
            // Notify other admins
            await HubContext.Clients.Group("Admins").SendAsync("ReceiveAdminNotification", "System Settings Updated");
            showSuccess = true;
        }
    }

    private void RefreshDiscordCache()
    {
        DiscordService.InvalidateChannelCache();
        _ = Task.Run(async () => await DiscordService.GetGuildTextChannelsAsync());
        discordMessage = "Discord cache refreshed successfully!";
        showDiscordSuccess = true;
    }

    private async Task SortDiscordChannels()
    {
        isSorting = true;
        StateHasChanged();

        try
        {
            discordMessage = await DiscordService.SortUserChannelsAlphabeticallyAsync();
            showDiscordSuccess = true;
        }
        catch (Exception ex)
        {
            discordMessage = $"Error sorting channels: {ex.Message}";
            showDiscordSuccess = true;
        }
        finally
        {
            isSorting = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}
