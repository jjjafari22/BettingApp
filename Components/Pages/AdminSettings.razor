@page "/admin/settings"
<PageTitle>Settings - Castle of Happiness</PageTitle>
@using BettingApp.Data
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<h3>Admin Settings</h3>

@if (isLoading)
{
    <LoadingData Text="Loading Settings..." />
}
else if (!hasAccess)
{
    <div class="alert alert-danger">You are not authorized to view this page.</div>
}
else
{
    @if (showSuccess)
    {
        <div class="alert alert-success alert-dismissible fade show position-fixed top-0 start-50 translate-middle-x mt-4 shadow" role="alert" style="z-index: 9999; min-width: 300px;">
            Settings updated successfully!
            <button type="button" class="btn-close" @onclick="() => showSuccess = false"></button>
        </div>
    }

    <div class="row">
        <div class="col-12">
            <div class="card border-primary shadow-sm">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <span class="fw-bold"><i class="bi bi-robot me-2"></i>Auto-Approval Engine</span>
                    <div @key="autoApprovalToggleKey" class="form-check form-switch mb-0 bg-white px-3 py-1 rounded-pill shadow-sm d-flex align-items-center" style="padding-left: 2.5rem !important;">
                        <input class="form-check-input me-2 mt-0" type="checkbox" id="autoApprovalMasterSwitch" style="cursor: pointer;"
                               checked="@settings.IsAutoApprovalEnabled"
                               @onchange="@(async (e) => await ToggleGlobalAutoApproval((bool)(e.Value ?? false)))" />
                        <label class="form-check-label fw-bold @(settings.IsAutoApprovalEnabled ? "text-success" : "text-secondary")" for="autoApprovalMasterSwitch" style="cursor: pointer;">
                            @(settings.IsAutoApprovalEnabled ? "Enabled" : "Disabled")
                        </label>
                    </div>
                </div>
                <div class="card-body">
                    <p class="form-text mb-3">
                        Bets are evaluated in order from <strong>Tier 1 &rarr; Tier 2 &rarr; Tier 3</strong>. Universal checks (Available Credit, User Max Liability, Minimum Bet Amount, and Per-User Auto-Approval permission) always apply across all tiers. Turning off the master switch above immediately cancels any active countdowns.
                    </p>
                    <EditForm Model="settings" OnValidSubmit="SaveAutoApprovalSettings">
                        <DataAnnotationsValidator />

                        <!-- High-Level Settings -->
                        <div class="p-3 mb-3 bg-light border rounded">
                            <h6 class="fw-bold mb-3"><i class="bi bi-sliders me-2 text-primary"></i>High-Level Settings</h6>
                            <div class="row g-3 align-items-stretch">
                                <div class="col-md-6">
                                    <label for="autoApproveDelay" class="form-label fw-bold">Countdown Timer (Seconds)</label>
                                    <InputNumber id="autoApproveDelay" class="form-control" @bind-Value="settings.AutoApprovalDelaySeconds" />
                                    <div class="form-text">Visible countdown before final re-verification and auto-approval (e.g. 180s).</div>
                                </div>
                                <div class="col-md-6">
                                    <div class="p-2 bg-white border rounded h-100 d-flex flex-column justify-content-center">
                                        <div class="form-check form-switch mb-1">
                                            <InputCheckbox id="autoApproveAllowLive" class="form-check-input" style="cursor: pointer;" @bind-Value="settings.AutoApprovalAllowLiveBets" />
                                            <label class="form-check-label fw-bold" for="autoApproveAllowLive" style="cursor: pointer;">
                                                Allow Auto-Approval of Live Bets
                                            </label>
                                        </div>
                                        <div class="form-text mt-0">If off, any bet flagged as live or already in-play in OddsPapi is blocked across all tiers.</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Tier 1: Pinnacle -->
                        <div class="card mb-3 border-primary">
                            <div class="card-header bg-primary bg-opacity-10 d-flex justify-content-between align-items-center py-2">
                                <div>
                                    <span class="badge bg-primary me-2">Tier 1</span>
                                    <span class="fw-bold text-dark">Pinnacle (Sharp Odds)</span>
                                </div>
                                <div class="form-check form-switch mb-0">
                                    <InputCheckbox id="tier1EnabledSwitch" class="form-check-input" style="cursor: pointer;" @bind-Value="settings.IsTier1PinnacleEnabled" />
                                    <label class="form-check-label fw-bold @(settings.IsTier1PinnacleEnabled ? "text-success" : "text-muted")" for="tier1EnabledSwitch" style="cursor: pointer;">
                                        @(settings.IsTier1PinnacleEnabled ? "Enabled" : "Disabled")
                                    </label>
                                </div>
                            </div>
                            <div class="card-body @(settings.IsTier1PinnacleEnabled ? "" : "opacity-50")">
                                <div class="form-text mb-3 mt-0">
                                    Evaluated first. Every leg must have active Pinnacle odds in OddsPapi with sufficient max bet limit and within the discrepancy threshold.
                                </div>
                                <div class="row g-3">
                                    <div class="col-md-3">
                                        <label for="tier1MaxStake" class="form-label fw-bold">Max Stake (NOK)</label>
                                        <InputNumber id="tier1MaxStake" class="form-control" @bind-Value="settings.AutoApprovalMaxStakeNOK" />
                                        <div class="form-text">Max stake for Tier 1.</div>
                                    </div>
                                    <div class="col-md-3">
                                        <label for="tier1MaxLiability" class="form-label fw-bold">Max Net Liability (NOK)</label>
                                        <InputNumber id="tier1MaxLiability" class="form-control" @bind-Value="settings.AutoApprovalMaxNetLiabilityNOK" />
                                        <div class="form-text">Max net liability for Tier 1.</div>
                                    </div>
                                    <div class="col-md-3">
                                        <label for="tier1MaxOverPin" class="form-label fw-bold">Max Above Pinnacle (%)</label>
                                        <div class="input-group">
                                            <InputNumber id="tier1MaxOverPin" step="0.1" class="form-control" @bind-Value="settings.AutoApprovalMaxOverPinnaclePercent" />
                                            <span class="input-group-text fw-bold">%</span>
                                        </div>
                                        <div class="form-text">
                                            At <strong>@settings.AutoApprovalMaxOverPinnaclePercent.ToString("0.#")%</strong>, Pinnacle <strong>2.00</strong> allows up to <strong>@((2.00m * (1m + settings.AutoApprovalMaxOverPinnaclePercent / 100m)).ToString("0.00"))</strong>.
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <label for="tier1MinPinLimit" class="form-label fw-bold">Min Pinnacle Limit (€)</label>
                                        <InputNumber id="tier1MinPinLimit" class="form-control" @bind-Value="settings.AutoApprovalMinPinnacleLimitEUR" />
                                        <div class="form-text">Min EUR limit required on each leg.</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Tier 2: Soft Bookies -->
                        <div class="card mb-3 border-info">
                            <div class="card-header bg-info bg-opacity-10 d-flex justify-content-between align-items-center py-2">
                                <div>
                                    <span class="badge bg-info text-dark me-2">Tier 2</span>
                                    <span class="fw-bold text-dark">Soft Bookies (Min. 2 Bookmakers Average)</span>
                                </div>
                                <div class="form-check form-switch mb-0">
                                    <InputCheckbox id="tier2EnabledSwitch" class="form-check-input" style="cursor: pointer;" @bind-Value="settings.IsTier2SoftBookiesEnabled" />
                                    <label class="form-check-label fw-bold @(settings.IsTier2SoftBookiesEnabled ? "text-success" : "text-muted")" for="tier2EnabledSwitch" style="cursor: pointer;">
                                        @(settings.IsTier2SoftBookiesEnabled ? "Enabled" : "Disabled")
                                    </label>
                                </div>
                            </div>
                            <div class="card-body @(settings.IsTier2SoftBookiesEnabled ? "" : "opacity-50")">
                                <div class="form-text mb-3 mt-0">
                                    Evaluated if Tier 1 does not match (e.g. player specials without Pinnacle odds). Requires at least <strong>2 bookmakers</strong> (across Pinnacle, Unibet, Coolbet, Bet365, Betsson) to return valid odds for each leg, comparing user leg odds against their average.
                                </div>
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <label for="tier2MaxStake" class="form-label fw-bold">Max Stake (NOK)</label>
                                        <InputNumber id="tier2MaxStake" class="form-control" @bind-Value="settings.Tier2MaxStakeNOK" />
                                        <div class="form-text">Max stake for Tier 2.</div>
                                    </div>
                                    <div class="col-md-4">
                                        <label for="tier2MaxLiability" class="form-label fw-bold">Max Net Liability (NOK)</label>
                                        <InputNumber id="tier2MaxLiability" class="form-control" @bind-Value="settings.Tier2MaxNetLiabilityNOK" />
                                        <div class="form-text">Max net liability for Tier 2.</div>
                                    </div>
                                    <div class="col-md-4">
                                        <label for="tier2MaxOverAvg" class="form-label fw-bold">Max Above Bookie Average (%)</label>
                                        <div class="input-group">
                                            <InputNumber id="tier2MaxOverAvg" step="0.1" class="form-control" @bind-Value="settings.Tier2MaxOverBookieAvgPercent" />
                                            <span class="input-group-text fw-bold">%</span>
                                        </div>
                                        <div class="form-text">
                                            At <strong>@settings.Tier2MaxOverBookieAvgPercent.ToString("0.#")%</strong>, Avg <strong>2.00</strong> allows up to <strong>@((2.00m * (1m + settings.Tier2MaxOverBookieAvgPercent / 100m)).ToString("0.00"))</strong>.
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Tier 3: Small Stake -->
                        <div class="card mb-3 border-success">
                            <div class="card-header bg-success bg-opacity-10 d-flex justify-content-between align-items-center py-2">
                                <div>
                                    <span class="badge bg-success me-2">Tier 3</span>
                                    <span class="fw-bold text-dark">Small Stake (No Bookmaker Odds Required)</span>
                                </div>
                                <div class="form-check form-switch mb-0">
                                    <InputCheckbox id="tier3EnabledSwitch" class="form-check-input" style="cursor: pointer;" @bind-Value="settings.IsTier3SmallStakeEnabled" />
                                    <label class="form-check-label fw-bold @(settings.IsTier3SmallStakeEnabled ? "text-success" : "text-muted")" for="tier3EnabledSwitch" style="cursor: pointer;">
                                        @(settings.IsTier3SmallStakeEnabled ? "Enabled" : "Disabled")
                                    </label>
                                </div>
                            </div>
                            <div class="card-body @(settings.IsTier3SmallStakeEnabled ? "" : "opacity-50")">
                                <div class="form-text mb-3 mt-0">
                                    Evaluated if Tier 1 and Tier 2 do not match. Auto-approves low-stake bets regardless of odds or whether any bookmakers return odds, provided credit, liability, and high-level settings are satisfied.
                                </div>
                                <div class="row g-3 align-items-stretch">
                                    <div class="col-md-4">
                                        <label for="tier3MaxStake" class="form-label fw-bold">Max Stake (NOK)</label>
                                        <InputNumber id="tier3MaxStake" class="form-control" @bind-Value="settings.Tier3MaxStakeNOK" />
                                        <div class="form-text">Bets at or below this stake (e.g. 200 kr) auto-approve without bookmaker odds checks.</div>
                                    </div>
                                    <div class="col-md-4">
                                        <label for="tier3MaxLiability" class="form-label fw-bold">Max Net Liability (NOK)</label>
                                        <InputNumber id="tier3MaxLiability" class="form-control" @bind-Value="settings.Tier3MaxNetLiabilityNOK" />
                                        <div class="form-text">Max net liability for Tier 3 (in addition to the user's personal liability limit).</div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="p-2 bg-light border rounded h-100 d-flex flex-column justify-content-center">
                                            <div class="form-check form-switch mb-1">
                                                <InputCheckbox id="autoApproveAllowBetBuilder" class="form-check-input" style="cursor: pointer;" @bind-Value="settings.AutoApprovalAllowBetBuilders" />
                                                <label class="form-check-label fw-bold" for="autoApproveAllowBetBuilder" style="cursor: pointer;">
                                                    Allow Auto-Approval of Bet Builders
                                                </label>
                                            </div>
                                            <div class="form-text mt-0">If on, Bet Builders within Tier 3 stake and liability limits can be auto-approved.</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mt-3">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check2-circle me-1"></i> Save Auto-Approval Criteria
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header">
                    Global Betting Limits
                </div>
                <div class="card-body">
                    <EditForm Model="settings" OnValidSubmit="SaveSettings">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="mb-3">
                            <label for="minBet" class="form-label">Minimum Bet Amount (NOK)</label>
                            <InputNumber id="minBet" class="form-control" @bind-Value="settings.MinBetAmount" />
                            <div class="form-text">The minimum amount required for a single bet.</div>
                        </div>

                        <button type="submit" class="btn btn-primary">Save Changes</button>
                    </EditForm>
                </div>
            </div>
        </div>
        <div class="col-md-6 mt-4 mt-md-0">
            <div class="card h-100">
                <div class="card-header">
                    Discord Integration
                </div>
                <div class="card-body">
                    @if (showDiscordSuccess)
                    {
                        var alertClass = discordMessage.StartsWith("Error") ? "alert-danger" : (discordMessage.StartsWith("Warning") ? "alert-warning" : "alert-success");
                        <div class="alert @alertClass alert-dismissible fade show position-fixed top-0 start-50 translate-middle-x mt-4 shadow" role="alert" style="z-index: 9999; min-width: 300px;">
                            @discordMessage
                            <button type="button" class="btn-close" @onclick="() => showDiscordSuccess = false"></button>
                        </div>
                    }
                    <p class="form-text mb-3">Manually invalidate the Discord channel cache. Use this to immediately recognize newly created user admin channels without waiting for the automatic 60-minute refresh.</p>
                    <button type="button" class="btn btn-secondary" @onclick="RefreshDiscordCache">
                        <i class="bi bi-arrow-clockwise"></i> Refresh Discord Channels Cache
                    </button>
                    <hr class="my-4" />
                    <p class="form-text mb-3">Sort all user text channels alphabetically within the <strong>Admins</strong>, <strong>Active Users</strong>, and <strong>Inactive Users</strong> categories.</p>
                    <button type="button" class="btn btn-outline-primary" @onclick="SortDiscordChannels">
                        <i class="bi bi-sort-alpha-down"></i> Sort Channels Alphabetically
                        @if (isSorting)
                        {
                            <span class="spinner-border spinner-border-sm ms-2" role="status" aria-hidden="true"></span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-secondary text-white">
                    <i class="bi bi-phone"></i> My Device Preferences
                </div>
                <div class="card-body">
                    @if (showPwaSuccess)
                    {
                        <div class="alert alert-success alert-dismissible fade show position-fixed top-0 start-50 translate-middle-x mt-4 shadow" role="alert" style="z-index: 9999; min-width: 300px;">
                            Preferences saved successfully!
                            <button type="button" class="btn-close" @onclick="() => showPwaSuccess = false"></button>
                        </div>
                    }
                    <p class="form-text mb-3">
                        <strong class="text-danger">⚠️ Applies to THIS browser/device only</strong><br />
                        By default, external bookmaker links (like Unibet) open in a new browser tab to keep you on the Admin page. If you have the native mobile app or PWA installed and prefer links to open inside the app instead, turn this on. (Note: Desktop computers will always safely ignore this setting).
                    </p>
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" id="openNativeAppsSwitch" checked="@openInNativeApp" @onchange="ToggleOpenNativeApp">
                        <label class="form-check-label fw-bold" for="openNativeAppsSwitch">Open bookies in installed apps (Disables new tabs)</label>
                    </div>
                    @if (openInNativeApp)
                    {
                        <div class="mb-3 mt-3 p-3 bg-light border rounded">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Unibet SE Android PWA Package</label>
                                    <div class="input-group">
                                        <input type="text" class="form-control" @bind="pwaPackageName" placeholder="e.g. org.chromium.webapk.a12345" />
                                        <button type="button" class="btn btn-primary" @onclick='() => SavePwaPackageName("unibetPwaPackageName", pwaPackageName)'>Save</button>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Pinnacle Android PWA Package</label>
                                    <div class="input-group">
                                        <input type="text" class="form-control" @bind="pwaPackagePinnacle" placeholder="e.g. org.chromium.webapk..." />
                                        <button type="button" class="btn btn-primary" @onclick='() => SavePwaPackageName("pinnaclePwaPackageName", pwaPackagePinnacle)'>Save</button>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Bet365 Android PWA Package</label>
                                    <div class="input-group">
                                        <input type="text" class="form-control" @bind="pwaPackageBet365" placeholder="e.g. org.chromium.webapk..." />
                                        <button type="button" class="btn btn-primary" @onclick='() => SavePwaPackageName("bet365PwaPackageName", pwaPackageBet365)'>Save</button>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Betsson Android PWA Package</label>
                                    <div class="input-group">
                                        <input type="text" class="form-control" @bind="pwaPackageBetsson" placeholder="e.g. org.chromium.webapk..." />
                                        <button type="button" class="btn btn-primary" @onclick='() => SavePwaPackageName("betssonPwaPackageName", pwaPackageBetsson)'>Save</button>
                                    </div>
                                </div>
                                <div class="col-md-6 mt-3 mt-md-0">
                                    <label class="form-label fw-bold">Coolbet Android PWA Package</label>
                                    <div class="input-group">
                                        <input type="text" class="form-control" @bind="pwaPackageCoolbet" placeholder="e.g. org.chromium.webapk..." />
                                        <button type="button" class="btn btn-primary" @onclick='() => SavePwaPackageName("coolbetPwaPackageName", pwaPackageCoolbet)'>Save</button>
                                    </div>
                                </div>
                            </div>
                            <div class="form-text mt-3">
                                If your Android app was installed directly from Google Chrome (a WebAPK), Android may block normal links.
                                Open a new tab in Chrome, go to <strong>chrome://webapks</strong>, find the bookie, and paste its exact Package Name here to force it to open.
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}
