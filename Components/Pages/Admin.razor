    private string SelectedOddsProvider { get; set; } = "oddspapi";

    private async Task SearchOdds(string? preSelectCategory = null)
    {
        if (string.IsNullOrWhiteSpace(OddsSearchTeam)) return;
        
        preSelectCategory ??= ActiveLookupLeg?.Market;

        IsSearchingOdds = true;
        OddsLookupErrorMessage = null;
        OddsLookupWarningMessage = null;
        PapiSearchResult = null;
        SelectedPapiMarketId = "";
        StateHasChanged();

        BettingApp.Models.OddsPapiSearchResult? result;
        string? error;
        
        if (SelectedOddsProvider == "sgo")
        {
            (result, error) = await SgoApi.SearchOddsComparisonAsync(OddsSearchTeam, reviewingBetModel?.Id);
        }
        else
        {
            (result, error) = await OddsApi.SearchOddsComparisonAsync(OddsSearchTeam, reviewingBetModel?.Id);
        }
        
        if (result == null)
        {
            OddsLookupErrorMessage = error ?? "No OddsPapi matches found for that team, or error occurred.";
            Console.WriteLine($"[{DateTime.Now:MM-dd HH:mm:ss}] [Bet #{reviewingBetModel?.Id}] OddsPapi: {OddsLookupErrorMessage} (Searched: '{OddsSearchTeam}')");
        }
        else
        {
            PapiSearchResult = result;
            
            // Save the start time to the DB right away so we don't have to query AI for it later!
            if (reviewingBetModel != null && result.StartTime > DateTime.MinValue)
            {
                if (ActiveLookupLeg != null) 
                {
                    ActiveLookupLeg.StartTime = result.StartTime;
                }
                
                try
                {
                    using var context = DbFactory.CreateDbContext();
                    var dbBet = await context.Bets.FindAsync(reviewingBetModel.Id);
                    if (dbBet != null)
                    {
                        if (reviewingBetModel.MatchStartTime == null || result.StartTime < reviewingBetModel.MatchStartTime)
                        {
                            dbBet.MatchStartTime = result.StartTime;
                            reviewingBetModel.MatchStartTime = result.StartTime;
                            if (originalBetModel != null) originalBetModel.MatchStartTime = result.StartTime;
                        }
                        
                        if (AiVisionResult != null)
                        {
                            dbBet.AiVisionResultJson = System.Text.Json.JsonSerializer.Serialize(AiVisionResult);
                            reviewingBetModel.AiVisionResultJson = dbBet.AiVisionResultJson;
                            if (originalBetModel != null) originalBetModel.AiVisionResultJson = dbBet.AiVisionResultJson;
                        }
                        
                        await context.SaveChangesAsync();
                    }
                }
                catch { /* Best effort */ }
            }

            if (result.Markets.Count == 0)
            {
                OddsLookupWarningMessage = "Match found, but OddsPapi returned 0 markets for Unibet SE, Betsson, and Bet365.";
                Console.WriteLine($"[{DateTime.Now:MM-dd HH:mm:ss}] [Bet #{reviewingBetModel?.Id}] OddsPapi: {OddsLookupWarningMessage} (Match: {result.MatchName})");
            }
            else if (!string.IsNullOrEmpty(preSelectCategory))
            {
                var normalizedTargets = MarketMapper.NormalizeMarketName(preSelectCategory, ActiveLookupLeg?.Match);
                
                // Simple fuzzy matching against OddsPapi MarketName
                var simplify = (string s) => 
                {
                    var clean = s.ToLowerInvariant()
                                 .Replace("players", "player")
                                 .Replace("player's", "player")
                                 .Replace("shots", "shot")
                                 .Replace("cards", "card")
                                 .Replace("goals", "goal")
                                 .Replace("corners", "corner")
                                 .Replace("halves", "half");
                    return new string(clean.Where(char.IsLetterOrDigit).ToArray());
                };
                
                var simplifiedTargets = normalizedTargets.Select(t => simplify(t)).ToList();
                
                // 1. Try exact match first
                var bestMatch = result.Markets.FirstOrDefault(m => simplifiedTargets.Contains(simplify(m.MarketName)));
                
                // 2. Fallback to contains match if no exact match is found
                if (bestMatch == null)
                {
                    bestMatch = result.Markets.FirstOrDefault(m => 
                        simplifiedTargets.Any(t => simplify(m.MarketName).Contains(t) || t.Contains(simplify(m.MarketName))));
                }

                bool isCanonicalTranslation = false;
                // 4. Fallback for Team Total Goals -> Over/Under [Team]
                if (bestMatch == null && simplifiedTargets.Any(t => t.Contains("teamtotalgoal")))
                {
                    if (ActiveLookupLeg != null && !string.IsNullOrEmpty(ActiveLookupLeg.Match) && !string.IsNullOrEmpty(ActiveLookupLeg.Selection))
                    {
                        var hcSplit = ActiveLookupLeg.Match.Split(new[] { " vs ", " v ", " - " }, StringSplitOptions.None);
                        if (hcSplit.Length >= 2)
                        {
                            string normSelRaw = BettingApp.Services.TeamAliasMappingService.RemoveDiacritics(ActiveLookupLeg.Selection).ToLowerInvariant();
                            string normT1 = BettingApp.Services.TeamAliasMappingService.RemoveDiacritics(hcSplit[0].Split('(')[0].Trim()).ToLowerInvariant();
                            string normT2 = BettingApp.Services.TeamAliasMappingService.RemoveDiacritics(hcSplit[1].Split('(')[0].Trim()).ToLowerInvariant();
                            
                            string expectedTeamMarket = "";
                            if (normSelRaw.Contains(normT1)) expectedTeamMarket = simplify("Over Under Team 1");
                            else if (normSelRaw.Contains(normT2)) expectedTeamMarket = simplify("Over Under Team 2");
                            
                            if (!string.IsNullOrEmpty(expectedTeamMarket))
                            {
                                bestMatch = result.Markets.FirstOrDefault(m => simplify(m.MarketName) == expectedTeamMarket) ?? 
                                            result.Markets.FirstOrDefault(m => simplify(m.MarketName).Contains(expectedTeamMarket));
                                if (bestMatch != null) isCanonicalTranslation = true;
                            }
                        }
                    }
                }
                    
                if (bestMatch != null)
                {
                    SelectedPapiMarketId = bestMatch.MarketId;
                    
                    if (!isCanonicalTranslation && !simplifiedTargets.Any(t => t.StartsWith(simplify(bestMatch.MarketName)) || simplify(bestMatch.MarketName) == t))
                    {
                        OddsLookupWarningMessage = $"OddsPapi doesn't offer '{preSelectCategory}'. Showing '{bestMatch.MarketName}' instead.";
                        Console.WriteLine($"[{DateTime.Now:MM-dd HH:mm:ss}] [Bet #{reviewingBetModel?.Id}] OddsPapi: {OddsLookupWarningMessage} (Match: {result.MatchName})");
                    }
                }
                else
                {
                    OddsLookupWarningMessage = $"The betslip is for '{preSelectCategory}', but OddsPapi doesn't offer it for this match.";
                    Console.WriteLine($"[{DateTime.Now:MM-dd HH:mm:ss}] [Bet #{reviewingBetModel?.Id}] OddsPapi: {OddsLookupWarningMessage} (Match: {result.MatchName})");
                }
            }
            
            if (string.IsNullOrEmpty(SelectedPapiMarketId))
            {
                // Try to find a standard market
                var ftMatch = result.Markets.FirstOrDefault(m => m.MarketName.Contains("1x2", StringComparison.OrdinalIgnoreCase) || m.MarketName.Contains("Full Time", StringComparison.OrdinalIgnoreCase));
                if (ftMatch != null)
                {
                    SelectedPapiMarketId = ftMatch.MarketId;
                }
                else
                {
                    SelectedPapiMarketId = result.Markets.FirstOrDefault()?.MarketId ?? "";
                }
            }
        }

        IsSearchingOdds = false;
        StateHasChanged();
        
        if (ActiveLookupLeg != null && !string.IsNullOrEmpty(SelectedPapiMarketId))
        {
            // Give DOM a tiny moment to render the new table rows, then scroll
            _ = Task.Run(async () => {
                await Task.Delay(100);
                await InvokeAsync(async () => {
                    try {
                        await JSRuntime.InvokeVoidAsync("scrollToElementId", "highlighted-odds-row");
                    } catch { }
                });
            });
        }
    }



