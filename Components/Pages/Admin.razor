                                    <li>
                                        <button class="dropdown-item" @onclick="ExecuteAutoReadFromDropdown">
                                            <i class="bi bi-robot me-2 text-warning"></i> Re-run AI Auto-Read
                                        </button>
                                    </li>
                                    @if (reviewContext == "Approved" || reviewContext == "Completed")
                                    {
