    private string GetFallbackBookieUrl(string bookieKey, string matchName)
    {
        string searchTerm = "";
        if (!string.IsNullOrEmpty(matchName))
        {
            var tokens = matchName.Split(new[] { " vs ", " v ", " - " }, StringSplitOptions.RemoveEmptyEntries);
            if (tokens.Length > 0)
            {
                searchTerm = Uri.EscapeDataString(tokens[0].Trim());
            }
            else
            {
                searchTerm = Uri.EscapeDataString(matchName.Trim());
            }
        }

        switch (bookieKey.ToLower())
        {
            case "coolbet":
                return "https://www.coolbet.com/se/sports/recommendations";

            case "unibet.se":
            case "unibet":
                return "https://www.unibet.se/betting/sports/home";

            case "pinnacle+30":
            case "pinnacle":
                // Pinnacle's search isn't standard in URL, link to sports home
                return "https://www.pinnacle.com/en/";

            case "betsson":
                if (!string.IsNullOrEmpty(searchTerm))
                    return $"https://www.betsson.com/sv/odds/search?q={searchTerm}";
                return "https://www.betsson.com/sv/odds";

            case "bet365":
                // Bet365 uses complex hash routing for search, link to sports home
                return "https://www.bet365.com";

            default:
                return "";
        }
    }

    private string FormatBookieUrl(string url, string bookieKey = "")
    {
        if (openInNativeApp && isAndroid && !string.IsNullOrEmpty(url))
        {
            var strippedUrl = url.Replace("https://", "").Replace("http://", "");
            string pkgStr = "";
            string rawPkg = bookieKey switch
            {
                "unibet.se" => unibetPwaPackageName,
                "pinnacle" => pinnaclePwaPackageName,
                "betsson" => betssonPwaPackageName,
                "bet365" => bet365PwaPackageName,
                "coolbet" => coolbetPwaPackageName,
                _ => ""
            };

            if (!string.IsNullOrWhiteSpace(rawPkg))
            {
                var cleanPkg = rawPkg.Trim();
                if (cleanPkg.Contains("org.chromium.webapk."))
                {
                    var startIndex = cleanPkg.IndexOf("org.chromium.webapk.");
                    cleanPkg = cleanPkg.Substring(startIndex).Split(' ')[0];
                }
                pkgStr = $";package={cleanPkg}";
                
                if (bookieKey == "unibet.se" && strippedUrl.StartsWith("unibet.se"))
                {
                    strippedUrl = "www." + strippedUrl;
                }
            }
            return $"intent://{strippedUrl}#Intent;scheme=https;action=android.intent.action.VIEW;category=android.intent.category.BROWSABLE;category=android.intent.category.DEFAULT{pkgStr};end";
        }
        return url;
    }

    protected override async Task OnInitializedAsync()
    {
        if (HttpContext != null) return; // Prerendering: exit instantly to show spinner

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        currentAdminName = user.Identity?.Name;

        try
        {
            using var context = DbFactory.CreateDbContext();
            var currentUserName = user.Identity?.Name;
            var dbUser = currentUserName != null ? await context.Users.FirstOrDefaultAsync(u => u.UserName == currentUserName) : null;
            if (dbUser == null || !dbUser.IsAdmin)
            {
                Nav.NavigateTo("/");
                return;
            }
            discordChannels = await DiscordService.GetGuildTextChannelsAsync();
            await Task.WhenAll(LoadPendingBets(), LoadApprovedBets(), LoadCompletedBets());
            if (ReviewBetId.HasValue)
            {
                var targetBet = pendingBets.FirstOrDefault(b => b.Id == ReviewBetId.Value);
                if (targetBet == null) targetBet = approvedBets.FirstOrDefault(b => b.Id == ReviewBetId.Value);

                if (targetBet != null) StartReview(targetBet);
                else 
                {
                    var exists = await context.Bets.Include(b => b.AiEvaluation).AnyAsync(b => b.Id == ReviewBetId.Value);
                    if (exists) errorMessage = $"Bet #{ReviewBetId.Value} is already reviewed.";
                    else errorMessage = $"Bet #{ReviewBetId.Value} not found.";
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = "A database connection error occurred during initialization. Please refresh the page.";
            Console.WriteLine($"[Admin.razor] OnInitializedAsync DB Error: {ex.Message}");
        }
        finally
        {
            isInitializing = false;
        }
    }
    
    private async Task LoadPendingBets()
    {
        try
        {
            using var context = DbFactory.CreateDbContext();
            var twoMinsAgo = DateTime.UtcNow.AddMinutes(-2);
            var allPendingBets = await context.Bets.Include(b => b.AiEvaluation).Where(b => b.Status == "Pending" || (b.Status == "Processing" && b.CreatedAt < twoMinsAgo)).ToListAsync();
            totalPendingBets = allPendingBets.Count;
            
            pendingBets = allPendingBets
                .OrderBy(b => b.MatchStartTime.HasValue ? 1 : 0)
                .ThenBy(b => b.MatchStartTime)
                .ThenByDescending(b => b.CreatedAt)
                .Skip((pendingPage - 1) * pageSize)
                .Take(pageSize)
                .ToList();
                
            hasMorePendingBets = totalPendingBets > (pendingPage * pageSize);
            await PopulateUserLookup(pendingBets.Select(b => b.UserId));
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to load pending bets due to database error.";
            Console.WriteLine($"[Admin.razor] LoadPendingBets Error: {ex.Message}");
        }
    }

    private bool IsMissingAnyStartTime(Bet bet)
    {
        if (string.IsNullOrEmpty(bet.AiVisionResultJson)) return true;
        try {
            var res = System.Text.Json.JsonSerializer.Deserialize<BettingApp.Services.AiVisionExtractionResult>(bet.AiVisionResultJson);
            if (res?.Legs != null && res.Legs.Count > 0) {
                return res.Legs.Any(l => l.StartTime == null || l.StartTime <= DateTime.MinValue);
