    private async Task GenerateAndDownloadCsv(List<Bet> bets, string filename, string exportType)
    {
        await PopulateUserLookup(bets.Select(b => b.UserId));
        var sb = new System.Text.StringBuilder();

        string header = "ID,LastUpdatedLocal,LastUpdatedNorway,DiscordUsername,LastName,BetAmount,Odds,PotentialPayout,Status";
        if (exportType == "Active") header += ",NetLiability";
        if (exportType == "Completed") header += ",NetProfit";
        
        sb.AppendLine(header);

        foreach (var bet in bets)
        {
            var localTime = ToUserLocal(bet.UpdatedAt).ToString("g");
            var norwayTime = TimeHelpers.GetNorwayTime(bet.UpdatedAt).ToString("g");
            var discordName = userLookup.TryGetValue(bet.UserId, out var u) && !string.IsNullOrEmpty(u.DiscordName) ? u.DiscordName : bet.UserName;
            var lastName = userLookup.TryGetValue(bet.UserId, out var u2) ? u2.LastName : "";

            var line = $"{bet.Id},{EscapeCsv(localTime)},{EscapeCsv(norwayTime)},{EscapeCsv(discordName)},{EscapeCsv(lastName)},{bet.AmountNOK?.ToString()},{bet.Odds},{bet.PotentialPayout},{bet.Status}";

            if (exportType == "Active")
            {
                var netLiability = bet.PotentialPayout - ((decimal)(bet.AmountNOK ?? 0) - bet.FreeBetAmount);
                line += $",{netLiability}";
            }
            if (exportType == "Completed")
            {
                var netProfit = GetNetProfit(bet);
                line += $",{netProfit}";
            }

            sb.AppendLine(line);
        }

        await JSRuntime.InvokeVoidAsync("downloadCsv", filename, sb.ToString());
    }

    private string EscapeCsv(string field)
    {
        if (string.IsNullOrEmpty(field)) return "";
        // Escape existing quotes
        field = field.Replace("\"", "\"\"");
        
        // Wrap in quotes if it contains commas, quotes, or newlines
        if (field.Contains(",") || field.Contains("\"") || field.Contains("\n") || field.Contains("\r"))
        {
            return $"\"{field}\"";
        }
        
        return field;
    }

    private RenderFragment GetAiOutcomeBadge(string? outcomeResult) => builder =>
    {
        if (string.IsNullOrEmpty(outcomeResult)) return;

        if (outcomeResult == "Admin Override")
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "badge bg-success text-light shadow-sm");
            builder.AddContent(2, "✅ Admin Override");
            builder.CloseElement();
            return;
        }

        try
        {
            var parsed = System.Text.Json.JsonSerializer.Deserialize<BettingApp.Services.AiOutcomeResultData>(
                outcomeResult, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }
            );

            if (parsed != null && !string.IsNullOrEmpty(parsed.OverallStatus))
            {
                var lowerStatus = parsed.OverallStatus.ToLower();
                
                if (lowerStatus.Contains("won")) {
                    builder.OpenElement(0, "span");
                    builder.AddAttribute(1, "class", "badge bg-success text-light shadow-sm");
                    builder.AddContent(2, "✅ Won");
                    builder.CloseElement();
                } else if (lowerStatus.Contains("lost")) {
                    builder.OpenElement(0, "span");
                    builder.AddAttribute(1, "class", "badge bg-danger text-light shadow-sm");
                    builder.AddContent(2, "❌ Lost");
                    builder.CloseElement();
                } else if (lowerStatus.Contains("void")) {
                    builder.OpenElement(0, "span");
                    builder.AddAttribute(1, "class", "badge bg-secondary text-light shadow-sm");
                    builder.AddContent(2, "➖ Void");
                    builder.CloseElement();
                } else if (lowerStatus.Contains("unknown")) {
                    builder.OpenElement(0, "span");
                    builder.AddAttribute(1, "class", "badge bg-warning text-dark shadow-sm");
                    builder.AddContent(2, "❓ Unknown");
                    builder.CloseElement();
                } else if (lowerStatus.Contains("match in progress") || lowerStatus.Contains("pending") || lowerStatus.Contains("match not started")) {
                    builder.OpenElement(0, "span");
                    builder.AddAttribute(1, "class", "badge bg-info text-dark shadow-sm");
                    builder.AddContent(2, "⏳ Pending");
                    builder.CloseElement();
                }
                return;
            }
        }
        catch { }
    };

    private RenderFragment GetLivePlacedBadge(Bet bet, string cssClass = "ms-2") => __builder =>
    {
        if (!string.IsNullOrEmpty(bet.AiVisionResultJson))
        {
            try 
            {
                var extraction = System.Text.Json.JsonSerializer.Deserialize<BettingApp.Services.AiVisionExtractionResult>(bet.AiVisionResultJson, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                if (extraction != null && extraction.IsLive)
                {
                    <span class="badge bg-danger shadow-sm @cssClass" title="This bet was placed while the match was live/in-play.">
                        <i class="bi bi-broadcast me-1"></i> Live Bet
                    </span>
                }
            }
            catch { }
        }
    };

    private RenderFragment GetMonitoringStatusBadge(Bet bet) => __builder =>
    {
        if (ConfirmingOutcomeBetIds.Contains(bet.Id))
        {
            <span class="badge bg-info text-dark shadow-sm"><span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Checking</span>
        }
        else if (bet.NextCheckTime == null)
        {
            bool isFinished = false;
            if (!string.IsNullOrEmpty(bet.AiOutcomeResult))
            {
                try {
                    var doc = System.Text.Json.JsonDocument.Parse(bet.AiOutcomeResult);
                    if (doc.RootElement.TryGetProperty("overallStatus", out var statusProp))
                    {
                        var status = statusProp.GetString()?.Trim().ToUpperInvariant() ?? "";
                        isFinished = status == "WON" || status == "LOST" || status == "VOID" || status == "UNKNOWN" ||
                            status == "MATCH FINISHED - WON" || status == "MATCH WON" || 
                            status == "MATCH FINISHED - LOST" || status == "MATCH LOST" || 
                            status == "MATCH FINISHED - VOID" || status == "MATCH VOID";
                    }
                } catch { }
            }

            if (isFinished)
            {
                <span class="badge bg-secondary shadow-sm"><i class="bi bi-stop-circle me-1"></i> Stopped</span>
            }
            else
            {
                <span class="badge bg-info text-dark shadow-sm"><span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Checking</span>
            }
        }
        else
        {
            var now = DateTime.UtcNow;
            if (bet.MatchStartTime.HasValue && bet.MatchStartTime.Value > now)
            {
                <div class="d-flex flex-column align-items-start gap-1" title="Match hasn't started yet">
                    <span class="badge bg-warning text-dark shadow-sm">
                        <i class="bi bi-calendar-event me-1"></i> Starts @ToUserLocal(bet.MatchStartTime.Value).ToString("g")
                    </span>
                    <span class="badge bg-light text-dark border" style="font-size: 0.65em;">
                        Next Check: @ToUserLocal(bet.NextCheckTime.Value).ToString("g")
                    </span>
                </div>
            }
            else if (bet.NextCheckTime.Value <= now)
            {
                <span class="badge bg-info text-dark shadow-sm"><span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Checking</span>
            }
            else 
            {
                <div class="d-flex flex-column align-items-start gap-1" title="Match is in progress">
                    <span class="badge bg-success shadow-sm">
                        <i class="bi bi-activity me-1"></i> Live
                    </span>
                    <span class="badge bg-light text-dark border" style="font-size: 0.65em;">
                        Next Check: @ToUserLocal(bet.NextCheckTime.Value).ToString("g")
                    </span>
                </div>
            }
        }
    };
}
