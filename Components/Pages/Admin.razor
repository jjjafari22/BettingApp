                            <td><div class="d-flex flex-column align-items-start"><span>@bet.Id</span>@GetLivePlacedBadge(bet, "mt-1")</div></td>
                            <td class="text-nowrap">@ToUserLocal(bet.UpdatedAt).ToString("g")</td>
                            <td>
                                @{
                                    var u3Exists = userLookup.TryGetValue(bet.UserId, out var u3Discord);
                                    var u3Name = u3Exists && !string.IsNullOrEmpty(u3Discord.DiscordName) ? u3Discord.DiscordName : bet.UserName;
                                    var expectedChannel3 = $"{u3Name?.Trim().ToLower().Replace(" ", "-")}-admins";
                                    var matchedChannel3 = discordChannels.FirstOrDefault(c => string.Equals(c.Name, expectedChannel3, StringComparison.OrdinalIgnoreCase));
                                    var u3Link = matchedChannel3.Id != 0 
                                        ? $"https://discord.com/channels/{DiscordService.GuildId}/{matchedChannel3.Id}" 
                                        : $"https://discord.com/channels/{DiscordService.GuildId}";
                                }
                                <a href="@u3Link" target="_blank" class="text-decoration-none fw-bold">@u3Name</a>
                            </td>
                            <td>@(userLookup.TryGetValue(bet.UserId, out var u2) ? u2.LastName : "")</td>
                            <td>
                                @bet.AmountNOK?.ToString("N0") kr
                                @if (bet.FreeBetAmount > 0) {
                                    <br/><span class="badge bg-info text-dark small"><i class="bi bi-gift-fill"></i> Free Bet</span>
                                }
                            </td>
                            <td>@bet.Odds.ToString("N2")</td>
       
                            <td>
                                 <span class="badge @GetStatusBadgeClass(bet.Status)">@bet.Status</span>
                            </td>
               
                            <td>
                              @if(bet.Status == "Won") { @bet.PotentialPayout.ToString("N0") <span>kr</span> }
                              else if (bet.Status == "Lost") { <span>0 kr</span> }
                              else { <span class="text-muted">-</span> }
                            </td>
                            @{
                                var netProfit = GetNetProfit(bet);
                                var profitClass = netProfit > 0 ? "text-success" : (netProfit < 0 ? "text-danger" : "text-muted");
                            }
                            <td class="@profitClass fw-bold">@netProfit.ToString("N0") kr</td>
                        </tr>
                    }
      
                    @if (completedBets.Count == 0) { <tr><td colspan="11" class="text-muted">No completed bets found.</td></tr> }
            </tbody>
            </table>
            
            <div class="d-flex justify-content-between align-items-center mt-2 mb-4">
                <button class="btn btn-sm @(completedPage <= 1 ? "btn-outline-secondary" : "btn-primary shadow-sm")" @onclick="PrevPage" disabled="@(completedPage <= 1)"><i class="bi bi-arrow-left"></i> Previous</button>
                <span class="text-muted fw-bold">Page @completedPage</span>
                <button class="btn btn-sm @(!hasMoreCompletedBets ? "btn-outline-secondary" : "btn-primary shadow-sm fw-bold")" @onclick="NextPage" disabled="@(!hasMoreCompletedBets)">Next <i class="bi bi-arrow-right"></i></button>
            </div>
        </div>
    </div>
</div>

@code {
    private List<Bet> pendingBets = new();
    private List<Bet> approvedBets = new();
    private List<Bet> completedBets = new();
    private List<(ulong Id, string Name, string CategoryName)> discordChannels = new();
    private Dictionary<string, (string DiscordName, string LastName, string DiscordUserId)> userLookup = new();
    private int pendingPage = 1;
    private int approvedPage = 1;
    private string approvedSortColumn = "UpdatedAt";
    private bool approvedSortDesc = true;
    private int completedPage = 1;
    private int pageSize = 25;
    
    private bool showModalDropdown = false;
    
    private void ToggleModalDropdown()
    {
        showModalDropdown = !showModalDropdown;
        StateHasChanged();
    }
    
    private async Task ExecuteAutoReadFromDropdown()
    {
        showModalDropdown = false;
        await AnalyzeImageAsync();
    }

    private void ExecuteCheckOutcomeFromDropdown()
    {
        showModalDropdown = false;
        ConfirmOutcomeAsync();
    }

    private async Task ToggleAdminOverride()
    {
        showModalDropdown = false;
        if (reviewingBetModel != null)
        {
            using var context = DbFactory.CreateDbContext();
            var dbBet = await context.Bets.FindAsync(reviewingBetModel.Id);
            if (dbBet != null)
            {
                if (dbBet.AiOutcomeResult == "Admin Override")
                {
                    dbBet.AiOutcomeResult = ""; // Clear override
                }
                else
                {
                    dbBet.AiOutcomeResult = "Admin Override";
                }
                await context.SaveChangesAsync();
                reviewingBetModel.AiOutcomeResult = dbBet.AiOutcomeResult;
                
                await LoadCompletedBets();
                StateHasChanged();
            }
        }
    }

    private HashSet<string> completedStatusFilters = new() { "Won", "Lost", "Void", "Rejected", "Cancelled" };
    private bool showOnlyMismatch = false;
    private bool showOnlyAdminOverride = false;
    private string completedSearchBetId = "";
    
    private async Task ToggleFilter(string status)
    {
        if (completedStatusFilters.Contains(status))
            completedStatusFilters.Remove(status);
        else
            completedStatusFilters.Add(status);
            
        completedPage = 1;
        await LoadCompletedBets();
    }

    private async Task ToggleMismatchFilter()
    {
        showOnlyMismatch = !showOnlyMismatch;
        completedPage = 1;
        await LoadCompletedBets();
    }

    private async Task ToggleAdminOverrideFilter()
    {
        showOnlyAdminOverride = !showOnlyAdminOverride;
        completedPage = 1;
        await LoadCompletedBets();
    }

    private async Task OnCompletedSearchChanged()
    {
        completedPage = 1;
        await LoadCompletedBets();
    }

    private async Task ClearCompletedSearch()
    {
        completedSearchBetId = "";
        completedPage = 1;
        await LoadCompletedBets();
    }
    private bool hasMoreCompletedBets = false;
    private bool hasMoreApprovedBets = false;
    private bool hasMorePendingBets = false;
    private int totalCompletedBets = 0;
    private int totalPendingBets = 0;
    private int totalApprovedBets = 0;

    private string? _successMessage;
    private string? successMessage
    {
        get => _successMessage;
        set { _successMessage = value; if (value != null) AutoClearMessages(); }
    }

    private string? _errorMessage;
    private string? errorMessage
    {
        get => _errorMessage;
        set { _errorMessage = value; if (value != null) AutoClearMessages(); }
    }

    private string? _modalSuccessMessage;
    private string? modalSuccessMessage
    {
        get => _modalSuccessMessage;
        set { _modalSuccessMessage = value; if (value != null) AutoClearMessages(); }
    }

    private void AutoClearMessages()
    {
        _ = Task.Run(async () =>
        {
            await Task.Delay(5000);
            var changed = false;
            if (_successMessage != null) { _successMessage = null; changed = true; }
            if (_errorMessage != null) { _errorMessage = null; changed = true; }
            if (_modalSuccessMessage != null) { _modalSuccessMessage = null; changed = true; }
            if (changed) await InvokeAsync(StateHasChanged);
        });
    }
    private HubConnection? hubConnection;
    private string? currentAdminName;
    private Bet? reviewingBetModel;
    private System.Timers.Timer? uiRefreshTimer;
    private Bet? originalBetModel;
    private string? reviewErrorMessage;
    private decimal currentReviewUserFreeBalance = 0;
    



    private ElementReference reviewModalRef;
    private bool shouldFocusReviewModal = false;
    
    private List<Bet> currentReviewList = new();
    private int currentReviewIndex = -1;
    private string reviewContext = "";
    
    private bool showMobileScreenshot = false;
    private string resolvedScreenshotUrl = "";
    private Dictionary<string, string> localImageCache = new();

    private string GetScreenshotUrl(string? originalUrl)
    {
        return string.IsNullOrEmpty(resolvedScreenshotUrl) ? (originalUrl ?? "") : resolvedScreenshotUrl;
    }

    private async Task LoadResolvedScreenshotUrlAsync(string? originalUrl)
    {
        if (string.IsNullOrEmpty(originalUrl)) 
        {
            resolvedScreenshotUrl = "";
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (originalUrl.Contains("127.0.0.1:10000") || originalUrl.Contains("localhost:10000"))
        {
            if (localImageCache.TryGetValue(originalUrl, out var cachedData))
            {
                resolvedScreenshotUrl = cachedData;
                await InvokeAsync(StateHasChanged);
                return;
            }
            try 
            {
                using var client = new HttpClient();
                var bytes = await client.GetByteArrayAsync(originalUrl);
                var base64 = Convert.ToBase64String(bytes);
                var ext = originalUrl.EndsWith(".png") ? "png" : "jpeg";
                var dataUrl = $"data:image/{ext};base64,{base64}";
                localImageCache[originalUrl] = dataUrl;
                resolvedScreenshotUrl = dataUrl;
            } 
            catch 
            { 
                resolvedScreenshotUrl = originalUrl;
            }
        }
        else
        {
            resolvedScreenshotUrl = originalUrl;
        }
        await InvokeAsync(StateHasChanged);
    }

