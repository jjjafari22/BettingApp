                <button class="btn btn-sm rounded-pill @(completedStatusFilters.Contains("Rejected") ? "btn-dark shadow-sm" : "btn-outline-secondary bg-white text-muted")" style="font-weight: 500;" @onclick="@(() => ToggleFilter("Rejected"))" disabled="@(showOnlyMismatch || showOnlyAdminOverride)">Rejected</button>
                <button class="btn btn-sm rounded-pill @(completedStatusFilters.Contains("Cancelled") ? "btn-dark shadow-sm" : "btn-outline-secondary bg-white text-muted")" style="font-weight: 500;" @onclick="@(() => ToggleFilter("Cancelled"))" disabled="@(showOnlyMismatch || showOnlyAdminOverride)">Cancelled</button>
