@page "/admin"
<PageTitle>Admin Dashboard - Castle of Happiness</PageTitle>
@using Microsoft.AspNetCore.Authorization  
@using BettingApp.Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Authorization
@using BettingApp.Services
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject IDbContextFactory<ApplicationDbContext> DbFactory 
@inject UiNotificationService UiNotifier
@inject DiscordNotificationService DiscordService
@inject IJSRuntime JSRuntime
@inject BettingApp.Services.DialogService DialogService
@inject OddsApiService OddsApi

@inject AiVisionService AiVision
@inject MarketMappingService MarketMapper
@inject IServiceProvider ServiceProvider
@inject ILogger<Admin> Logger
@inject BettingApp.Services.BetProcessingService BetProcessor
@inject BettingApp.Services.AutoApprovalService AutoApproval
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IAsyncDisposable

<h3>Admin Dashboard</h3>

@if (isInitializing)
{
    <LoadingData Text="Loading Dashboard..." />
}
else if (!isAdmin)
{
    <div class="alert alert-danger">You are not authorized to view this page.</div>
}
else
{

@if (successMessage != null)
{
    <div class="alert alert-success alert-dismissible fade show position-fixed top-0 start-50 translate-middle-x mt-4 shadow" role="alert" style="z-index: 9999; min-width: 300px;">
        <i class="bi bi-bell-fill me-2"></i> @successMessage
        <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
    </div>
}
@if (errorMessage != null)
{
    <div class="alert alert-danger alert-dismissible fade show position-fixed top-0 start-50 translate-middle-x mt-4 shadow" role="alert" style="z-index: 9999; min-width: 300px;">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @errorMessage
        <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
    </div>
}

@if (reviewingBetModel != null)
{
    @if (showMobileScreenshot && !string.IsNullOrEmpty(reviewingBetModel.ScreenshotUrl)) {
        <div class="d-lg-none d-flex align-items-center justify-content-center" 
             style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.95); z-index: 2147483647; padding: 10px; pointer-events: none;">
            <img src="@GetScreenshotUrl(reviewingBetModel.ScreenshotUrl)" style="max-width: 100%; max-height: 100%; object-fit: contain;" />
        </div>
    }

  <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.85);" tabindex="-1" role="dialog" @ref="reviewModalRef" @onkeydown="OnReviewModalKeyDown">
        <div class="modal-dialog modal-xl modal-dialog-centered" role="document">
            <div class="modal-content review-modal-content position-relative">
                @if (isSavingBet)
                {
                    <div class="position-absolute top-0 start-0 w-100 h-100 d-flex flex-column align-items-center justify-content-center" style="background-color: rgba(255,255,255,0.75); backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px); z-index: 9999; border-radius: var(--bs-modal-border-radius);">
                        <div class="spinner-border text-primary mb-3" style="width: 3.5rem; height: 3.5rem; border-width: 0.3em;" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <h4 class="fw-bolder text-dark mb-1" style="text-shadow: 0 0 10px rgba(255,255,255,0.9);">Saving...</h4>
                        <p class="text-dark fw-bold mb-0">Please wait</p>
                    </div>
                }
                <div class="modal-header py-2 flex-shrink-0">
                    <div class="d-flex align-items-center w-100">
                 
                        <h5 class="modal-title fs-6 me-2 flex-grow-1" style="line-height: 1.4;">
                            <span class="badge @GetStatusBadgeClass(reviewingBetModel.Status) me-2 align-middle">@reviewingBetModel.Status</span>
                            @GetLivePlacedBadge(reviewingBetModel, "me-2 align-middle", isModalHeader: true)
                            <span class="align-middle">Bet #@reviewingBetModel.Id</span> 
                            <span class="text-muted ms-sm-2 fw-normal d-flex d-sm-inline-flex align-items-center flex-wrap mt-1 mt-sm-0" style="font-size: 0.9rem; word-break: break-all; gap: 0.35rem;">
                                @{
                                    var uModalExists = userLookup.TryGetValue(reviewingBetModel.UserId, out var uModal);
                                    var uModalName = uModalExists && !string.IsNullOrEmpty(uModal.DiscordName) ? uModal.DiscordName : reviewingBetModel.UserName;
                                    var uModalLink = userDiscordLinks.TryGetValue(reviewingBetModel.UserId, out var link1) ? link1 : $"https://discord.com/channels/{DiscordService.GuildId}";
                                }
                                <a href="@uModalLink" target="_blank" class="text-decoration-none fw-bold">@uModalName</a>
                                <span class="badge rounded-pill border @(currentReviewUserLifetimeProfit >= 0 ? "bg-success bg-opacity-10 border-success text-success" : "bg-danger bg-opacity-10 border-danger text-danger")" style="font-size: 0.75rem; font-weight: 600;" title="Lifetime Profit">
                                    LTP: @(currentReviewUserLifetimeProfit >= 0 ? "+" : "")@currentReviewUserLifetimeProfit.ToString("N0") kr
                                </span>
                            </span>
                        </h5>
                        <div class="dropdown me-2 flex-shrink-0" style="position: relative;">
                            <button class="btn btn-sm btn-outline-secondary border-0" type="button" @onclick="ToggleModalDropdown" @onclick:stopPropagation="true">
                                <i class="bi bi-three-dots-vertical"></i>
                            </button>
                            @if (showModalDropdown)
                            {
                                <ul class="dropdown-menu dropdown-menu-end shadow show" style="display:block; position:absolute; right: 0; z-index: 9999; margin-top: 5px;">
                                    <li>
                                        <button class="dropdown-item" @onclick="ExecuteAutoReadFromDropdown" disabled="@IsAnalyzingAutoRead(reviewingBetModel.Id)">
                                            @if (IsAnalyzingAutoRead(reviewingBetModel.Id)) {
                                                <span class="spinner-border spinner-border-sm me-2 text-warning" role="status" aria-hidden="true"></span>
                                                <span>Analyzing...</span>
                                            } else {
                                                <i class="bi bi-robot me-2 text-warning"></i> @(string.IsNullOrEmpty(reviewingBetModel.AiVisionResultJson) ? "AI Auto-Read" : "Re-run AI Auto-Read")
                                            }
                                        </button>
                                    </li>
                                    @if (reviewingBetModel != null && (reviewingBetModel.Status == "Approved" || reviewingBetModel.Status == "Won" || reviewingBetModel.Status == "Lost" || reviewingBetModel.Status == "Void" || reviewingBetModel.Status == "Completed" || reviewContext == "Approved" || reviewContext == "Completed"))
                                    {
                                        <li>
                                            <button class="dropdown-item" @onclick="ExecuteCheckOutcomeFromDropdown" disabled="@IsCheckingOutcome(reviewingBetModel.Id)">
                                                @if (IsCheckingOutcome(reviewingBetModel.Id)) {
                                                    <span class="spinner-border spinner-border-sm me-2 text-info" role="status" aria-hidden="true"></span>
                                                    <span>Checking...</span>
                                                } else {
                                                    <i class="bi bi-robot me-2 text-info"></i> @(string.IsNullOrEmpty(reviewingBetModel.AiOutcomeResult) ? "Check Outcome" : "Re-Check Outcome")
                                                }
                                            </button>
                                        </li>
                                    }
                                    @if (reviewingBetModel != null && (reviewingBetModel.Status == "Won" || reviewingBetModel.Status == "Lost" || reviewingBetModel.Status == "Void" || reviewingBetModel.Status == "Completed" || reviewContext == "Completed"))
                                    {
                                        <li>
                                            <button class="dropdown-item" @onclick="ToggleAdminOverride">
                                                <i class="bi bi-shield-check me-2 text-success"></i> @(reviewingBetModel?.AiOutcomeResult == "Admin Override" ? "Remove Admin Override" : "Set Admin Override")
                                            </button>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                        <!-- Header Navigation -->
                        <div class="d-flex align-items-center me-3 border-start ps-3" style="border-color: rgba(0,0,0,0.1) !important;">
                            <button class="header-nav-arrow" @onclick="() => NavigateReview(-1)" disabled="@(!CanNavigateReview(-1))" title="Previous Bet"><i class="bi bi-chevron-left"></i></button>
                            <button class="header-nav-arrow" style="margin-right:0;" @onclick="() => NavigateReview(1)" disabled="@(!CanNavigateReview(1))" title="Next Bet"><i class="bi bi-chevron-right"></i></button>
                        </div>
                        <button type="button" class="btn-close flex-shrink-0" @onclick="CancelReview"></button>
                    </div>
                </div>
              
 
                <div class="modal-body review-modal-body p-0">
                    <div class="row g-0 desktop-modal-row position-relative">
                        <!-- Left Column: Image -->
                        <div class="col-lg-6 position-relative bg-dark d-none d-lg-flex flex-column desktop-left-col" style="min-height: 400px; max-height: 100%;">
                            <div class="desktop-image-area position-relative p-2 d-flex align-items-center justify-content-center overflow-hidden">
                                @if (!string.IsNullOrEmpty(reviewingBetModel!.ScreenshotUrl)) {
                                    <img src="@GetScreenshotUrl(reviewingBetModel.ScreenshotUrl)" class="img-fluid rounded shadow" style="max-height: 100%; max-width: 100%; object-fit: contain;" alt="Bet Screenshot" />
                                } else {
                                    <div class="text-white-50 fst-italic text-center">
                                        <i class="bi bi-image-fill display-1 d-block mb-3"></i><span>No Image Available</span>
                                    </div>
                                }
                            </div>
                            
                            <!-- Left Fixed Actions Area -->
                            <div class="desktop-left-actions text-center pb-3 pt-3">
                                @if (!string.IsNullOrEmpty(reviewingBetModel.ScreenshotUrl)) {
                                    @if (reviewingBetModel.Status == "Pending" || reviewingBetModel.Status == "Processing") {
                                        bool showAnalyzing = IsAnalyzingAutoRead(reviewingBetModel.Id);
                                        bool hasRanAlready = !string.IsNullOrEmpty(reviewingBetModel.AiVisionResultJson);
                                        
                                        <button class="btn btn-warning shadow fw-bold rounded-pill px-3" @onclick="AnalyzeImageAsync" disabled="@showAnalyzing">
                                            @if (showAnalyzing) {
                                                <span class="spinner-border spinner-border-sm me-1"></span> <span>Analyzing...</span>
                                            } else {
                                                <i class="bi bi-robot me-1"></i> <span>@(hasRanAlready ? "Re-run AI" : "AI Auto-Read")</span>
                                            }
                                        </button>
                                    } else {
                                        <button class="btn btn-info text-white shadow fw-bold rounded-pill px-3" @onclick="ConfirmOutcomeAsync" disabled="@IsCheckingOutcome(reviewingBetModel.Id)">
                                            @if (IsCheckingOutcome(reviewingBetModel.Id)) {
                                                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                                <span>Checking...</span>
                                            } else {
                                                <i class="bi bi-robot me-1"></i> <span>@(string.IsNullOrEmpty(reviewingBetModel.AiOutcomeResult) ? "Check Outcome" : "Re-Check Outcome")</span>
                                            }
                                        </button>
                                    }
                                } else {
                                    <div style="height: 38px;"></div> <!-- placeholder to keep height consistent -->
                                }
                            </div>
                        </div>
                        
                        <!-- Right Column: Controls -->
                        <div class="col-lg-6 d-flex flex-column desktop-right-col p-0" style="max-height: 100%; background-color: #f8f9fa;">
                            <div class="desktop-right-scroll p-3 flex-grow-1 overflow-auto bg-white">

                            @if (!string.IsNullOrEmpty(reviewingBetModel.AiOutcomeResult) && (ParsedAiOutcome == null || (!ParsedAiOutcome.OverallStatus.ToLower().Contains("not started") && !ParsedAiOutcome.OverallStatus.ToLower().Contains("pending")))) {
                                <div class="alert alert-info alert-dismissible fade show shadow-sm mb-3" role="alert">
                                    @if (ParsedAiOutcome != null) {
                                        var statusLower = ParsedAiOutcome.OverallStatus.ToLower();
                                        var badgeClass = "badge bg-secondary";
                                        if (statusLower.Contains("won")) badgeClass = "badge bg-success";
                                        else if (statusLower.Contains("lost")) badgeClass = "badge bg-danger";
                                        else if (statusLower.Contains("in progress") || statusLower.Contains("live") || statusLower.Contains("not completed")) badgeClass = "badge text-bg-warning";
                                        else if (statusLower.Contains("not started") || statusLower.Contains("pending")) badgeClass = "badge text-bg-info";
                                        else if (statusLower.Contains("unknown")) badgeClass = "badge text-bg-secondary";
                                        
                                        <span class="@badgeClass fs-6">@ParsedAiOutcome.OverallStatus</span>
                                    } else if (reviewingBetModel.AiOutcomeResult.StartsWith("Error") || reviewingBetModel.AiOutcomeResult.StartsWith("Exception")) {
                                        <div class="alert alert-danger mb-0 p-2 text-wrap" style="word-break: break-all;"><i class="bi bi-exclamation-triangle-fill me-1"></i> @reviewingBetModel.AiOutcomeResult</div>
                                    } else {
                                        <span>Check complete (legacy format)</span>
                                    }
                                    @if (ParsedAiOutcome != null) {
                                        <button class="btn btn-sm btn-outline-info ms-2 py-0" @onclick="() => showFullAnalysis = !showFullAnalysis">
                                            @(showFullAnalysis ? "Hide Analysis" : "Show Full AI Analysis")
                                        </button>
                                        @if (showFullAnalysis) {
                                            <div class="mt-2 p-2 bg-white rounded text-dark small border shadow-sm" style="white-space: pre-line; max-height: 250px; overflow-y: auto;">
                                                @ParsedAiOutcome.FullAnalysis
                                            </div>
                                        }
                                    }
                                    <button type="button" class="btn-close" @onclick="() => reviewingBetModel.AiOutcomeResult = null"></button>
                                </div>
                            }
                            
                            @if (AiVisionResult != null || AiVisionError != null)
                            {
                                <div class="alert @(AiVisionError != null ? "alert-danger" : "alert-success") py-2 px-3 mt-2 mb-3 small shadow-sm">
                                    @if (AiVisionError != null) {
                                        <i class="bi bi-exclamation-triangle-fill me-1"></i> @AiVisionError
                                    } else {
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <div class="d-flex align-items-center">
                                                <span class="badge bg-dark text-white rounded-pill px-3 py-2 shadow-sm d-flex align-items-center" style="font-size: 0.85rem; letter-spacing: 0.5px;">
                                                    <i class="bi bi-shop me-2" style="font-size: 0.9rem;"></i>
                                                    <span class="fw-bold">@(string.IsNullOrWhiteSpace(AiVisionResult!.Bookmaker) ? "Unknown Bookie" : AiVisionResult!.Bookmaker)</span>
                                                </span>
                                            </div>
                                            <button class="btn btn-sm btn-outline-secondary py-0 px-2 rounded-pill shadow-sm d-flex align-items-center justify-content-center" @onclick="() => showAiExtractionDetails = !showAiExtractionDetails" title="Debug details" style="height: 26px;">
                                                <i class="bi bi-bug" style="font-size: 0.85rem;"></i>
                                            </button>
                                        </div>
                                        @if (showAiExtractionDetails) {
                                            <div class="mb-2 p-2 bg-light bg-opacity-75 rounded border" style="font-size: 0.85em;">
                                                <strong>Bookmaker:</strong> @AiVisionResult!.Bookmaker <br/>
                                                <strong>Is Bet Builder:</strong> @AiVisionResult!.IsBetBuilder <br/>
                                                <strong>Is Live Placed:</strong> @AiVisionResult!.IsLive <br/>
                                                <strong>Stake:</strong> @AiVisionResult!.Stake <br/>
                                                <strong>Total Odds:</strong> @AiVisionResult!.TotalOdds
                                                <hr class="my-1 text-muted" />
                                                <div><strong>SS Sent:</strong> @ToUserLocal(reviewingBetModel.CreatedAt).ToString("dd/MM/yyyy HH:mm:ss")</div>
                                                @{
                                                    var arrivedTime = reviewingBetModel.ArrivedPendingAt ?? reviewingBetModel.AiEvaluation?.CreatedAt;
                                                }
                                                <div>
                                                    <strong>SS Arrived Pending:</strong> 
                                                    @if (arrivedTime.HasValue) {
                                                        @ToUserLocal(arrivedTime.Value).ToString("dd/MM/yyyy HH:mm:ss")
                                                        var delay = (arrivedTime.Value - reviewingBetModel.CreatedAt).TotalSeconds;
                                                        if (delay >= 0) {
                                                            <span class="badge @(delay > 15 ? "bg-warning text-dark" : "bg-secondary") ms-1" title="Time taken to process and reach pending queue">@($"+{delay:0.0}s")</span>
                                                        }
                                                    } else if (reviewingBetModel.Status == "Processing") {
                                                        <span class="badge bg-info text-dark ms-1">Processing...</span>
                                                    } else {
                                                        <span class="text-muted">-</span>
                                                    }
                                                </div>
                                                <div>
                                                    <strong>Auto-Approve:</strong>
                                                    @if (!string.IsNullOrEmpty(reviewingBetModel.AutoApproveReason)) {
                                                        <span>@reviewingBetModel.AutoApproveReason</span>
                                                    } else {
                                                        <span class="text-muted">-</span>
                                                    }
                                                </div>
                                            </div>
                                        }
                                        @if (AiVisionResult!.Legs != null)
                                        {
                                            @if (reviewingBetModel.Status == "Pending" || reviewingBetModel.Status == "Processing")
                                            {
                                                
                                                    bool hasCheckedOdds = LegOddsCache.Count > 0;
                                                    string btnClass = hasCheckedOdds ? "btn-warning text-dark" : "btn-primary text-white";
                                                    string btnGradient = hasCheckedOdds ? "linear-gradient(135deg, #ffca2c, #ffb300)" : "linear-gradient(135deg, #0d6efd, #0b5ed7)";
                                                    string btnText = hasCheckedOdds ? "Re-Check All Odds" : "Check All Odds";
                                                
                                                <button class="btn @btnClass btn-sm mb-2 w-100 fw-bold shadow-sm border-0" style="background: @btnGradient;" @onclick="CheckAllOddsAsync" disabled="@IsCheckingAllOdds">
                                                    @if(IsCheckingAllOdds) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                                    <i class="bi bi-robot me-1"></i> @btnText
                                                </button>
                                                @if(IsCheckingAllOdds) {
                                                    <div class="progress mb-3 shadow-sm bg-dark" style="height: 12px; border-radius: 6px;">
                                                        <div class="progress-bar progress-bar-striped progress-bar-animated bg-success" role="progressbar" style="width: @((int)((float)CheckedLegsCount / AiVisionResult.Legs.Count * 100))%"></div>
                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                if (!showSavedBookmakerOdds)
                                                {
                                                    <button class="btn btn-outline-primary btn-sm mb-2 w-100 fw-bold shadow-sm" @onclick="LoadSavedOddsIntoCache">
                                                        <i class="bi bi-eye me-1"></i> Show Bookmaker Odds
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-outline-secondary btn-sm mb-2 w-100 fw-bold shadow-sm" @onclick="HideSavedOddsFromCache">
                                                        <i class="bi bi-eye-slash me-1"></i> Hide Bookmaker Odds
                                                    </button>
                                                }
                                            }
                                            
                                                // Group ONLY adjacent legs with the same Match name
                                                var groupedLegs = new List<List<(BettingApp.Services.AiVisionLeg Leg, int Index)>>();
                                                List<(BettingApp.Services.AiVisionLeg Leg, int Index)>? currentGroup = null;
                                                string? currentMatch = null;
                                                string? currentGroupOdds = null;

                                                for (int i = 0; i < AiVisionResult!.Legs.Count; i++)
                                                {
                                                    var leg = AiVisionResult!.Legs[i];
                                                    string matchName = leg.Match ?? "Unknown Match";
                                                    
                                                    bool isSameMatch = currentGroup != null && matchName == currentMatch;
                                                    bool isSameOdds = isSameMatch && (string.IsNullOrEmpty(leg.Odds) || string.IsNullOrEmpty(currentGroupOdds) || leg.Odds == currentGroupOdds);

                                                    if (!isSameOdds || currentGroup == null)
                                                    {
                                                        currentGroup = new List<(BettingApp.Services.AiVisionLeg Leg, int Index)>();
                                                        groupedLegs.Add(currentGroup);
                                                        currentMatch = matchName;
                                                        currentGroupOdds = leg.Odds;
                                                    }
                                                    else if (!string.IsNullOrEmpty(leg.Odds) && string.IsNullOrEmpty(currentGroupOdds))
                                                    {
                                                        currentGroupOdds = leg.Odds;
                                                    }
                                                    
                                                    currentGroup.Add((leg, i));
                                                }
                                            
                                            foreach (var group in groupedLegs)
                                            {
                                                var firstItem = group.First();
                                                bool hasActive = group.Any(x => x.Leg == ActiveLookupLeg);
                                                string groupKey = firstItem.Leg.Match ?? "Unknown Match";
                                                
                                                <div class="card mb-2 @(hasActive ? "border-primary shadow" : "shadow-sm border-0")">
                                                    <div class="card-header bg-white p-2 d-flex justify-content-between align-items-center border-bottom">
                                                        <div class="fw-bold lh-sm text-dark text-truncate me-2" style="font-size: 0.85em;">
                                                            @groupKey
                                                            @if (!string.IsNullOrEmpty(firstItem.Leg.Sport)) {
                                                                var sportLower = firstItem.Leg.Sport.ToLower();
                                                                var emoji = sportLower.Contains("american football") || sportLower.Contains("nfl") ? "🏈" :
                                                                            sportLower.Contains("soccer") || sportLower.Contains("football") ? "⚽" :
                                                                            sportLower.Contains("hockey") ? "🏒" :
                                                                            sportLower.Contains("tennis") ? "🎾" :
                                                                            sportLower.Contains("basketball") ? "🏀" :
                                                                            sportLower.Contains("baseball") ? "⚾" :
                                                                            sportLower.Contains("esport") || sportLower.Contains("cs") ? "🎮" :
                                                                            sportLower.Contains("mma") || sportLower.Contains("ufc") || sportLower.Contains("boxing") ? "🥊" :
                                                                            sportLower.Contains("volleyball") ? "🏐" : "🏆";
                                                                <span class="ms-1" title="@firstItem.Leg.Sport">@emoji</span>
                                                            }
                                                        </div>
                                                        @{
                                                            DateTime? displayStartTime = firstItem.Leg.StartTime;
                                                            if (displayStartTime == null && ParsedAiOutcome?.Legs != null)
                                                            {
                                                                var outcomeLeg = ParsedAiOutcome.Legs.FirstOrDefault(l => l.Match == firstItem.Leg.Match);
                                                                if (outcomeLeg != null && !string.IsNullOrEmpty(outcomeLeg.MatchStartTimeIso))
                                                                {
                                                                    if (DateTime.TryParse(outcomeLeg.MatchStartTimeIso, null, System.Globalization.DateTimeStyles.AdjustToUniversal, out DateTime parsedUtc))
                                                                    {
                                                                        displayStartTime = parsedUtc;
                                                                    }
                                                                }
                                                            }
                                                            bool isGroupLive = group.Any(item => LegOddsCache.TryGetValue(item.Index, out var res) && res.SearchResult?.IsLive == true);
                                                            bool isGroupFinished = !isGroupLive && group.Any(item => LegOddsCache.TryGetValue(item.Index, out var res) && res.SearchResult?.StatusId == 2);
                                                        }
                                                        <div class="d-flex align-items-center gap-2">
                                                            @if (isGroupLive) {
                                                                <span class="badge bg-danger shadow-sm text-nowrap d-inline-flex align-items-center" style="font-size: 0.65em; padding: 0.25em 0.5em;" title="Live In-Play Match">
                                                                    <span class="pulse-dot bg-white rounded-circle d-inline-block me-1" style="width: 5px; height: 5px;"></span> LIVE
                                                                </span>
                                                            } else if (isGroupFinished) {
                                                                <span class="badge bg-secondary shadow-sm text-nowrap" style="font-size: 0.65em; padding: 0.25em 0.5em;" title="Match Finished">
                                                                    FINISHED
                                                                </span>
                                                            }
                                                            @if (displayStartTime != null) {
                                                                <div class="text-primary lh-1 text-nowrap fw-semibold" style="font-size: 0.75em;">
                                                                    <i class="bi bi-clock me-1"></i>@ToUserLocal(displayStartTime.Value).ToString("dd.MMM HH:mm")
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                    <div class="card-body p-0 d-flex flex-row">
                                                        <div class="flex-grow-1 p-2 pt-1" style="min-width: 0;">
                                                        @foreach (var item in group)
                                                        {
                                                            var leg = item.Leg;
                                                            var i = item.Index;
                                                            var matchingOutcome = (ParsedAiOutcome?.Legs?.Count > i) ? ParsedAiOutcome.Legs[i] : ParsedAiOutcome?.Legs?.FirstOrDefault(l => l.Match == leg.Match);
                                                            bool isActive = (leg == ActiveLookupLeg);
                                                            bool isLast = item == group.Last();

                                                            <div class="@(!isLast ? "border-bottom mb-2 pb-2" : "")">
                                                                <div class="d-flex flex-column mb-1">
                                                                    <div class="d-flex align-items-center justify-content-between mb-1">
                                                                        <div class="text-muted lh-1 text-truncate fw-semibold" style="font-size: 0.65em; text-transform: uppercase; letter-spacing: 0.5px;">@leg.Market</div>
                                                                        @if (reviewingBetModel.Status == "Pending" || reviewingBetModel.Status == "Processing") {
                                                                            <button class="btn btn-outline-secondary d-flex align-items-center justify-content-center" style="font-size: 0.6em; padding: 0.15rem 0.3rem; border-width: 1px; line-height: 1;" title="Manual Search" @onclick="() => SearchOddsForLeg(leg)">
                                                                                <i class="bi @(isActive ? "bi-check2-circle text-primary" : "bi-search")"></i>
                                                                            </button>
                                                                        }
                                                                    </div>
                                                                    <div class="d-flex align-items-center justify-content-between gap-2">
                                                                        <div class="fw-bold text-dark lh-sm text-truncate" style="font-size: 0.85em;">@leg.Selection</div>
                                                                    </div>
                                                                </div>
                                                                
                                                                @if (matchingOutcome != null && !string.IsNullOrEmpty(matchingOutcome.Outcome)) {
                                                                    var color = matchingOutcome.Outcome.ToLower().Contains("won") ? "text-success" : 
                                                                                matchingOutcome.Outcome.ToLower().Contains("lost") ? "text-danger" : "text-warning";
                                                                    var emoji = matchingOutcome.Outcome.ToLower().Contains("won") ? "✅" : 
                                                                                matchingOutcome.Outcome.ToLower().Contains("lost") ? "❌" : "➖";

                                                                    <div class="mt-1 p-1 bg-light rounded border border-secondary border-opacity-25 lh-sm" style="font-size: 0.75em;">
                                                                        <strong>Outcome:</strong> <span class="@color fw-bold">@emoji @matchingOutcome.Outcome</span><br/>
                                                                        <strong>Stats:</strong> @HighlightVerification(matchingOutcome.Stats)
                                                                    </div>
                                                                }

                                                                @if (LegOddsCache.TryGetValue(i, out var legResult)) {
                                                                    <div class="mt-1 bg-white rounded border shadow-sm">
                                                                        @if (legResult.IsLoading) {
                                                                            <div class="text-center p-1" style="font-size: 0.75em;"><span class="spinner-border spinner-border-sm text-primary" style="width: 0.8rem; height: 0.8rem;"></span> Loading...</div>
                                                                        } else if (!string.IsNullOrEmpty(legResult.ErrorMessage)) {
                                                                            <div class="text-danger p-1 lh-sm fw-bold" style="font-size: 0.75em;"><i class="bi bi-exclamation-circle-fill me-1"></i>@legResult.ErrorMessage</div>
                                                                        } else {
                                                                            @if (!string.IsNullOrEmpty(legResult.WarningMessage)) {
                                                                                <div class="bg-warning bg-opacity-25 text-dark p-1 lh-sm border-bottom border-warning fw-semibold" style="font-size: 0.7em;"><i class="bi bi-exclamation-triangle-fill me-1 text-warning"></i>@legResult.WarningMessage</div>
                                                                            }
                                                                            <div class="d-flex justify-content-between text-center lh-1" style="background-color: #f8f9fa;">
                                                                                @foreach (var bookie in new[] { ("pinnacle+30", "Pinnacle"), ("unibet.se", "Unibet"), ("coolbet", "Coolbet"), ("bet365", "Bet365"), ("betsson", "Betsson") }) {
                                                                                    <div class="flex-fill border-end last-child-no-border p-1">
                                                                                        <div class="text-secondary fw-semibold mb-1" style="font-size: 0.55em; letter-spacing: 0.2px; text-transform: uppercase;">
                                                                                            @if (legResult.SearchResult?.BookmakerUrls != null && legResult.SearchResult.BookmakerUrls.TryGetValue(bookie.Item1, out var bUrl)) {
                                                                                                <a href="@FormatBookieUrl(bUrl, bookie.Item1)" target="@(openInNativeApp && !isDesktop && isAndroid ? "_self" : "_blank")" class="text-decoration-none text-primary">@bookie.Item2</a>
                                                                                            } else if (!string.IsNullOrEmpty(GetFallbackBookieUrl(bookie.Item1, legResult.SearchResult?.MatchName ?? ""))) {
                                                                                                <a href="@FormatBookieUrl(GetFallbackBookieUrl(bookie.Item1, legResult.SearchResult?.MatchName ?? ""), bookie.Item1)" target="@(openInNativeApp && !isDesktop && isAndroid ? "_self" : "_blank")" class="text-decoration-none text-primary">@bookie.Item2</a>
                                                                                            } else {
                                                                                                @bookie.Item2
                                                                                            }
                                                                                        </div>
                                                                                        <div class="fw-bold @(legResult.MatchedBookieOdds.ContainsKey(bookie.Item1) ? "text-dark" : "text-muted")" style="font-size: 0.85em;">
                                                                                            @if (legResult.MatchedBookieOdds.TryGetValue(bookie.Item1, out var p)) {
                                                                                                <div class="d-flex flex-column align-items-center justify-content-center">
                                                                                                    <div class="d-flex align-items-center justify-content-center">
                                                                                                        @if (p.IsSuspended) { <i class="bi bi-lock-fill text-warning me-1" style="font-size: 0.7em;"></i> }
                                                                                                        <span>@p.Price.ToString("0.00")</span>
                                                                                                        @if (p.Limit.HasValue) {
                                                                                                            <span class="text-success ms-1" style="font-size: 0.7em;" title="Max Bet Limit">€@p.Limit.Value.ToString("0")</span>
                                                                                                        }
                                                                                                    </div>
                                                                                                    @if (p.ChangedAt.HasValue) {
                                                                                                        <div class="text-muted fw-normal" style="font-size: 0.5em; margin-top: 2px;">@ToUserLocal(p.ChangedAt.Value).ToString("dd/MM HH:mm")</div>
                                                                                                    }
                                                                                                </div>
                                                                                            } else {
                                                                                                <span>-</span>
                                                                                            }
                                                                                        </div>
                                                                                    </div>
                                                                                }
                                                                            </div>
                                                                            <div class="bg-light px-1 py-1 d-flex justify-content-between align-items-center border-top text-muted" style="font-size: 0.65em; background-color: #fdfdfd;">
                                                                                <div class="text-truncate">
                                                                                    @if (!string.IsNullOrEmpty(legResult.HighlightedOutcome)) {
                                                                                        <span><i class="bi bi-check2-circle text-success me-1"></i>Matched: <strong>@legResult.HighlightedOutcome</strong></span>
                                                                                    } else if (legResult.LookedUpAt.HasValue) {
                                                                                        <span><i class="bi bi-clock-history text-secondary me-1"></i>Looked up at: <strong>@ToUserLocal(legResult.LookedUpAt.Value).ToString("dd/MM HH:mm")</strong></span>
                                                                                    } else {
                                                                                        <span><i class="bi bi-dash-circle text-secondary me-1"></i>No match</span>
                                                                                    }
                                                                                </div>
                                                                            </div>
                                                                        }
                                                                    </div>
                                                                }
                                                            </div>
                                                        }
                                                        </div>
                                                        @{
                                                            string displayOdds = group.FirstOrDefault(x => !string.IsNullOrEmpty(x.Leg.Odds)).Leg?.Odds ?? "-";
                                                            double oddsFontSize = Math.Min(1.6, 0.75 + (group.Count * 0.15));
                                                            
                                                            var bbOdds = new System.Collections.Generic.Dictionary<string, (string Label, double? MultipliedOdds)>();
                                                            if (group.Count > 1)
                                                            {
                                                                var bookies = new[] { ("pinnacle+30", "Pin"), ("unibet.se", "Uni"), ("coolbet", "Cool"), ("bet365", "B365"), ("betsson", "Bson") };
                                                                foreach (var b in bookies)
                                                                {
                                                                    double combined = 1.0;
                                                                    bool missing = false;
                                                                    foreach (var legItem in group)
                                                                    {
                                                                        if (LegOddsCache.TryGetValue(legItem.Index, out var res) && res.MatchedBookieOdds != null && res.MatchedBookieOdds.TryGetValue(b.Item1, out var p) && p.Price > 0)
                                                                        {
                                                                            combined *= (double)p.Price;
                                                                        }
                                                                        else
                                                                        {
                                                                            missing = true;
                                                                            break;
                                                                        }
                                                                    }
                                                                    bbOdds[b.Item1] = (b.Item2, missing ? null : combined);
                                                                }
                                                            }
                                                        }
                                                        <div class="d-flex flex-column align-items-center justify-content-center bg-light border-start p-2" style="min-width: 80px;">
                                                            <div class="fw-bold bg-dark text-white rounded px-2 shadow-sm d-flex flex-column align-items-center justify-content-center text-nowrap w-100" style="padding: 0.3rem; letter-spacing: 0.5px;">
                                                                @if(group.Count > 1) {
                                                                    <span class="text-uppercase mb-1" style="font-size: 0.55em; color: #adb5bd; letter-spacing: 0.5px;">BB</span>
                                                                }
                                                                <span style="font-size: @(oddsFontSize)em; line-height: 1;">@displayOdds</span>
                                                            </div>
                                                            
                                                            @if (group.Count > 1 && bbOdds.Values.Any(v => v.MultipliedOdds.HasValue)) {
                                                                <div class="mt-2 w-100 d-flex flex-column gap-1">
                                                                    @foreach (var bo in bbOdds.Values) {
                                                                        <div class="bg-white border rounded shadow-sm d-flex flex-column align-items-center justify-content-center py-1 w-100">
                                                                            <span class="text-secondary fw-semibold mb-1" style="font-size: 0.5em; letter-spacing: 0.5px; text-transform: uppercase; line-height: 1;">@bo.Label</span>
                                                                            <span class="fw-bold @(bo.MultipliedOdds.HasValue ? "text-dark" : "text-muted")" style="font-size: 0.85em; line-height: 1;">
                                                                                @(bo.MultipliedOdds.HasValue ? bo.MultipliedOdds.Value.ToString("0.00") : "-")
                                                                            </span>
                                                                        </div>
                                                                    }
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        }
                                    }
                                </div>
                            }

                   <div class="w-100" @key="reviewingBetModel.Id">
                            @if (reviewingBetModel.Status == "Pending" || reviewingBetModel.Status == "Processing")
                            {
                                <!-- ODDS LOOKUP WIDGET -->
                                <div class="card mb-3 shadow-sm border-0">
                                <div class="card-header bg-secondary text-white py-1 px-2 small fw-bold" @onclick="ToggleOddsLookup" style="cursor: pointer;">
                                    <i class="bi bi-search me-1"></i> Quick Odds Lookup 
                                    <i class="bi bi-chevron-@(ShowOddsLookup ? "up" : "down") float-end"></i>
                                </div>
                                @if (ShowOddsLookup)
                                {
                                    <div class="card-body p-2">
                                        @if (!string.IsNullOrEmpty(OddsLookupErrorMessage))
                                        {
                                            <div class="alert alert-danger py-1 px-2 mb-2 small">
                                                <i class="bi bi-exclamation-circle-fill me-1"></i> @OddsLookupErrorMessage
                                            </div>
                                        }
                                        @if (!string.IsNullOrEmpty(OddsLookupWarningMessage))
                                        {
                                            <div class="alert alert-warning py-1 px-2 mb-2 small text-dark border-warning">
                                                <i class="bi bi-exclamation-triangle-fill me-1"></i> @OddsLookupWarningMessage
                                            </div>
                                        }
                                        <div class="input-group input-group-sm mb-2">
                                            <input type="text" class="form-control" placeholder="Search team (e.g. Arsenal)..." @bind="OddsSearchTeam" @onkeydown="@(e => { if (e.Key == "Enter") _ = SearchOdds(); })" />
                                            <button class="btn btn-primary" @onclick="() => SearchOdds()" disabled="@IsSearchingOdds">
                                                @if(IsSearchingOdds) { <span class="spinner-border spinner-border-sm"></span> } else { <i class="bi bi-search"></i> }
                                            </button>
                                        </div>
                                        
                                        @if (PapiSearchResult != null)
                                        {
                                            <div class="alert alert-info py-1 px-2 mb-2 small fw-bold">
                                                <i class="bi bi-calendar-event me-1"></i>
                                                @if (!string.IsNullOrEmpty(PapiSearchResult.FlashscoreId))
                                                {
                                                    <a href="https://www.flashscore.com/match/@PapiSearchResult.FlashscoreId/#/match-summary" target="_blank" class="text-decoration-underline text-info-emphasis" title="Open in Flashscore">@PapiSearchResult.MatchName</a>
                                                }
                                                else
                                                {
                                                    @PapiSearchResult.MatchName
                                                }
                                                <span class="text-muted fw-normal ms-2">(@ToUserLocal(PapiSearchResult.StartTime).ToString("g"))</span>
                                                @if (PapiSearchResult.IsLive) {
                                                    <span class="badge bg-danger ms-2 shadow-sm"><span class="pulse-dot bg-white rounded-circle d-inline-block me-1" style="width: 6px; height: 6px;"></span> LIVE ODDS</span>
                                                }
                                                else if (PapiSearchResult.StatusId == 2) {
                                                    <span class="badge bg-secondary ms-2 shadow-sm">FINISHED</span>
                                                }
                                            </div>

                                            <div class="mb-2">
                                                <select class="form-select form-select-sm fw-bold" 
                                                        @key="@($"papi-market-select-{PapiSearchResult.FixtureId}-{ActiveLookupLeg?.Match}-{ActiveLookupLeg?.Market}-{ActiveLookupLeg?.Selection}")" 
                                                        @bind="SelectedPapiMarketId" 
                                                        @bind:after="UpdateManualMatchedOutcome">
                                                    @if (string.IsNullOrEmpty(SelectedPapiMarketId) || !PapiSearchResult.Markets.Any(m => m.MarketId == SelectedPapiMarketId))
                                                    {
                                                        <option value="" disabled selected>-- Select Market --</option>
                                                    }
                                                    @foreach (var m in PapiSearchResult.Markets)
                                                    {
                                                        string displayMarketName = m.MarketName.Replace("Over Under", "Over/Under", StringComparison.OrdinalIgnoreCase);
                                                        if (!string.IsNullOrEmpty(PapiSearchResult.MatchName))
                                                        {
                                                            var matchSplit = PapiSearchResult.MatchName.Split(new[] { " vs ", " v ", " - " }, StringSplitOptions.None);
                                                            if (matchSplit.Length >= 2)
                                                            {
                                                                displayMarketName = displayMarketName.Replace("Team 1", $"[{matchSplit[0].Trim()}]", StringComparison.OrdinalIgnoreCase);
                                                                displayMarketName = displayMarketName.Replace("Team 2", $"[{matchSplit[1].Trim()}]", StringComparison.OrdinalIgnoreCase);
                                                            }
                                                        }
                                                        <option value="@m.MarketId" @key="@m.MarketId">@displayMarketName</option>
                                                    }
                                                </select>
                                            </div>

                                            <div class="table-responsive" style="max-height: 250px;">
                                                <table class="table table-sm table-bordered text-center align-middle mb-0" style="font-size: 0.8rem;">
                                                    <thead class="table-light sticky-top" style="z-index: 1;">
                                                        <tr>
                                                            <th class="text-start">Outcome</th>
                                                            @{ var linkTarget = (openInNativeApp && !isDesktop && isAndroid) ? "_self" : "_blank"; }
                                                            <th>
                                                                @if (PapiSearchResult != null && PapiSearchResult.BookmakerUrls.TryGetValue("pinnacle+30", out var pinUrl)) {
                                                                    <a href="@FormatBookieUrl(pinUrl, "pinnacle")" target="@linkTarget" class="text-decoration-none" title="Open match in Pinnacle">Pinnacle</a>
                                                                } else {
                                                                    <span>Pinnacle</span>
                                                                }
                                                            </th>
                                                            <th>
                                                                @if (PapiSearchResult != null && PapiSearchResult.BookmakerUrls.TryGetValue("unibet.se", out var unibetUrl)) {
                                                                    <a href="@FormatBookieUrl(unibetUrl, "unibet.se")" target="@linkTarget" class="text-decoration-none" title="Open match in Unibet">Unibet SE</a>
                                                                } else {
                                                                    <span>Unibet SE</span>
                                                                }
                                                            </th>
                                                            <th>
                                                                @if (PapiSearchResult != null && PapiSearchResult.BookmakerUrls.TryGetValue("coolbet", out var coolbetUrl)) {
                                                                    <a href="@FormatBookieUrl(coolbetUrl, "coolbet")" target="@linkTarget" class="text-decoration-none" title="Open match in Coolbet">Coolbet</a>
                                                                } else if (!string.IsNullOrEmpty(GetFallbackBookieUrl("coolbet", PapiSearchResult?.MatchName ?? ""))) {
                                                                    <a href="@FormatBookieUrl(GetFallbackBookieUrl("coolbet", PapiSearchResult?.MatchName ?? ""), "coolbet")" target="@linkTarget" class="text-decoration-none" title="Open match in Coolbet">Coolbet</a>
                                                                } else {
                                                                    <span>Coolbet</span>
                                                                }
                                                            </th>
                                                            <th>
                                                                @if (PapiSearchResult != null && PapiSearchResult.BookmakerUrls.TryGetValue("bet365", out var bet365Url)) {
                                                                    <a href="@FormatBookieUrl(bet365Url, "bet365")" target="@linkTarget" class="text-decoration-none" title="Open match in Bet365">Bet365</a>
                                                                } else {
                                                                    <span>Bet365</span>
                                                                }
                                                            </th>
                                                            <th>
                                                                @if (PapiSearchResult != null && PapiSearchResult.BookmakerUrls.TryGetValue("betsson", out var betssonUrl)) {
                                                                    <a href="@FormatBookieUrl(betssonUrl, "betsson")" target="@linkTarget" class="text-decoration-none" title="Open match in Betsson">Betsson</a>
                                                                } else {
                                                                    <span>Betsson</span>
                                                                }
                                                            </th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @if (!string.IsNullOrEmpty(SelectedPapiMarketId) && PapiSearchResult!.BookmakerOdds.TryGetValue(SelectedPapiMarketId, out var bookies))
                                                        {
                                                            var selectedMarket = PapiSearchResult.Markets.FirstOrDefault(m => m.MarketId == SelectedPapiMarketId);
                                                            var outcomes = selectedMarket?.OutcomeNames ?? new Dictionary<string, string>();
                                                            
                                                            @foreach (var kvp in outcomes.OrderBy(k => BettingApp.Services.OddsMatchingLogic.GetSortKey(k.Value)))
                                                            {
                                                                var oId = kvp.Key;
                                                                var oName = kvp.Value;
                                                                string displayOName = BettingApp.Services.OddsMatchingLogic.GetTranslatedOutcomeName(oName, PapiSearchResult?.MatchName ?? "");
                                                                bool isMatch = !string.IsNullOrEmpty(ManualMatchedOutcome) && (oName == ManualMatchedOutcome || displayOName == ManualMatchedOutcome);

                                                                <tr id="@(isMatch ? "highlighted-odds-row" : "")" class="@(isMatch ? "table-warning" : "") align-top">
                                                                    <td class="text-start fw-bold @(isMatch ? "text-dark" : "")">
                                                                        @if (isMatch)
                                                                        {
                                                                            <i class="bi bi-star-fill text-warning me-1"></i>
                                                                        }
                                                                        @displayOName
                                                                    </td>
                                                                    <td class="text-dark">
                                                                        @if (bookies.TryGetValue("pinnacle+30", out var p) && p.TryGetValue(oName, out var pd)) {
                                                                            <div class="fw-bold d-flex align-items-center justify-content-center">
                                                                                @if (pd.IsSuspended) {
                                                                                    <span title="Suspended" class="text-muted"><i class="bi bi-lock-fill text-warning"></i> @pd.Price.ToString("0.00")</span>
                                                                                } else {
                                                                                    <span>@pd.Price.ToString("0.00")</span>
                                                                                }
                                                                                @if (pd.Limit.HasValue) {
                                                                                    <span class="badge bg-success-subtle text-success ms-1" style="font-size: 0.75rem; padding: 0.25rem 0.4rem; line-height: 1;" title="Max Bet Limit">€@pd.Limit.Value.ToString("0")</span>
                                                                                }
                                                                            </div>
                                                                            @if (pd.ChangedAt.HasValue) {
                                                                                <div class="badge bg-light text-secondary border mt-1 fw-bold" style="font-size: 0.55rem; padding: 0.15rem 0.25rem; letter-spacing: -0.3px;" title="Last updated">@ToUserLocal(pd.ChangedAt.Value).ToString("dd/MM HH:mm")</div>
                                                                            }
                                                                        } else {
                                                                            <div class="fw-bold">-</div>
                                                                        }
                                                                    </td>
                                                                    <td class="text-dark">
                                                                        @if (bookies.TryGetValue("unibet.se", out var u) && u.TryGetValue(oName, out var ud)) {
                                                                            <div class="fw-bold">
                                                                                @if (ud.IsSuspended) {
                                                                                    <span title="Suspended" class="text-muted"><i class="bi bi-lock-fill text-warning"></i> @ud.Price.ToString("0.00")</span>
                                                                                } else {
                                                                                    @ud.Price.ToString("0.00")
                                                                                }
                                                                            </div>
                                                                            @if (ud.ChangedAt.HasValue) {
                                                                                <div class="badge bg-light text-secondary border mt-1 fw-bold" style="font-size: 0.55rem; padding: 0.15rem 0.25rem; letter-spacing: -0.3px;" title="Last updated">@ToUserLocal(ud.ChangedAt.Value).ToString("dd/MM HH:mm")</div>
                                                                            }
                                                                        } else {
                                                                            <div class="fw-bold">-</div>
                                                                        }
                                                                    </td>
                                                                    <td class="text-dark">
                                                                        @if (bookies.TryGetValue("coolbet", out var cooldict) && cooldict.TryGetValue(oName, out var coold)) {
                                                                            <div class="fw-bold">
                                                                                @if (coold.IsSuspended) {
                                                                                    <span title="Suspended" class="text-muted"><i class="bi bi-lock-fill text-warning"></i> @coold.Price.ToString("0.00")</span>
                                                                                } else {
                                                                                    @coold.Price.ToString("0.00")
                                                                                }
                                                                            </div>
                                                                            @if (coold.ChangedAt.HasValue) {
                                                                                <div class="badge bg-light text-secondary border mt-1 fw-bold" style="font-size: 0.55rem; padding: 0.15rem 0.25rem; letter-spacing: -0.3px;" title="Last updated">@ToUserLocal(coold.ChangedAt.Value).ToString("dd/MM HH:mm")</div>
                                                                            }
                                                                        } else {
                                                                            <div class="fw-bold">-</div>
                                                                        }
                                                                    </td>
                                                                    <td class="text-dark">
                                                                        @if (bookies.TryGetValue("bet365", out var b) && b.TryGetValue(oName, out var bd)) {
                                                                            <div class="fw-bold">
                                                                                @if (bd.IsSuspended) {
                                                                                    <span title="Suspended" class="text-muted"><i class="bi bi-lock-fill text-warning"></i> @bd.Price.ToString("0.00")</span>
                                                                                } else {
                                                                                    @bd.Price.ToString("0.00")
                                                                                }
                                                                            </div>
                                                                            @if (bd.ChangedAt.HasValue) {
                                                                                <div class="badge bg-light text-secondary border mt-1 fw-bold" style="font-size: 0.55rem; padding: 0.15rem 0.25rem; letter-spacing: -0.3px;" title="Last updated">@ToUserLocal(bd.ChangedAt.Value).ToString("dd/MM HH:mm")</div>
                                                                            }
                                                                        } else {
                                                                            <div class="fw-bold">-</div>
                                                                        }
                                                                    </td>
                                                                    <td class="text-dark">
                                                                        @if (bookies.TryGetValue("betsson", out var c) && c.TryGetValue(oName, out var cd)) {
                                                                            <div class="fw-bold">
                                                                                @if (cd.IsSuspended) {
                                                                                    <span title="Suspended" class="text-muted"><i class="bi bi-lock-fill text-warning"></i> @cd.Price.ToString("0.00")</span>
                                                                                } else {
                                                                                    @cd.Price.ToString("0.00")
                                                                                }
                                                                            </div>
                                                                            @if (cd.ChangedAt.HasValue) {
                                                                                <div class="badge bg-light text-secondary border mt-1 fw-bold" style="font-size: 0.55rem; padding: 0.15rem 0.25rem; letter-spacing: -0.3px;" title="Last updated">@ToUserLocal(cd.ChangedAt.Value).ToString("dd/MM HH:mm")</div>
                                                                            }
                                                                        } else {
                                                                            <div class="fw-bold">-</div>
                                                                        }
                                                                    </td>
                                                                </tr>
                                                            }
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                            <!-- END ODDS LOOKUP WIDGET -->
                            }
                            </div>
                            </div>
                            
                            <!-- Fixed Bottom Action Area -->
                            <div class="desktop-bottom-actions flex-shrink-0 position-relative">
                               
                               <!-- Mobile Image Toggle Button -->
                               @if (!string.IsNullOrEmpty(reviewingBetModel.ScreenshotUrl)) {
                                   <button class="btn btn-primary d-lg-none shadow-lg rounded-circle d-flex align-items-center justify-content-center border-0" 
                                           style="position: absolute; right: 15px; top: -55px; width: 45px; height: 45px; z-index: 1050; opacity: 0.95; user-select: none; -webkit-touch-callout: none; touch-action: none;"
                                           @onpointerdown="() => showMobileScreenshot = true" 
                                           @onpointerup="() => showMobileScreenshot = false" 
                                           @onpointerout="() => showMobileScreenshot = false" 
                                           @onpointercancel="() => showMobileScreenshot = false"
                                           @oncontextmenu="() => {}" @oncontextmenu:preventDefault="true">
                                       <i class="bi bi-image fs-5"></i>
                                   </button>
                               }

                               <div class="row g-2 mb-3">
                                     <div class="col-3">
                                         <label class="form-label fw-bold text-muted small mb-1">Stake</label>
                         
                                     <div class="input-group input-group-sm">
                                        <input type="number" id="betAmountInput" class="form-control fw-bold px-2" 
                                            @bind-value="reviewingBetModel.AmountNOK" 
                                            @bind-value:event="oninput" onfocus="this.select();"
                                            @onkeydown:stopPropagation="true"
                                            placeholder="0" enterkeyhint="next" />
                                     </div>
                                </div>
                                <div class="col-2">
                                    <label class="form-label fw-bold text-muted small mb-1">Odds</label>
                      
                                    <input type="number" step="0.01" id="betOddsInput" class="form-control form-control-sm fw-bold px-2" 
                                            @bind-value="reviewingBetModel.Odds" 
                                            @bind-value:event="oninput" onfocus="this.select();"
                                            @onkeydown:stopPropagation="true"
                                            placeholder="1.00" enterkeyhint="done" />
                                 </div>
                                <div class="col-3">
                                     <label class="form-label fw-bold text-muted small mb-1">Payout</label>
                                     <div id="payoutDisplay" class="form-control form-control-sm bg-light text-success fw-bold text-end px-2">
                                         @reviewingBetModel.PotentialPayout.ToString("N0") kr
                                     </div>
                                </div>
                                 <div class="col-4">
                                      <label class="form-label fw-bold text-muted small mb-1">Net Liability</label>
                                      <div id="liabilityDisplay" class="form-control form-control-sm bg-light text-danger fw-bold text-end px-2">
                                          @reviewingBetModel.NetLiability.ToString("N0") kr
                                      </div>
                                 </div>
                             </div>

                            @if (reviewingBetModel.Status == "Pending" && currentReviewUserFreeBalance > 0)
                            {
                                <div class="alert alert-info py-1 px-2 mb-3 small d-flex justify-content-between align-items-center">
                                    <span><i class="bi bi-gift-fill me-1"></i> User Free Balance: <strong>@currentReviewUserFreeBalance.ToString("N0") kr</strong></span>
                                    <span class="text-primary fw-bold">Projected Free Bet: @Math.Min((decimal)(reviewingBetModel.AmountNOK ?? 0), currentReviewUserFreeBalance).ToString("N0") kr</span>
                                </div>
                            }
                            else if (reviewingBetModel.FreeBetAmount > 0)
                            {
                                <div class="alert alert-info py-1 px-2 mb-3 small">
                                    <i class="bi bi-gift-fill me-1"></i> This bet used <strong>@reviewingBetModel.FreeBetAmount.ToString("N0") kr</strong> from Free Bet balance.
                                </div>
                            }

                           @if (reviewingBetModel.Status == "Pending" || reviewingBetModel.Status == "Processing") {
                             
                               <div class="row g-3">
                                   <div class="col-6"><button class="btn btn-success w-100 btn-xl-mobile fw-bold shadow-sm" @onclick='() => ProcessBet(reviewingBetModel, "Approved")'><i class="bi bi-check-lg me-1"></i> Approve</button></div>
                                   <div class="col-6"><button class="btn btn-outline-danger w-100 btn-xl-mobile fw-bold shadow-sm" @onclick='() => ProcessBet(reviewingBetModel, "Rejected")'><i class="bi bi-x-lg me-1"></i> Reject</button></div>
                               </div>
                            } else if (reviewingBetModel.Status == "Approved") {
                                
                                @if (originalBetModel != null && (reviewingBetModel.Odds != originalBetModel.Odds || reviewingBetModel.AmountNOK != originalBetModel.AmountNOK))
                                {
                                    <div class="mb-2">
                                        <button class="btn btn-primary w-100 btn-xl-mobile fw-bold shadow-sm" @onclick='() => ProcessBet(reviewingBetModel, "Approved")'>
                                            <i class="bi bi-check2-circle me-1"></i> Save Changes (Active Bet)
                                        </button>
                                    </div>
                                }

                                <div class="row g-2">
                                    <div class="col-5"><button class="btn btn-success w-100 btn-xl-mobile fw-bold shadow-sm" @onclick='() => ProcessBet(reviewingBetModel, "Won")'><i class="bi bi-trophy-fill me-1"></i> Won</button></div>
                                    <div class="col-5"><button class="btn btn-danger w-100 btn-xl-mobile fw-bold shadow-sm" @onclick='() => ProcessBet(reviewingBetModel, "Lost")'><i class="bi bi-x-lg me-1"></i> Lost</button></div>
                                    <div class="col-2"><button class="btn btn-secondary w-100 btn-xl-mobile fw-bold shadow-sm px-0" @onclick='() => ProcessBet(reviewingBetModel, "Void")'>Void</button></div>
                                 </div>
             
                              } else {
                                  <div class="row g-2">
                                   <div class="col-12 text-center pb-2"><small class="text-muted"><i class="bi bi-pencil-fill me-1"></i> Edit Mode</small></div>

                                   @if (originalBetModel != null && (reviewingBetModel.Odds != originalBetModel.Odds || reviewingBetModel.AmountNOK != originalBetModel.AmountNOK))
                                   {
                                       <div class="col-12 mb-2">
                                           <button class="btn btn-primary w-100 btn-xl-mobile fw-bold shadow-sm" @onclick='() => ProcessBet(reviewingBetModel, reviewingBetModel.Status)'>
                                               <i class="bi bi-check2-circle me-1"></i> Save Changes (@reviewingBetModel.Status)
                                           </button>
                                       </div>
                                   }
  
                                   <div class="col-3"><button class="btn btn-success w-100 btn-xl-mobile fw-bold shadow-sm px-0" @onclick='() => ProcessBet(reviewingBetModel, "Won")'>Won</button></div>
                                   <div class="col-3"><button class="btn btn-danger w-100 btn-xl-mobile fw-bold shadow-sm px-0" @onclick='() => ProcessBet(reviewingBetModel, "Lost")'>Lost</button></div>
        
                                   <div class="col-3"><button class="btn btn-secondary w-100 btn-xl-mobile fw-bold shadow-sm px-0" @onclick='() => ProcessBet(reviewingBetModel, "Void")'>Void</button></div>
                                   <div class="col-3"><button class="btn btn-primary w-100 btn-xl-mobile fw-bold shadow-sm px-0" @onclick='() => ProcessBet(reviewingBetModel, "Approved")'><i class="bi bi-arrow-counterclockwise me-1"></i> Undo</button></div>
                                     </div>
                            }
                            </div>
                        </div>
                   </div>
                </div>
            </div>
        </div>
    </div>
}

<div class="row">
  <div class="col-md-12">
        <div class="d-flex justify-content-between align-items-center mb-3 flex-nowrap gap-2">
            <h4 class="mb-0 text-truncate" style="font-size: clamp(1rem, 4vw, 1.5rem);">Pending Bets (@totalPendingBets)</h4>
            <button class="btn btn-outline-secondary btn-sm flex-shrink-0" @onclick="ExportPendingBetsCsv" title="Export CSV">
                <i class="bi bi-download"></i> <span class="d-none d-sm-inline">Export CSV</span>
            </button>
        </div>
         <div class="table-responsive">
             <table class="table table-sm table-striped table-hover mb-5 text-nowrap align-middle">
                 <thead class="table-dark">
                      <tr>
           
                        <th style="width: 150px;">Action</th>
                        <th>ID</th>
                        <th>Match Time</th>
                        <th class="text-nowrap">Last Updated</th>
         
                        <th>Discord Username</th>
                        <th>Last Name</th>
                    </tr>
                 </thead>
                 <tbody>
     
                    @foreach (var bet in pendingBets)
                    {
                        <tr @key="bet.Id">
                              <td>
        
                                 <button class="btn btn-primary btn-sm action-btn" @onclick="() => StartReview(bet)">
                                    <i class="bi bi-eye"></i> Review
                                </button>
                             </td>
                            <td><div class="d-flex flex-column align-items-start"><span>@bet.Id</span>@GetLivePlacedBadge(bet, "mt-1")</div></td>
                            <td>@GetStartTimeDisplay(bet)</td>
                            <td class="text-nowrap">@ToUserLocal(bet.UpdatedAt).ToString("g")</td>
                            <td>
                                @{
                                    var u1Exists = userLookup.TryGetValue(bet.UserId, out var u1);
                                    var u1Name = u1Exists && !string.IsNullOrEmpty(u1.DiscordName) ? u1.DiscordName : bet.UserName;
                                    var u1Link = userDiscordLinks.TryGetValue(bet.UserId, out var link2) ? link2 : $"https://discord.com/channels/{DiscordService.GuildId}";
                                }
                                <a href="@u1Link" target="_blank" class="text-decoration-none fw-bold">@u1Name</a>
                            </td>
                            <td>@(userLookup.TryGetValue(bet.UserId, out var u2) ? u2.LastName : "")</td>
                        </tr>
                    }
                   
                    @if (pendingBets.Count == 0) { <tr><td colspan="6" class="text-muted">No pending bets.</td></tr> }
               </tbody>
            </table>
         </div>
         
         <div class="d-flex justify-content-between align-items-center mb-5">
             <button class="btn btn-sm @(pendingPage <= 1 ? "btn-outline-secondary" : "btn-primary shadow-sm")" @onclick="PrevPendingPage" disabled="@(pendingPage <= 1)"><i class="bi bi-arrow-left"></i> Previous</button>
             <span class="text-muted fw-bold">Page @pendingPage</span>
             <button class="btn btn-sm @(!hasMorePendingBets ? "btn-outline-secondary" : "btn-primary shadow-sm fw-bold")" @onclick="NextPendingPage" disabled="@(!hasMorePendingBets)">Next <i class="bi bi-arrow-right"></i></button>
         </div>

        <div class="d-flex justify-content-between align-items-center mb-3 flex-nowrap gap-2">
            <h4 class="mb-0 text-truncate" style="font-size: clamp(1rem, 4vw, 1.5rem);">Active Bets (@totalApprovedBets)</h4>
            <div class="d-flex gap-2 align-items-center flex-shrink-0">
                <div class="input-group input-group-sm shadow-sm flex-shrink-0" style="max-width: 200px;">
                    <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" class="form-control border-start-0 ps-0" placeholder="Bet ID or Username..." @bind="approvedSearchTerm" @bind:event="oninput" @bind:after="OnApprovedSearchChanged" />
                    @if (!string.IsNullOrWhiteSpace(approvedSearchTerm))
                    {
                        <button class="btn btn-outline-secondary" type="button" @onclick="ClearApprovedSearch" title="Clear search">
                            <i class="bi bi-x"></i>
                        </button>
                    }
                </div>
                <button class="btn btn-outline-secondary btn-sm flex-shrink-0" @onclick="ExportActiveBetsCsv" title="Export CSV">
                     <i class="bi bi-download"></i> <span class="d-none d-sm-inline">Export CSV</span>
                </button>
            </div>
        </div>
        <div class="table-responsive mb-5">
            <table class="table table-sm table-striped table-hover text-nowrap align-middle">
                  <thead class="table-dark">
                   <tr>
    
                        <th style="width: 150px;">Action</th>
                        <th style="width: 110px; cursor: pointer; user-select: none;" @onclick="@(() => SortApproved("AiOutcome"))">
                            AI Outcome
                            @if (approvedSortColumn == "AiOutcome") { <i class="bi @(approvedSortDesc ? "bi-caret-down-fill" : "bi-caret-up-fill")"></i> }
                        </th>
                        <th style="width: 130px; cursor: pointer; user-select: none;" @onclick="@(() => SortApproved("NextCheckTime"))">
                            Auto-Tracking 
                            @if (approvedSortColumn == "NextCheckTime") { <i class="bi @(approvedSortDesc ? "bi-caret-down-fill" : "bi-caret-up-fill")"></i> }
                        </th>
                        <th style="cursor: pointer; user-select: none;" @onclick="@(() => SortApproved("Id"))">
                            ID
                            @if (approvedSortColumn == "Id") { <i class="bi @(approvedSortDesc ? "bi-caret-down-fill" : "bi-caret-up-fill")"></i> }
                        </th>
                        <th class="text-nowrap" style="cursor: pointer; user-select: none;" @onclick="@(() => SortApproved("UpdatedAt"))">
                            Last Updated
                            @if (approvedSortColumn == "UpdatedAt") { <i class="bi @(approvedSortDesc ? "bi-caret-down-fill" : "bi-caret-up-fill")"></i> }
                        </th>
  
                        <th style="cursor: pointer; user-select: none;" @onclick="@(() => SortApproved("DiscordUsername"))">
                            Discord Username
                            @if (approvedSortColumn == "DiscordUsername") { <i class="bi @(approvedSortDesc ? "bi-caret-down-fill" : "bi-caret-up-fill")"></i> }
                        </th>
                        <th style="cursor: pointer; user-select: none;" @onclick="@(() => SortApproved("LastName"))">
                            Last Name
                            @if (approvedSortColumn == "LastName") { <i class="bi @(approvedSortDesc ? "bi-caret-down-fill" : "bi-caret-up-fill")"></i> }
                        </th>
                        <th style="cursor: pointer; user-select: none;" @onclick="@(() => SortApproved("AmountNOK"))">
                            Bet Amount
                            @if (approvedSortColumn == "AmountNOK") { <i class="bi @(approvedSortDesc ? "bi-caret-down-fill" : "bi-caret-up-fill")"></i> }
                        </th>
                        <th style="cursor: pointer; user-select: none;" @onclick="@(() => SortApproved("Odds"))">
                            Odds
                            @if (approvedSortColumn == "Odds") { <i class="bi @(approvedSortDesc ? "bi-caret-down-fill" : "bi-caret-up-fill")"></i> }
                        </th>
   
                        <th style="cursor: pointer; user-select: none;" @onclick="@(() => SortApproved("PotentialPayout"))">
                            Potential Payout
                            @if (approvedSortColumn == "PotentialPayout") { <i class="bi @(approvedSortDesc ? "bi-caret-down-fill" : "bi-caret-up-fill")"></i> }
                        </th>
                        <th style="cursor: pointer; user-select: none;" @onclick="@(() => SortApproved("NetLiability"))">
                            Net Liability
                            @if (approvedSortColumn == "NetLiability") { <i class="bi @(approvedSortDesc ? "bi-caret-down-fill" : "bi-caret-up-fill")"></i> }
                        </th>
                    </tr>
                 </thead>
                 <tbody>
                    @foreach (var bet in approvedBets)
                    {
                        <tr @key="bet.Id">
                             <td>
                                 <button class="btn btn-success btn-sm action-btn" @onclick="() => StartReview(bet)">
                                     <i class="bi bi-play-circle"></i> Process
                                </button>
                
                               </td>
                               <td class="text-center">
                                   @if (IsCheckingOutcome(bet.Id)) {
                                       <span class="badge bg-info text-dark shadow-sm"><span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Checking</span>
                                   } else {
                                       @GetAiOutcomeBadge(bet)
                                   }
                               </td>
                               <td class="text-center">
                                   @GetMonitoringStatusBadge(bet)
                               </td>
                            <td><div class="d-flex flex-column align-items-start"><span>@bet.Id</span>@GetLivePlacedBadge(bet, "mt-1")</div></td>
                            <td class="text-nowrap">@ToUserLocal(bet.UpdatedAt).ToString("g")</td>
  
                            <td>
                                @{
                                    var u2Exists = userLookup.TryGetValue(bet.UserId, out var u2Discord);
                                    var u2Name = u2Exists && !string.IsNullOrEmpty(u2Discord.DiscordName) ? u2Discord.DiscordName : bet.UserName;
                                    var expectedChannel2 = $"{u2Name?.Trim().ToLower().Replace(" ", "-")}-admins";
                                    var matchedChannel2 = discordChannels.FirstOrDefault(c => string.Equals(c.Name, expectedChannel2, StringComparison.OrdinalIgnoreCase));
                                    var u2Link = matchedChannel2.Id != 0 
                                        ? $"https://discord.com/channels/{DiscordService.GuildId}/{matchedChannel2.Id}" 
                                        : $"https://discord.com/channels/{DiscordService.GuildId}";
                                }
                                <a href="@u2Link" target="_blank" class="text-decoration-none fw-bold">@u2Name</a>
                            </td>
                            <td>@(userLookup.TryGetValue(bet.UserId, out var u2) ? u2.LastName : "")</td>
                            <td>
                                @bet.AmountNOK?.ToString("N0") kr
                                @if (bet.FreeBetAmount > 0) {
                                    <br/><span class="badge bg-info text-dark small"><i class="bi bi-gift-fill"></i> Free Bet</span>
                                }
                            </td>
                             <td>@bet.Odds.ToString("N2")</td>
     
                            <td>@bet.PotentialPayout.ToString("N0") kr</td>
                            <td class="text-danger">@((bet.PotentialPayout - ((decimal)(bet.AmountNOK ?? 0) - bet.FreeBetAmount)).ToString("N0")) kr</td>
                        </tr>
                    }
                    @if (approvedBets.Count == 0) { <tr><td colspan="10" class="text-muted">No active bets.</td></tr> }
                 </tbody>
            </table>
            <div class="d-flex justify-content-between align-items-center mt-2">
                <button class="btn btn-sm @(approvedPage <= 1 ? "btn-outline-secondary" : "btn-primary shadow-sm")" @onclick="PrevApprovedPage" disabled="@(approvedPage <= 1)"><i class="bi bi-arrow-left"></i> Previous</button>
                <span class="text-muted fw-bold">Page @approvedPage</span>
                <button class="btn btn-sm @(!hasMoreApprovedBets ? "btn-outline-secondary" : "btn-primary shadow-sm fw-bold")" @onclick="NextApprovedPage" disabled="@(!hasMoreApprovedBets)">Next <i class="bi bi-arrow-right"></i></button>
            </div>
        </div>

        <div class="d-flex flex-column mb-3 mt-4 gap-2">
            <div class="d-flex justify-content-between align-items-center flex-nowrap gap-2">
                <h4 class="mb-0 text-truncate" style="font-size: clamp(1rem, 4vw, 1.5rem);">Completed</h4>
                <div class="d-flex gap-2 align-items-center flex-shrink-0">
                    <div class="input-group input-group-sm shadow-sm flex-shrink-0" style="max-width: 200px;">
                        <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" class="form-control border-start-0 ps-0" placeholder="Bet ID or Username..." @bind="completedSearchTerm" @bind:event="oninput" @bind:after="OnCompletedSearchChanged" />
                        @if (!string.IsNullOrWhiteSpace(completedSearchTerm))
                        {
                            <button class="btn btn-outline-secondary" type="button" @onclick="ClearCompletedSearch" title="Clear search">
                                <i class="bi bi-x"></i>
                            </button>
                        }
                    </div>
                    <button class="btn btn-outline-secondary btn-sm flex-shrink-0" @onclick="ExportCompletedBetsCsv" title="Export CSV">
                        <i class="bi bi-download"></i> <span class="d-none d-sm-inline">Export CSV</span>
                    </button>
                </div>
            </div>
            
            <div class="d-flex gap-2 flex-wrap align-items-center p-2 rounded shadow-sm border" style="background-color: #f8f9fa;">
                <span class="text-muted small fw-bold text-uppercase me-1"><i class="bi bi-funnel-fill"></i> Filter</span>
                <button class="btn btn-sm rounded-pill @(completedStatusFilters.Contains("Won") ? "btn-dark shadow-sm" : "btn-outline-secondary bg-white text-muted")" style="font-weight: 500;" @onclick="@(() => ToggleFilter("Won"))" disabled="@(showOnlyMismatch || showOnlyAutoApproved || showOnlyAdminOverride)">Won</button>
                <button class="btn btn-sm rounded-pill @(completedStatusFilters.Contains("Lost") ? "btn-dark shadow-sm" : "btn-outline-secondary bg-white text-muted")" style="font-weight: 500;" @onclick="@(() => ToggleFilter("Lost"))" disabled="@(showOnlyMismatch || showOnlyAutoApproved || showOnlyAdminOverride)">Lost</button>
                <button class="btn btn-sm rounded-pill @(completedStatusFilters.Contains("Void") ? "btn-dark shadow-sm" : "btn-outline-secondary bg-white text-muted")" style="font-weight: 500;" @onclick="@(() => ToggleFilter("Void"))" disabled="@(showOnlyMismatch || showOnlyAutoApproved || showOnlyAdminOverride)">Void</button>
                <button class="btn btn-sm rounded-pill @(completedStatusFilters.Contains("Rejected") ? "btn-dark shadow-sm" : "btn-outline-secondary bg-white text-muted")" style="font-weight: 500;" @onclick="@(() => ToggleFilter("Rejected"))" disabled="@(showOnlyMismatch || showOnlyAutoApproved || showOnlyAdminOverride)">Rejected</button>
                <button class="btn btn-sm rounded-pill @(completedStatusFilters.Contains("Cancelled") ? "btn-dark shadow-sm" : "btn-outline-secondary bg-white text-muted")" style="font-weight: 500;" @onclick="@(() => ToggleFilter("Cancelled"))" disabled="@(showOnlyMismatch || showOnlyAutoApproved || showOnlyAdminOverride)">Cancelled</button>
                <div class="vr mx-1 d-none d-sm-block"></div>
                <button class="btn btn-sm rounded-pill @(showOnlyMismatch ? "btn-warning" : "btn-outline-warning text-dark bg-white") shadow-sm" style="font-weight: 600;" @onclick="ToggleMismatchFilter" title="Show only bets where Admin outcome doesn't match AI outcome" disabled="@(showOnlyAutoApproved || showOnlyAdminOverride)">
                    <i class="bi bi-robot"></i> AI Mismatch
                </button>
                <button class="btn btn-sm rounded-pill @(showOnlyAutoApproved ? "btn-primary" : "btn-outline-primary bg-white") shadow-sm" style="font-weight: 600;" @onclick="ToggleAutoApprovedFilter" title="Show only Auto-Approved bets" disabled="@(showOnlyMismatch || showOnlyAdminOverride)">
                    <i class="bi bi-lightning-charge-fill"></i> Auto-Approved
                </button>
                <button class="btn btn-sm rounded-pill @(showOnlyAdminOverride ? "btn-success" : "btn-outline-success bg-white") shadow-sm" style="font-weight: 600;" @onclick="ToggleAdminOverrideFilter" title="Show only bets with Admin Override" disabled="@(showOnlyMismatch || showOnlyAutoApproved)">
                    <i class="bi bi-shield-check"></i> Admin Override
                </button>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-sm table-striped table-hover text-nowrap align-middle">
                <thead class="table-dark">
                    <tr>
                
                         <th>Action</th>
                         <th style="width: 110px;">AI Outcome</th>
                         <th>ID</th>
                         <th class="text-nowrap">Last Updated</th>
            
                         <th>Discord Username</th>
                         <th>Last Name</th>
                         <th>Bet Amount</th>
                         <th>Odds</th>
         
                         <th>Status</th>
                         <th>Payout</th>
                         <th>Net Profit</th>
                    </tr>
                  </thead>
                <tbody>
     
                    @foreach (var bet in completedBets)
                    {
                        var rowClass = bet.Status == "Won" ? "table-success" : (bet.Status == "Lost" ? "table-danger" : "table-secondary");
                        <tr @key="bet.Id" class="@rowClass">
                            <td>
                                  <button class="btn btn-outline-dark btn-sm" @onclick="() => StartReview(bet)">
                      
                                    <i class="bi bi-pencil-square"></i> View/Edit
                                  </button>
                            </td>
                            <td class="text-center">
                                @if (IsCheckingOutcome(bet.Id)) {
                                    <span class="badge bg-info text-dark shadow-sm"><span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Checking</span>
                                } else {
                                    @GetAiOutcomeBadge(bet)
                                }
                            </td>
                    
                            <td><div class="d-flex flex-column align-items-start"><span>@bet.Id</span>@GetLivePlacedBadge(bet, "mt-1")</div></td>
                            <td class="text-nowrap">@ToUserLocal(bet.UpdatedAt).ToString("g")</td>
                            <td>
                                @{
                                    var u3Exists = userLookup.TryGetValue(bet.UserId, out var u3Discord);
                                    var u3Name = u3Exists && !string.IsNullOrEmpty(u3Discord.DiscordName) ? u3Discord.DiscordName : bet.UserName;
                                    var expectedChannel3 = $"{u3Name?.Trim().ToLower().Replace(" ", "-")}-admins";
                                    var matchedChannel3 = discordChannels.FirstOrDefault(c => string.Equals(c.Name, expectedChannel3, StringComparison.OrdinalIgnoreCase));
                                    var u3Link = matchedChannel3.Id != 0 
                                        ? $"https://discord.com/channels/{DiscordService.GuildId}/{matchedChannel3.Id}" 
                                        : $"https://discord.com/channels/{DiscordService.GuildId}";
                                }
                                <a href="@u3Link" target="_blank" class="text-decoration-none fw-bold">@u3Name</a>
                            </td>
                            <td>@(userLookup.TryGetValue(bet.UserId, out var u2) ? u2.LastName : "")</td>
                            <td>
                                @bet.AmountNOK?.ToString("N0") kr
                                @if (bet.FreeBetAmount > 0) {
                                    <br/><span class="badge bg-info text-dark small"><i class="bi bi-gift-fill"></i> Free Bet</span>
                                }
                            </td>
                            <td>@bet.Odds.ToString("N2")</td>
       
                            <td>
                                 <span class="badge @GetStatusBadgeClass(bet.Status)">@bet.Status</span>
                            </td>
               
                            <td>
                              @if(bet.Status == "Won") { @bet.PotentialPayout.ToString("N0") <span>kr</span> }
                              else if (bet.Status == "Lost") { <span>0 kr</span> }
                              else { <span class="text-muted">-</span> }
                            </td>
                            @{
                                var netProfit = GetNetProfit(bet);
                                var profitClass = netProfit > 0 ? "text-success" : (netProfit < 0 ? "text-danger" : "text-muted");
                            }
                            <td class="@profitClass fw-bold">@netProfit.ToString("N0") kr</td>
                        </tr>
                    }
      
                    @if (completedBets.Count == 0) { <tr><td colspan="11" class="text-muted">No completed bets found.</td></tr> }
            </tbody>
            </table>
            
            <div class="d-flex justify-content-between align-items-center mt-2 mb-4">
                <button class="btn btn-sm @(completedPage <= 1 ? "btn-outline-secondary" : "btn-primary shadow-sm")" @onclick="PrevPage" disabled="@(completedPage <= 1)"><i class="bi bi-arrow-left"></i> Previous</button>
                <span class="text-muted fw-bold">Page @completedPage</span>
                <button class="btn btn-sm @(!hasMoreCompletedBets ? "btn-outline-secondary" : "btn-primary shadow-sm fw-bold")" @onclick="NextPage" disabled="@(!hasMoreCompletedBets)">Next <i class="bi bi-arrow-right"></i></button>
            </div>
        </div>
    </div>
</div>
}

@code {
    private RenderFragment GetLivePlacedBadge(Bet bet, string cssClass = "ms-2", bool isModalHeader = false) => __builder =>
    {
        if (bet.IsLive)
        {
            <span class="badge bg-danger shadow-sm @cssClass" title="This bet was placed while the match was live/in-play.">
                <i class="bi bi-broadcast me-1"></i> Live Bet
            </span>
        }

        if (bet.Status == "Pending" && bet.AutoApproveAt.HasValue)
        {
            var remainingSec = Math.Max(0, (int)Math.Ceiling((bet.AutoApproveAt.Value - DateTime.UtcNow).TotalSeconds));
            <span class="badge bg-info text-dark shadow-sm @cssClass d-inline-flex align-items-center" title="Eligible for Auto-Approval. Will re-verify odds and balance at 0s.">
                <i class="bi bi-robot me-1"></i> Auto-Approve @(remainingSec > 0 ? $"{remainingSec}s" : "...")
                @if (isModalHeader)
                {
                    <button type="button" class="btn-close ms-2" style="font-size: 0.55rem;" title="Stop Auto-Approval countdown" @onclick="() => CancelAutoApprovalCountdownAsync(bet.Id)" @onclick:stopPropagation="true"></button>
                }
            </span>
        }
        else if (bet.IsAutoApproved)
        {
            <span class="badge bg-success shadow-sm @cssClass" title="This bet was automatically approved by the system.">
                <i class="bi bi-robot me-1"></i> Auto-Approved
            </span>
        }
        
        if (bet.IsAutoSettled)
        {
            <span class="badge bg-primary shadow-sm @cssClass" title="This bet was automatically settled by the AI gatekeeper.">
                <i class="bi bi-robot me-1"></i> Auto-Settled
            </span>
        }
    };

    private RenderFragment GetMonitoringStatusBadge(Bet bet) => __builder =>
    {
        if (IsCheckingOutcome(bet.Id))
        {
            <span class="badge bg-info text-dark shadow-sm"><span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Checking</span>
        }
        else if (bet.NextCheckTime == null)
        {
            bool isFinished = false;
            if (!string.IsNullOrEmpty(bet.AiOutcomeResult))
            {
                try {
                    BettingApp.Services.AiOutcomeResultData? parsed = null;
                    if (_outcomeCache.TryGetValue(bet.Id, out var cached) && cached.Json == bet.AiOutcomeResult) {
                        parsed = cached.Result;
                    } else {
                        try { parsed = System.Text.Json.JsonSerializer.Deserialize<BettingApp.Services.AiOutcomeResultData>(bet.AiOutcomeResult, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }); } catch {}
                        _outcomeCache[bet.Id] = (bet.AiOutcomeResult, parsed);
                    }
                    
                    if (parsed != null && !string.IsNullOrEmpty(parsed.OverallStatus))
                    {
                        var status = parsed.OverallStatus.Trim().ToUpperInvariant();
                        isFinished = status == "WON" || status == "LOST" || status == "VOID" || status == "UNKNOWN" ||
                            status == "MATCH FINISHED - WON" || status == "MATCH WON" || 
                            status == "MATCH FINISHED - LOST" || status == "MATCH LOST" || 
                            status == "MATCH FINISHED - VOID" || status == "MATCH VOID";
                    }
                } catch { }
            }

            if (isFinished)
            {
                <span class="badge bg-secondary shadow-sm"><i class="bi bi-stop-circle me-1"></i> Stopped</span>
            }
            else
            {
                <span class="badge bg-secondary shadow-sm"><i class="bi bi-hourglass-split me-1"></i> Queued</span>
            }
        }
        else
        {
            var now = DateTime.UtcNow;
            if (bet.MatchStartTime.HasValue && bet.MatchStartTime.Value > now)
            {
                <div class="d-flex flex-column align-items-start gap-1" title="Match hasn't started yet">
                    <span class="badge bg-warning text-dark shadow-sm">
                        <i class="bi bi-calendar-event me-1"></i> Starts @ToUserLocal(bet.MatchStartTime.Value).ToString("g")
                    </span>
                    <span class="badge bg-light text-dark border" style="font-size: 0.65em;">
                        Next Check: @(bet.NextCheckTime.HasValue ? ToUserLocal(bet.NextCheckTime.Value).ToString("g") : "Pending")
                    </span>
                </div>
            }
            else if (!bet.MatchStartTime.HasValue)
            {
                <div class="d-flex flex-column align-items-start gap-1">
                    <span class="badge bg-secondary shadow-sm">
                        <i class="bi bi-calendar-x me-1"></i> Unknown Start
                    </span>
                    <span class="badge bg-light text-dark border" style="font-size: 0.65em;">
                        Next Check: @(bet.NextCheckTime.HasValue ? ToUserLocal(bet.NextCheckTime.Value).ToString("g") : "Pending")
                    </span>
                </div>
            }
            else 
            {
                <div class="d-flex flex-column align-items-start gap-1" title="Match is in-play">
                    <span class="badge bg-success shadow-sm">
                        <i class="bi bi-activity me-1"></i> In-Play
                    </span>
                    <span class="badge bg-light text-dark border" style="font-size: 0.65em;">
                        Next Check: @(bet.NextCheckTime.HasValue ? ToUserLocal(bet.NextCheckTime.Value).ToString("g") : "Pending")
                    </span>
                </div>
            }
        }
    };
    
    
}
