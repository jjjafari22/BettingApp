                         <th>Action</th>
                         <th style="width: 110px;">AI Outcome</th>
                         <th>ID</th>
                         <th class="text-nowrap">Last Updated</th>
            
                         <th>Discord Username</th>
                         <th>Last Name</th>
                         <th>Bet Amount</th>
                         <th>Odds</th>
         
