                                    <img src="@GetScreenshotUrl(reviewingBetModel.ScreenshotUrl)" class="img-fluid rounded shadow" style="max-height: 100%; max-width: 100%; object-fit: contain;" alt="Bet Screenshot" />
                                } else {
                                    <div class="text-white-50 fst-italic text-center">
                                        <i class="bi bi-image-fill display-1 d-block mb-3"></i><span>No Image Available</span>
                                    </div>
                                }
                            </div>
                            
                            <!-- Left Fixed Actions Area -->
                            <div class="desktop-left-actions text-center pb-3 pt-3">
                                @if (!string.IsNullOrEmpty(reviewingBetModel.ScreenshotUrl)) {
                                    @if (reviewingBetModel.Status == "Pending" || reviewingBetModel.Status == "Processing") {
                                        bool isBackgroundProcessing = BettingApp.Services.AiVisionService.ProcessingAutoReadBetIds.ContainsKey(reviewingBetModel.Id);
                                        bool isManualProcessing = AnalyzingImageBetIds.Contains(reviewingBetModel.Id);
                                        bool showAnalyzing = isBackgroundProcessing || isManualProcessing;
                                        bool hasRanAlready = !string.IsNullOrEmpty(reviewingBetModel.AiVisionResultJson);
                                        
