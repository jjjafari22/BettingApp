                <button class="btn btn-sm rounded-pill @(showOnlyAdminOverride ? "btn-success" : "btn-outline-success bg-white") shadow-sm" style="font-weight: 600;" @onclick="ToggleAdminOverrideFilter" title="Show only bets with Admin Override" disabled="@showOnlyMismatch">
