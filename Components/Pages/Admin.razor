                                    var uModalName = uModalExists && !string.IsNullOrEmpty(uModal.DiscordName) ? uModal.DiscordName : reviewingBetModel.UserName;
                                    var expectedModalChannel = $"{uModalName?.Trim().ToLower().Replace(" ", "-")}-admins";
                                    var matchedModalChannel = discordChannels.FirstOrDefault(c => string.Equals(c.Name, expectedModalChannel, StringComparison.OrdinalIgnoreCase));
                                    var uModalLink = matchedModalChannel.Id != 0 
                                        ? $"https://discord.com/channels/{DiscordService.GuildId}/{matchedModalChannel.Id}" 
