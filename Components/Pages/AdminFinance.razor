@page "/admin/finance"
<PageTitle>Finance Dashboard - Castle of Happiness</PageTitle>
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.EntityFrameworkCore
@using BettingApp.Data
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: true))

<h3>Finance Dashboard</h3>

@if (!isAuthorized)
{
    <LoadingData Text="Loading Finance Data..." />
    return;
}

<div class="row mb-4 mt-3">
    <div class="col-12">
        <div class="card bg-dark text-white shadow border-0">
            <div class="card-header border-bottom border-secondary py-2 d-flex justify-content-between align-items-center">
                <h6 class="card-title text-info mb-0">
                    <i class="bi bi-broadcast me-2"></i>Live Tracker
                </h6>
                <span class="badge bg-secondary fw-normal" style="font-size:0.7rem;">Excl. Test Users</span>
            </div>
            <div class="card-body p-0">
                <div class="row g-0">
                    <div class="col-6 border-end border-secondary p-2 p-md-3 d-flex flex-column flex-md-row justify-content-md-between align-items-center">
                        <div class="mb-1 mb-md-0 text-center text-md-start">
                            <h6 class="text-white mb-0 d-inline-block"><i class="bi bi-graph-up-arrow text-success me-1"></i>Profit</h6>
                            <small class="text-muted d-block d-md-inline-block ms-md-2" style="font-size: 0.75rem;">(If LOSE)</small>
                        </div>
                        <h5 class="mb-0 text-success fw-bold">+@netOpenProfitIfLost.ToString("N0") kr</h5>
                    </div>
                    <div class="col-6 p-2 p-md-3 d-flex flex-column flex-md-row justify-content-md-between align-items-center">
                        <div class="mb-1 mb-md-0 text-center text-md-start">
                            <h6 class="text-white mb-0 d-inline-block"><i class="bi bi-graph-down-arrow text-danger me-1"></i>Liability</h6>
                            <small class="text-muted d-block d-md-inline-block ms-md-2" style="font-size: 0.75rem;">(If WIN)</small>
                        </div>
                        <h5 class="mb-0 text-danger fw-bold">-@netOpenLiability.ToString("N0") kr</h5>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center flex-wrap">
        <div class="btn-group mb-2 mb-md-0" role="group">
            <button type="button" class="btn btn-@(viewMode == ViewMode.Daily ? "light" : "outline-light")" @onclick="() => SetViewMode(ViewMode.Daily)">Daily</button>
            <button type="button" class="btn btn-@(viewMode == ViewMode.Weekly ? "light" : "outline-light")" @onclick="() => SetViewMode(ViewMode.Weekly)">Weekly</button>
            <button type="button" class="btn btn-@(viewMode == ViewMode.Monthly ? "light" : "outline-light")" @onclick="() => SetViewMode(ViewMode.Monthly)">Monthly</button>
            <button type="button" class="btn btn-@(viewMode == ViewMode.Yearly ? "light" : "outline-light")" @onclick="() => SetViewMode(ViewMode.Yearly)">Yearly</button>
            <button type="button" class="btn btn-@(viewMode == ViewMode.Custom ? "light" : "outline-light")" @onclick="() => SetViewMode(ViewMode.Custom)">Custom</button>
        </div>
        
        <div class="d-flex align-items-center flex-wrap gap-2 mt-2 mt-md-0">
            @if (viewMode == ViewMode.Custom)
            {
                <div class="d-flex align-items-center bg-white rounded p-1 shadow-sm">
                    <input type="date" class="form-control form-control-sm border-0" @bind="customStartDateNorway" @bind:after="OnCustomDateChanged" title="From Date" />
                    <span class="mx-2 text-dark fw-bold">-</span>
                    <input type="date" class="form-control form-control-sm border-0" @bind="customEndDateNorway" @bind:after="OnCustomDateChanged" title="To Date" />
                </div>
            }
            else
            {
                <button class="btn btn-outline-light btn-sm" @onclick="PreviousPeriod"><i class="bi bi-chevron-left"></i></button>
                <span class="fw-bold mx-2">@GetPeriodDisplayString()</span>
                <button class="btn btn-outline-light btn-sm" @onclick="NextPeriod"><i class="bi bi-chevron-right"></i></button>
                <button class="btn btn-light btn-sm ms-2" @onclick="GoToCurrent">Today</button>
            }
        </div>
    </div>
    
    <div class="card-body">
        <h5 class="text-secondary mb-4 border-bottom pb-2">
            <i class="bi bi-journal-check me-2"></i>Settled Bets Metrics (Won, Lost, Void - Excl. Test Users)
        </h5>

        <div class="row text-center align-items-stretch">
            <div class="col-md-3 mb-3">
                 <div class="p-3 border rounded bg-light h-100 d-flex flex-column justify-content-center">
                    <h6 class="text-muted">Total Stakes (Real)</h6>
                    <h4 class="mb-0">@totalStakes.ToString("N0") kr</h4>
                    <small class="text-muted mt-1">From @totalBets bets</small>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="p-3 border rounded bg-light h-100 d-flex flex-column justify-content-center">
                    <h6 class="text-muted">Net Profit</h6>
                    <h4 class="mb-0 @(netProfit >= 0 ? "text-success" : "text-danger")">@netProfit.ToString("N0") kr</h4>
                    <small class="text-muted mt-1">Real Stakes minus Payouts</small>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="p-3 border rounded bg-light h-100 d-flex flex-column justify-content-center">
                    <h6 class="text-muted">Hold %</h6>
                    <h4 class="mb-0">@holdPercentage.ToString("0.00")%</h4>
                    <small class="text-muted mt-1">Profit on real stakes</small>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                 <div class="p-3 border rounded bg-light h-100 d-flex flex-column justify-content-center">
                    <h6 class="text-muted">Free Bets Granted</h6>
                    <h4 class="mb-0 text-info">@totalFreeBetsAmount.ToString("N0") kr</h4>
                    <small class="text-muted mt-1">From @totalFreeBetsCount transactions</small>
                </div>
            </div>
            
            <div class="col-md-3 mb-3">
                <div class="p-3 border rounded bg-light h-100 d-flex flex-column justify-content-center">
                    <h6 class="text-muted">Avg Weighted Odds</h6>
                    <h4 class="mb-0">@avgOdds.ToString("0.00")</h4>
                    <small class="text-muted mt-1">Weighted by stake</small>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="p-3 border rounded bg-light h-100 d-flex flex-column justify-content-center">
                    <h6 class="text-muted">Average Bet Size</h6>
                    <h4 class="mb-0">@avgBetSize.ToString("N0") kr</h4>
                    <small class="text-muted mt-1">Real stakes per bet</small>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="p-3 border rounded bg-light h-100 d-flex flex-column justify-content-center">
                    <h6 class="text-muted">Avg Liability Per Bet</h6>
                    <h4 class="mb-0 text-warning">@avgNetLiability.ToString("N0") kr</h4>
                    <small class="text-muted mt-1">Average net risk per bet</small>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="p-3 border rounded bg-light h-100 d-flex flex-column justify-content-center">
                    <h6 class="text-muted">Total Period Liability</h6>
                    <h4 class="mb-0 text-danger">@totalNetLiability.ToString("N0") kr</h4>
                    <small class="text-muted mt-1">Total net exposure</small>
                </div>
            </div>
        </div>
        <div class="text-end text-muted small mt-2">
            <em>*Metrics based on Norwegian Timezone (CET/CEST).
            Includes ONLY Settled bets (Won, Lost, Void). Active/Approved bets are tracked separately above.
            <strong>Bets from Test Users are EXCLUDED from all metrics.</strong></em>
        </div>
    </div>
</div>

@code {
    private enum ViewMode { Daily, Weekly, Monthly, Yearly, Custom }

    private bool isAuthorized = false;
    private HubConnection? hubConnection;
    
    // State
    private ViewMode viewMode = ViewMode.Daily;
    private DateTime currentDateNorway; // Tracks the currently viewed date in Norway time
    
    // Custom Date Range
    private DateTime? customStartDateNorway;
    private DateTime? customEndDateNorway;
    
    // Live Tracker
    private decimal netOpenLiability = 0;
    private decimal netOpenProfitIfLost = 0;
    
    // Period Metrics
    private decimal totalStakes = 0;
    private decimal totalFreeBetsAmount = 0;
    private int totalFreeBetsCount = 0;
    private decimal netProfit = 0;
    private decimal holdPercentage = 0;
    private decimal avgOdds = 0;
    private decimal avgBetSize = 0;
    private decimal avgNetLiability = 0;
    private decimal totalNetLiability = 0;
    private int totalBets = 0;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (HttpContext != null) return; // Prerendering: exit instantly to show spinner

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userName = authState.User.Identity?.Name;

        if (string.IsNullOrEmpty(userName)) { Nav.NavigateTo("/"); return; }

        using var context = DbFactory.CreateDbContext();
        var dbUser = await context.Users.AsNoTracking().FirstOrDefaultAsync(u => u.UserName == userName);
        if (dbUser == null || !dbUser.IsAdmin) { Nav.NavigateTo("/"); return; }

        isAuthorized = true;

        // Time Setup
        currentDateNorway = TimeHelpers.GetNorwayTime(DateTime.UtcNow);

        GoToCurrent();

        // 3. Setup SignalR for live liability updates
        try 
        {
            hubConnection = new HubConnectionBuilder()
                .WithUrl(Nav.ToAbsoluteUri("/bethub"))
                .Build();

            hubConnection.On<string>("ReceiveAdminNotification", async (msg) => await RefreshLiveLiability(context));
            hubConnection.On<string>("ReceiveUpdate", async (msg) => await RefreshLiveLiability(context));

            await hubConnection.StartAsync();
            await hubConnection.InvokeAsync("JoinAdminGroup");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Finance SignalR Error: {ex.Message}");
        }
    }

    private async Task RefreshLiveLiability(ApplicationDbContext context)
    {
        // Net Open Liability = Sum of (Potential Payout - Normal Stake Portion) for active ("Approved") bets.
        // For free bets, PotentialPayout IS the net liability.
        // Formula: PotentialPayout - (TotalStake - FreeBetAmount)
        var activeBets = await context.Bets
            .Where(b => b.Status == "Approved" && !context.Users.Any(u => u.Id == b.UserId && u.IsTestUser))
            .AsNoTracking()
            .ToListAsync();
            
        netOpenLiability = activeBets.Sum(b => b.NetLiability);
        netOpenProfitIfLost = activeBets.Sum(b => ((decimal)(b.AmountNOK ?? 0) - b.FreeBetAmount));
        await InvokeAsync(StateHasChanged);
    }

    private void GoToCurrent()
    {
        currentDateNorway = TimeHelpers.GetNorwayTime(DateTime.UtcNow);
        _ = LoadMetricsAsync();
    }

    private void SetViewMode(ViewMode mode)
    {
        viewMode = mode;
        if (mode == ViewMode.Custom)
        {
            customStartDateNorway ??= currentDateNorway.Date.AddDays(-7);
            customEndDateNorway ??= currentDateNorway.Date;
        }
        _ = LoadMetricsAsync();
    }

    private void OnCustomDateChanged()
    {
        if (customStartDateNorway != null && customEndDateNorway != null)
        {
            if (customStartDateNorway > customEndDateNorway)
            {
                // Auto-correct if start > end
                var temp = customStartDateNorway;
                customStartDateNorway = customEndDateNorway;
                customEndDateNorway = temp;
            }
            _ = LoadMetricsAsync();
        }
    }

    private void PreviousPeriod()
    {
        currentDateNorway = viewMode switch
        {
            ViewMode.Daily => currentDateNorway.AddDays(-1),
            ViewMode.Weekly => currentDateNorway.AddDays(-7),
            ViewMode.Monthly => currentDateNorway.AddMonths(-1),
            ViewMode.Yearly => currentDateNorway.AddYears(-1),
            _ => currentDateNorway
        };
        _ = LoadMetricsAsync();
    }

    private void NextPeriod()
    {
        currentDateNorway = viewMode switch
        {
            ViewMode.Daily => currentDateNorway.AddDays(1),
            ViewMode.Weekly => currentDateNorway.AddDays(7),
            ViewMode.Monthly => currentDateNorway.AddMonths(1),
            ViewMode.Yearly => currentDateNorway.AddYears(1),
            _ => currentDateNorway
        };
        _ = LoadMetricsAsync();
    }

    private string GetPeriodDisplayString()
    {
        return viewMode switch
        {
            ViewMode.Daily => currentDateNorway.ToString("dd MMM yyyy"),
            ViewMode.Weekly => 
                GetStartOfWeek(currentDateNorway).ToString("dd MMM") + " - " + 
                GetStartOfWeek(currentDateNorway).AddDays(6).ToString("dd MMM yyyy"),
            ViewMode.Monthly => currentDateNorway.ToString("MMMM yyyy"),
            ViewMode.Yearly => currentDateNorway.ToString("yyyy"),
            _ => ""
        };
    }

    private DateTime GetStartOfWeek(DateTime dt)
    {
        int diff = (7 + (dt.DayOfWeek - DayOfWeek.Monday)) % 7;
        return dt.Date.AddDays(-1 * diff);
    }

    private async Task LoadMetricsAsync()
    {
        using var context = DbFactory.CreateDbContext();
        await RefreshLiveLiability(context);

        // Calculate UTC boundaries based on Norwegian Time
        DateTime startNorway;
        DateTime endNorway;

        switch (viewMode)
        {
            case ViewMode.Daily:
                startNorway = currentDateNorway.Date;
                endNorway = startNorway.AddDays(1);
                break;
            case ViewMode.Weekly:
                startNorway = GetStartOfWeek(currentDateNorway);
                endNorway = startNorway.AddDays(7);
                break;
            case ViewMode.Monthly:
                startNorway = new DateTime(currentDateNorway.Year, currentDateNorway.Month, 1);
                endNorway = startNorway.AddMonths(1);
                break;
            case ViewMode.Yearly:
                startNorway = new DateTime(currentDateNorway.Year, 1, 1);
                endNorway = startNorway.AddYears(1);
                break;
            case ViewMode.Custom:
                startNorway = customStartDateNorway?.Date ?? currentDateNorway.Date;
                endNorway = (customEndDateNorway?.Date ?? currentDateNorway.Date).AddDays(1);
                break;
            default:
                startNorway = currentDateNorway.Date;
                endNorway = startNorway.AddDays(1);
                break;
        }

        DateTime startUtc = TimeHelpers.GetUtcFromNorwayTime(startNorway);
        DateTime endUtc = TimeHelpers.GetUtcFromNorwayTime(endNorway);

        // Fetch free bet transactions
        var freeBetTransactions = await context.Transactions
            .Where(t => t.UpdatedAt >= startUtc && t.UpdatedAt < endUtc && t.Type == "Free Bet" && t.Status == "Completed")
            .Where(t => !context.Users.Any(u => u.Id == t.UserId && u.IsTestUser))
            .AsNoTracking()
            .ToListAsync();
        
        totalFreeBetsCount = freeBetTransactions.Count;
        totalFreeBetsAmount = freeBetTransactions.Sum(t => (decimal)t.AmountNOK);

        // Fetch settled bets ONLY (using UpdatedAt instead of CreatedAt)
        // EXCLUDES Test Users.
        var validStatuses = new[] { "Won", "Lost", "Void" };
        var stats = await context.Bets
            .Where(b => b.UpdatedAt >= startUtc && b.UpdatedAt < endUtc && validStatuses.Contains(b.Status))
            .Where(b => !context.Users.Any(u => u.Id == b.UserId && u.IsTestUser))
            .GroupBy(b => 1)
            .Select(g => new
            {
                Count = g.Count(),
                TotalAmountNOK = g.Sum(b => (decimal)(b.AmountNOK ?? 0)),
                TotalStakes = g.Sum(b => (decimal)(b.AmountNOK ?? 0) - b.FreeBetAmount),
                WonPayouts = g.Where(b => b.Status == "Won").Sum(b => (decimal)(b.AmountNOK ?? 0) * b.Odds - b.FreeBetAmount),
                VoidRefunds = g.Where(b => b.Status == "Void").Sum(b => (decimal)(b.AmountNOK ?? 0) - b.FreeBetAmount),
                TotalWageredForOdds = g.Where(b => b.Odds > 0).Sum(b => (decimal)(b.AmountNOK ?? 0)),
                WeightedOddsProduct = g.Where(b => b.Odds > 0).Sum(b => (decimal)(b.AmountNOK ?? 0) * b.Odds),
                ArithmeticAverageOdds = g.Where(b => b.Odds > 0).Average(b => (decimal?)b.Odds) ?? 0m,
                TotalNetLiability = g.Sum(b => (decimal)(b.AmountNOK ?? 0) * (b.Odds - 1)),
                AvgNetLiability = g.Average(b => (decimal?)((decimal)(b.AmountNOK ?? 0) * (b.Odds - 1))) ?? 0m
            })
            .FirstOrDefaultAsync();
            
        if (stats == null || stats.Count == 0)
        {
            totalBets = 0;
            totalStakes = 0;
            netProfit = 0;
            holdPercentage = 0;
            avgOdds = 0;
            avgBetSize = 0;
            avgNetLiability = 0;
            totalNetLiability = 0;
        }
        else
        {
            totalBets = stats.Count;
            totalStakes = stats.TotalStakes;
            decimal totalPayouts = Math.Floor(stats.WonPayouts) + stats.VoidRefunds;
            netProfit = totalStakes - totalPayouts;
            holdPercentage = totalStakes > 0 ? (netProfit / totalStakes) * 100 : 0;
            
            if (stats.TotalWageredForOdds > 0)
            {
                avgOdds = stats.WeightedOddsProduct / stats.TotalWageredForOdds;
            }
            else
            {
                avgOdds = stats.ArithmeticAverageOdds;
            }
            
            avgBetSize = stats.Count > 0 ? stats.TotalAmountNOK / stats.Count : 0;
            avgNetLiability = Math.Floor(stats.AvgNetLiability);
            totalNetLiability = Math.Floor(stats.TotalNetLiability);
        }

        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}
