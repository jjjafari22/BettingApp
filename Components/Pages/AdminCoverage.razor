@page "/admin/coverage"
<PageTitle>Coverage Schedule - Castle of Happiness</PageTitle>
@using BettingApp.Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime
@inject NavigationManager NavManager
@rendermode @(new InteractiveServerRenderMode(prerender: true))

<style>
    .coverage-table th, .coverage-table td {
        text-align: center;
        vertical-align: middle;
        cursor: pointer;
        height: 50px;
        user-select: none;
    }
    .coverage-table td:hover {
        background-color: #f8f9fa;
    }
    .selected-cell {
        background-color: #cfe2ff !important;
        outline: 2px solid #0d6efd;
        outline-offset: -2px;
    }
    .hour-col {
        width: 100px;
        font-weight: bold;
        background-color: #f8f9fa;
        white-space: nowrap;
        font-size: 0.9rem;
    }
</style>

<div class="container-fluid mb-5" @onmouseup="EndSelect" @onmouseleave="EndSelect">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <h2><i class="bi bi-calendar-week me-2 text-primary"></i>Coverage Schedule</h2>
        <div>
            <button class="btn btn-outline-secondary me-2" @onclick="PrevWeek"><i class="bi bi-chevron-left"></i> Prev</button>
            <button class="btn btn-primary me-2" @onclick="ThisWeek">This Week</button>
            <button class="btn btn-outline-secondary" @onclick="NextWeek">Next <i class="bi bi-chevron-right"></i></button>
        </div>
    </div>
    
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success">@successMessage</div>
    }

    @if (isLoading)
    {
        <div class="text-center my-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Loading schedule...</p>
        </div>
    }
    else
    {
        <h4 class="mb-3 text-center">Week of @startOfDisplayWeek.ToString("MMMM d, yyyy") (Norway Time)</h4>
        
        <div class="d-flex justify-content-center align-items-center mb-3 gap-4 small">
            <div><span class="d-inline-block rounded-circle me-1" style="width: 10px; height: 10px; background-color: #198754; vertical-align: middle;"></span> 100% Available</div>
            <div><span class="d-inline-block rounded-circle me-1" style="width: 10px; height: 10px; background-color: #ffc107; vertical-align: middle;"></span> Partly Available</div>
        </div>
        <div class="table-responsive">
            <table class="table table-bordered coverage-table table-sm">
                <thead class="table-dark">
                    <tr>
                        <th class="hour-col">Time</th>
                        @for (int d = 0; d < 7; d++)
                        {
                            var date = startOfDisplayWeek.AddDays(d);
                            bool isToday = date.Date == norwayToday.Date;
                            <th class="@(isToday ? "bg-primary" : "")">
                                @date.ToString("ddd")<br />
                                <small>@date.ToString("MM/dd")</small>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody @onmouseleave="EndSelect">
                    @for (int h = 0; h < 24; h++)
                    {
                        int currentHour = h;
                        bool isCurrentHour = weekOffset == 0 && norwayNow.Hour == currentHour;
                        <tr class="@(isCurrentHour ? "table-active" : "")">
                            <td class="hour-col">
                                @($"{h:00}:00-{(h + 1 == 24 ? 0 : h + 1):00}:00")<br/>
                                @if (TimezoneOffset != 0)
                                {
                                    <small class="text-muted fw-normal" style="font-size: 0.75rem;">@GetLocalTimeRange(h)</small>
                                }
                            </td>
                            @for (int d = 0; d < 7; d++)
                            {
                                int currentDay = d;
                                var cellDate = startOfDisplayWeek.AddDays(currentDay).AddHours(currentHour);
                                var cellShifts = shifts.Where(s => s.StartTimeUtc == TimeHelpers.GetUtcFromNorwayTime(cellDate)).ToList();
                                
                                bool isSelected = selectedDates.Contains(cellDate);
                                string cellClass = isSelected ? "selected-cell" : "";
                                
                                <td class="@cellClass" 
                                    @onmousedown="() => BeginSelect(currentDay, currentHour)"
                                    @onmouseenter="() => EnterSelect(currentDay, currentHour)"
                                    @onmouseup="() => EndSelect()"
                                    @onclick:preventDefault>
                                    @if (!isSelected && cellShifts.Any())
                                    {
                                        <div class="d-flex flex-column align-items-center justify-content-center gap-1">
                                            @foreach (var shift in cellShifts)
                                            {
                                                <div class="px-2 py-1 rounded w-100 text-center" style="background-color: @GetAdminColor(shift.AdminUserName); font-size: 0.8rem;">
                                                    <span class="d-inline-block rounded-circle me-1" 
                                                          style="width: 8px; height: 8px; background-color: @(shift.IsPartlyAvailable ? "#ffc107" : "#198754");" 
                                                          title="@(shift.IsPartlyAvailable ? "Partly Available" : "100% Available")"></span>
                                                    <span class="fw-bold text-dark">@GetAdminFirstName(shift.AdminUserName)</span>
                                                    @if (!string.IsNullOrWhiteSpace(shift.Note))
                                                    {
                                                        <i class="bi bi-journal-text ms-1 text-primary" title="@shift.Note"></i>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="text-muted small mt-2">
            <em>Tip: Click and drag your mouse across multiple cells to schedule yourself for multiple hours at once!</em>
        </div>
    }
</div>

@if (showModal)
{
    <div class="modal fade show d-block" id="coverageModal" tabindex="-1" style="background: rgba(0,0,0,0.5);" @onkeydown="HandleKeyDown">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-content-title">
                        @(selectedDates.Count > 1 ? $"Shift Coverage ({selectedDates.Count} hours selected)" : "Shift Coverage")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    @if (selectedDates.Count == 1)
                    {
                        var firstDate = selectedDates.First();
                        <p><strong>Time:</strong> @firstDate.ToString("dddd, MMMM d, yyyy - HH:00")-@firstDate.AddHours(1).ToString("HH:00") (Norway Time)</p>
                    }
                    else
                    {
                        <p><strong>Multiple Times Selected</strong> (See highlighted cells)</p>
                    }
                    


                    <div class="mb-3">
                        <label class="form-label d-block">Availability</label>
                        <div class="btn-group w-100" role="group">
                            <input type="radio" class="btn-check" name="btnradio" id="btnradio1" autocomplete="off" checked="@(!modalIsPartlyAvailable)" @onchange="() => modalIsPartlyAvailable = false">
                            <label class="btn btn-outline-success" for="btnradio1">
                                <span class="d-inline-block rounded-circle me-1" style="width: 8px; height: 8px; background-color: #198754;"></span> 100% Available
                            </label>

                            <input type="radio" class="btn-check" name="btnradio" id="btnradio2" autocomplete="off" checked="@modalIsPartlyAvailable" @onchange="() => modalIsPartlyAvailable = true">
                            <label class="btn btn-outline-warning" for="btnradio2">
                                <span class="d-inline-block rounded-circle me-1" style="width: 8px; height: 8px; background-color: #ffc107;"></span> Partly Available
                            </label>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Notes (Optional)</label>
                        <textarea class="form-control" rows="2" @bind="modalNote" placeholder="Any special notes for these hours?"></textarea>
                    </div>
                </div>
                <div class="modal-footer d-flex justify-content-between">
                    <button class="btn btn-danger" @onclick="RemoveShift">Clear Selected</button>
                    <div>
                        <button class="btn btn-secondary me-2" @onclick="CloseModal">Cancel</button>
                        <button class="btn btn-success" @onclick="SaveShift">Save Shifts</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private int weekOffset = 0;
    private DateTime norwayToday;
    private DateTime norwayNow;
    private DateTime startOfDisplayWeek;
    private List<CoverageShift> shifts = new();
    private List<ApplicationUser> allAdmins = new();
    private bool isLoading = true;
    private string errorMessage = "";
    private string successMessage = "";
    
    private bool isAdmin = false;
    private string currentUserName = "";

    // Selection State
    private bool isDragging = false;
    private HashSet<DateTime> selectedDates = new();

    // Modal state
    private bool showModal = false;
    private string modalAdminUserName = "";
    private string modalNote = "";
    private bool modalIsPartlyAvailable = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            currentUserName = user.Identity.Name ?? "Unknown";
            using var context = DbFactory.CreateDbContext();
            var dbUser = await context.Users.AsNoTracking().FirstOrDefaultAsync(u => u.UserName == currentUserName);
            isAdmin = dbUser?.IsAdmin ?? false;
            
            if (isAdmin)
            {
                allAdmins = await context.Users
                    .AsNoTracking()
                    .Where(u => u.IsAdmin)
                    .OrderBy(u => u.FirstName)
                    .ToListAsync();
            }
        }

        if (!isAdmin)
        {
            NavManager.NavigateTo("/");
            return;
        }

        CalculateWeek();
        await LoadShifts();
    }

    private int TimezoneOffset { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && isAdmin)
        {
            try
            {
                TimezoneOffset = await JSRuntime.InvokeAsync<int>("getBrowserTimeZoneOffset");
                StateHasChanged();
            }
            catch { }
        }
    }

    private void CalculateWeek()
    {
        norwayNow = TimeHelpers.GetNorwayTime(DateTime.UtcNow);
        norwayToday = norwayNow.Date;
        
        int diff = (7 + (norwayNow.DayOfWeek - DayOfWeek.Monday)) % 7;
        startOfDisplayWeek = norwayNow.AddDays(-1 * diff).Date.AddDays(weekOffset * 7);
    }
    
    private string GetLocalTimeRange(int h)
    {
        // h is the hour in Norway time
        // We first need to get the UTC time for today at hour h (Norway time)
        // Let's use today's date in Norway
        var dummyDate = norwayToday.AddHours(h);
        var utc = TimeHelpers.GetUtcFromNorwayTime(dummyDate);
        var localStart = utc.AddMinutes(-TimezoneOffset);
        var localEnd = localStart.AddHours(1);
        
        return $"{localStart:HH:mm}-{localEnd:HH:mm}";
    }

    private async Task LoadShifts()
    {
        isLoading = true;
        errorMessage = "";
        successMessage = "";
        selectedDates.Clear();
        isDragging = false;
        StateHasChanged();
        
        try
        {
            var startUtc = TimeHelpers.GetUtcFromNorwayTime(startOfDisplayWeek);
            var endUtc = TimeHelpers.GetUtcFromNorwayTime(startOfDisplayWeek.AddDays(7));
            
            using var context = DbFactory.CreateDbContext();
            shifts = await context.CoverageShifts
                .Where(s => s.StartTimeUtc >= startUtc && s.StartTimeUtc < endUtc)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading schedule: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private string GetAdminFirstName(string userName)
    {
        var admin = allAdmins.FirstOrDefault(a => a.UserName == userName);
        if (admin != null && !string.IsNullOrWhiteSpace(admin.FirstName))
        {
            return admin.FirstName;
        }
        return userName;
    }

    private string GetAdminColor(string userName)
    {
        if (string.IsNullOrEmpty(userName)) return "#d1e7dd";
        int hash = 0;
        for (int i = 0; i < userName.Length; i++)
        {
            hash = userName[i] + ((hash << 5) - hash);
        }
        int hue = Math.Abs(hash % 360);
        return $"hsl({hue}, 75%, 85%)";
    }

    private int dragStartDay = -1;
    private int dragStartHour = -1;

    private void BeginSelect(int day, int hour)
    {
        selectedDates.Clear();
        isDragging = true;
        dragStartDay = day;
        dragStartHour = hour;
        UpdateSelection(day, hour);
    }

    private void EnterSelect(int day, int hour)
    {
        if (isDragging)
        {
            UpdateSelection(day, hour);
        }
    }

    private void UpdateSelection(int endDay, int endHour)
    {
        selectedDates.Clear();
        int minDay = Math.Min(dragStartDay, endDay);
        int maxDay = Math.Max(dragStartDay, endDay);
        int minHour = Math.Min(dragStartHour, endHour);
        int maxHour = Math.Max(dragStartHour, endHour);
        
        for (int d = minDay; d <= maxDay; d++)
        {
            for (int h = minHour; h <= maxHour; h++)
            {
                selectedDates.Add(startOfDisplayWeek.AddDays(d).AddHours(h));
            }
        }
    }

    private void EndSelect()
    {
        if (isDragging)
        {
            isDragging = false;
            dragStartDay = -1;
            dragStartHour = -1;
            if (selectedDates.Count > 0)
            {
                OpenModalForSelection();
            }
        }
    }

    private void OpenModalForSelection()
    {
        successMessage = "";
        errorMessage = "";
        
        // If selecting a single cell with an existing shift, prefill it.
        if (selectedDates.Count == 1)
        {
            var shift = shifts.FirstOrDefault(s => s.StartTimeUtc == TimeHelpers.GetUtcFromNorwayTime(selectedDates.First()) && s.AdminUserName == currentUserName);
            if (shift != null)
            {
                modalNote = shift.Note ?? "";
                modalIsPartlyAvailable = shift.IsPartlyAvailable;
            }
            else
            {
                modalNote = "";
                modalIsPartlyAvailable = false;
            }
        }
        else
        {
            // For multiple selection, always default to current user and blank note
            modalNote = "";
            modalIsPartlyAvailable = false;
        }
        modalAdminUserName = currentUserName;
        
        showModal = true;
        StateHasChanged();
        _ = JSRuntime.InvokeVoidAsync("eval", "setTimeout(() => { var m = document.getElementById('coverageModal'); if(m) m.focus(); }, 50);");
    }

    private void HandleKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            CloseModal();
        }
    }

    private void CloseModal()
    {
        showModal = false;
        selectedDates.Clear();
    }

    private async Task SaveShift()
    {
        modalAdminUserName = currentUserName;

        try
        {
            using var context = DbFactory.CreateDbContext();
            
            var utcTimes = selectedDates.Select(d => TimeHelpers.GetUtcFromNorwayTime(d)).ToList();
            var existingShifts = await context.CoverageShifts
                .Where(s => utcTimes.Contains(s.StartTimeUtc) && s.AdminUserName == currentUserName)
                .ToDictionaryAsync(s => s.StartTimeUtc);
            
            foreach (var date in selectedDates)
            {
                var utcTime = TimeHelpers.GetUtcFromNorwayTime(date);
                if (existingShifts.TryGetValue(utcTime, out var existing))
                {
                    existing.Note = modalNote.Trim();
                    existing.IsPartlyAvailable = modalIsPartlyAvailable;
                }
                else
                {
                    var newShift = new CoverageShift
                    {
                        StartTimeUtc = utcTime,
                        AdminUserName = currentUserName,
                        Note = modalNote.Trim(),
                        IsPartlyAvailable = modalIsPartlyAvailable,
                        CreatedAt = DateTime.UtcNow
                    };
                    context.CoverageShifts.Add(newShift);
                }
            }

            await context.SaveChangesAsync();
            successMessage = $"Successfully saved {selectedDates.Count} shift(s).";
            showModal = false;
            await LoadShifts();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving shift(s): {ex.Message}";
            showModal = false;
            selectedDates.Clear();
        }
    }

    private async Task RemoveShift()
    {
        if (selectedDates.Count == 0) return;
        
        try
        {
            using var context = DbFactory.CreateDbContext();
            
            var utcTimes = selectedDates.Select(d => TimeHelpers.GetUtcFromNorwayTime(d)).ToList();
            var existingShifts = await context.CoverageShifts
                .Where(s => utcTimes.Contains(s.StartTimeUtc) && s.AdminUserName == currentUserName)
                .ToListAsync();

            if (existingShifts.Any())
            {
                context.CoverageShifts.RemoveRange(existingShifts);
                await context.SaveChangesAsync();
                successMessage = $"Successfully removed {existingShifts.Count} shift(s).";
            }
            
            showModal = false;
            await LoadShifts();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error removing shift(s): {ex.Message}";
            showModal = false;
            selectedDates.Clear();
        }
    }

    private async Task NextWeek() { weekOffset++; CalculateWeek(); await LoadShifts(); }
    private async Task PrevWeek() { weekOffset--; CalculateWeek(); await LoadShifts(); }
    private async Task ThisWeek() { weekOffset = 0; CalculateWeek(); await LoadShifts(); }
}
