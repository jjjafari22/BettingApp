@page "/admin/transactions"
<PageTitle>Transactions - Castle of Happiness</PageTitle>
@using Microsoft.AspNetCore.Authorization
@using BettingApp.Data
@using BettingApp.Services
@using Microsoft.EntityFrameworkCore
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject UiNotificationService UiNotifier
@inject IJSRuntime JSRuntime
@inject DiscordNotificationService DiscordService
@inject BettingApp.Services.DialogService DialogService
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<h3>Manage Transactions</h3>

@if (isInitializing)
{
    <LoadingData Text="Loading Transactions..." />
}
else if (!isAdmin)
{
    <div class="alert alert-danger">You are not authorized to view this page.</div>
}
else
{

@if (successMessage != null)
{
    <div class="alert alert-success alert-dismissible fade show position-fixed top-0 start-50 translate-middle-x mt-4 shadow" role="alert" style="z-index: 9999; min-width: 300px;">
        <i class="bi bi-bell-fill me-2"></i> @successMessage
        <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
    </div>
}

@if (errorMessage != null)
{
    <div class="alert alert-danger alert-dismissible fade show position-fixed top-0 start-50 translate-middle-x mt-4 shadow" role="alert" style="z-index: 9999; min-width: 300px;">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @errorMessage
        <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
    </div>
}

<ul class="nav nav-tabs mb-4">
    <li class="nav-item">
        <a class="nav-link @(activeTab == "pending" ? "active" : "")" style="cursor: pointer; user-select: none; -webkit-user-select: none;" @onclick='() => activeTab = "pending"'>
            <i class="bi bi-list-check me-2"></i> Transactions Overview
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(activeTab == "cashcows" ? "active" : "")" style="cursor: pointer; user-select: none; -webkit-user-select: none;" @onclick='() => activeTab = "cashcows"'>
            <i class="bi bi-wallet2 me-2"></i> Cash Cows
        </a>
    </li>
</ul>

@if (activeTab == "pending")
{
<div class="card border-warning mb-4">
    <div class="card-header bg-warning text-dark">
        <strong>Pending Withdraw Requests</strong>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Date (Local)</th>
                        <th>Date (Norway)</th>
                        <th>Discord Username</th>
                        <th>Full Name</th>
                        <th>Payment Method</th>
                        <th>Requested Amount</th>
                        <th>Current Balance</th>
                        <th>Remaining to Pay</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (pendingWithdrawals.Count == 0)
                    {
                        <tr><td colspan="9" class="text-center text-muted p-3">No pending withdrawals.</td></tr>
                    }
                    @foreach (var w in pendingWithdrawals)
                    {
                        <tr>
                            <td>@ToUserLocal(w.Date).ToString("g")</td>
                            <td>@TimeHelpers.GetNorwayTime(w.Date).ToString("g")</td>
                            <td>@(userLookup.TryGetValue(w.UserId, out var u) && !string.IsNullOrEmpty(u.DiscordName) ? u.DiscordName : w.UserName)</td>
                            <td>@(userLookup.TryGetValue(w.UserId, out var u2) ? $"{u2.FirstName} {u2.LastName}".Trim() : "")</td>
                            <td>
                                @w.Platform
                                @if (editingTransactionId == w.Id)
                                {
                                    <div class="mt-1 d-flex flex-column gap-1">
                                        <input type="text" class="form-control form-control-sm" placeholder="Vipps" @bind="editPendingVippsBound" @bind:event="oninput" />
                                        <input type="text" class="form-control form-control-sm" placeholder="Revolut" @bind="editPendingRevolutBound" @bind:event="oninput" />
                                        <input type="text" class="form-control form-control-sm" placeholder="Bank" @bind="editPendingBankBound" @bind:event="oninput" />
                                        <div class="input-group input-group-sm">
                                            <input type="text" class="form-control" placeholder="Platform" @bind="editPendingOtherPlatform" />
                                            <input type="text" class="form-control" placeholder="Details" @bind="editPendingOtherDetails" />
                                        </div>
                                    </div>
                                }
                                else if(!string.IsNullOrEmpty(w.PaymentDetails)) {
                                    foreach (var detail in w.PaymentDetails.Split('|', StringSplitOptions.RemoveEmptyEntries))
                                    {
                                        <div class="text-muted small">@detail.Trim()</div>
                                    }
                                }
                            </td>
                            <td>
                                @if (editingTransactionId == w.Id)
                                {
                                    <div class="input-group input-group-sm" style="max-width: 120px;">
                                        <input type="number" class="form-control" @bind="editingTransactionAmount" />
                                        <span class="input-group-text">kr</span>
                                    </div>
                                }
                                else
                                {
                                    <strong>@w.AmountNOK.ToString("N0") kr</strong>
                                }
                            </td>
                            <td>
                                @if (currentBalances.TryGetValue(w.UserId, out var bal))
                                {
                                    <span class="@(bal >= 0 ? "text-success" : "text-danger") fw-bold text-nowrap">@bal.ToString("N0") kr</span>
                                }
                                else
                                {
                                    <span class="text-muted">N/A</span>
                                }
                            </td>
                            <td>
                                @if(w.FulfilledAmount > 0)
                                {
                                    <strong>@((w.AmountNOK - w.FulfilledAmount).ToString("N0")) kr</strong>
                                    <div class="text-success small mt-1">Paid: @w.FulfilledAmount.ToString("N0") kr</div>
                                }
                                else
                                {
                                    <strong>@w.AmountNOK.ToString("N0") kr</strong>
                                }
                            </td>
                            <td>
                                @if (editingTransactionId == w.Id)
                                {
                                    <div class="d-flex flex-nowrap gap-1">
                                        <button class="btn btn-primary btn-sm" @onclick="() => SaveTransactionEdit(w)">Save</button>
                                        <button class="btn btn-secondary btn-sm" @onclick="CancelTransactionEdit">Cancel</button>
                                    </div>
                                }
                                else
                                {
                                    <div class="d-flex flex-nowrap gap-1">
                                        <button class="btn btn-success btn-sm" @onclick="() => ConfirmWithdraw(w)" disabled="@((w.AmountNOK - w.FulfilledAmount) > 0)">Clear</button>
                                        <button class="btn btn-warning btn-sm" @onclick="() => StartEditTransaction(w)">Edit</button>
                                        <button class="btn btn-danger btn-sm" @onclick="() => RejectWithdraw(w)">Reject</button>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12 mb-4">
        <div class="card position-relative">
             @if (isSavingTransaction)
             {
                 <div class="position-absolute top-0 start-0 w-100 h-100 d-flex flex-column align-items-center justify-content-center" style="background-color: rgba(255,255,255,0.75); backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px); z-index: 1000; border-radius: var(--bs-card-border-radius, .25rem);">
                     <div class="spinner-border text-primary mb-3" style="width: 3.5rem; height: 3.5rem; border-width: 0.3em;" role="status">
                         <span class="visually-hidden">Loading...</span>
                     </div>
                     <h4 class="fw-bolder text-dark mb-1" style="text-shadow: 0 0 10px rgba(255,255,255,0.9);">Saving...</h4>
                     <p class="text-dark fw-bold mb-0">Please wait</p>
                 </div>
             }
             <div class="card-header bg-primary text-white">Add Transaction</div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-12 mb-3">
                        <label class="fw-bold mb-2">Transaction Type</label>
                        <div class="btn-group w-100" role="group">
                            <input type="radio" class="btn-check" name="typeRadio" id="typeTransaction" autocomplete="off" 
                                   checked="@(newTrans.Type == "Deposit")" @onclick='() => { newTrans.Type = "Deposit"; ClearForm(); }'>
                            <label class="btn btn-outline-primary" for="typeTransaction">
                                <i class="bi bi-currency-exchange me-1"></i> Transaction
                            </label>

                            <input type="radio" class="btn-check" name="typeRadio" id="typeFreeBet" autocomplete="off" 
                                   checked="@(newTrans.Type == "Free Bet")" @onclick='() => { newTrans.Type = "Free Bet"; ClearForm(); }'>
                            <label class="btn btn-outline-info" for="typeFreeBet">
                                <i class="bi bi-gift me-1"></i> Free Bet
                            </label>
                        </div>
                    </div>
                    @if (newTrans.Type != "Free Bet")
                    {
                    <!-- SENDER -->
                    <div class="col-md-5 mb-3 border rounded p-3 bg-light">
                        <h6 class="fw-bold text-success"><i class="bi bi-arrow-up-right-circle me-1"></i> Sender (Who paid the money?)</h6>
                        <div class="btn-group w-100 mb-2" role="group">
                            <input type="radio" class="btn-check" name="senderType" id="senderUser" autocomplete="off" 
                                   checked="@(addTransSenderType == "User")" @onclick='() => { addTransSenderType = "User"; addTransSenderId = ""; selectedSenderUser = null; senderSearchTerm = ""; }'>
                            <label class="btn btn-outline-secondary btn-sm" for="senderUser">User</label>
                            
                            <input type="radio" class="btn-check" name="senderType" id="senderCC" autocomplete="off" 
                                   checked="@(addTransSenderType == "CashCow")" @onclick='() => { addTransSenderType = "CashCow"; addTransSenderId = ""; selectedSenderUser = null; senderSearchTerm = ""; }'>
                            <label class="btn btn-outline-secondary btn-sm" for="senderCC">Cash Cow</label>
                        </div>
                        
                        @if (addTransSenderType == "CashCow")
                        {
                            <select class="form-select" @bind="addTransSenderId">
                                <option value="">-- Select Cash Cow (Scroll for more) --</option>
                                @foreach (var cow in cashCows) { <option value="@cow.Id">@cow.FirstName @cow.LastName</option> }
                            </select>
                            @if (!string.IsNullOrEmpty(addTransSenderId)) {
                                var cc = cashCows.FirstOrDefault(c => c.Id == addTransSenderId);
                                if (cc != null) {
                                    <div class="mt-2 p-2 bg-white border rounded small shadow-sm d-flex justify-content-between">
                                        <span class="text-muted">CC Balance:</span><span class="fw-bold @(cc.Balance >= 0 ? "text-success" : "text-danger")">@cc.Balance.ToString("N0") kr</span>
                                    </div>
                                }
                            }
                        }
                        else if (addTransSenderType == "User")
                        {
                            <div class="position-relative">
                                <input type="text" class="form-control" placeholder="Search Discord User..." @bind="senderSearchTerm" @bind:event="oninput" @bind:after="SearchSender" />
                                @if (senderSearchResults.Any())
                                {
                                    <ul class="list-group position-absolute w-100 shadow" style="z-index: 1000; max-height: 200px; overflow-y: auto;">
                                        @foreach (var u in senderSearchResults)
                                        {
                                            <li class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" style="cursor: pointer;" @onclick='() => { addTransSenderId = u.Id; senderSearchTerm = u.DiscordUsername ?? u.UserName ?? ""; selectedSenderUser = u; senderSearchResults.Clear(); }'>
                                                <div><strong>@u.DiscordUsername</strong> <small>(@u.FirstName @u.LastName)</small></div>
                                                <span class="badge @(u.Balance >= 0 ? "bg-success" : "bg-danger") rounded-pill">@u.Balance.ToString("N0") kr</span>
                                            </li>
                                        }
                                    </ul>
                                }
                            </div>
                            @if (selectedSenderUser != null) {
                                <div class="mt-2 p-2 bg-white border rounded small shadow-sm">
                                    <div class="d-flex justify-content-between text-muted"><span>User Balance:</span><span class="fw-bold @(selectedSenderUser.Balance >= 0 ? "text-success" : "text-danger")">@selectedSenderUser.Balance.ToString("N0") kr</span></div>
                                    <div class="text-success"><small>Selected: <strong>@selectedSenderUser.DiscordUsername</strong> (@selectedSenderUser.FirstName @selectedSenderUser.LastName)</small></div>
                                </div>
                            }
                        }
                    </div>

                    }
                    <!-- RECEIVER -->
                    <div class="col-md-5 mb-3 border rounded p-3 bg-light @(newTrans.Type != "Free Bet" ? "ms-md-3" : "")">
                        <h6 class="fw-bold text-primary"><i class="bi bi-arrow-down-right-circle me-1"></i> Receiver (Who got the money?)</h6>
                        <div class="btn-group w-100 mb-2" role="group">
                            <input type="radio" class="btn-check" name="receiverType" id="receiverUser" autocomplete="off" 
                                   checked="@(addTransReceiverType == "User")" @onclick='() => { addTransReceiverType = "User"; addTransReceiverId = ""; selectedReceiverUser = null; receiverSearchTerm = ""; AutoFillPaymentDetails(); }'>
                            <label class="btn btn-outline-secondary btn-sm" for="receiverUser">User</label>
                            
                            @if (newTrans.Type != "Free Bet") {
                                <input type="radio" class="btn-check" name="receiverType" id="receiverCC" autocomplete="off" 
                                       checked="@(addTransReceiverType == "CashCow")" @onclick='() => { addTransReceiverType = "CashCow"; addTransReceiverId = ""; selectedReceiverUser = null; receiverSearchTerm = ""; AutoFillPaymentDetails(); }'>
                                <label class="btn btn-outline-secondary btn-sm" for="receiverCC">Cash Cow</label>
                            }
                        </div>
                        
                        @if (addTransReceiverType == "CashCow")
                        {
                            <select class="form-select" @bind="addTransReceiverId" @bind:after="AutoFillPaymentDetails">
                                <option value="">-- Select Cash Cow (Scroll for more) --</option>
                                @foreach (var cow in cashCows) { <option value="@cow.Id">@cow.FirstName @cow.LastName</option> }
                            </select>
                            @if (!string.IsNullOrEmpty(addTransReceiverId)) {
                                var cc = cashCows.FirstOrDefault(c => c.Id == addTransReceiverId);
                                if (cc != null) {
                                    <div class="mt-2 p-2 bg-white border rounded small shadow-sm d-flex justify-content-between">
                                        <span class="text-muted">CC Balance:</span><span class="fw-bold @(cc.Balance >= 0 ? "text-success" : "text-danger")">@cc.Balance.ToString("N0") kr</span>
                                    </div>
                                }
                            }
                        }
                        else if (addTransReceiverType == "User")
                        {
                            <div class="position-relative">
                                <input type="text" class="form-control" placeholder="Search Discord User..." @bind="receiverSearchTerm" @bind:event="oninput" @bind:after="SearchReceiver" />
                                @if (receiverSearchResults.Any())
                                {
                                    <ul class="list-group position-absolute w-100 shadow" style="z-index: 1000; max-height: 200px; overflow-y: auto;">
                                        @foreach (var u in receiverSearchResults)
                                        {
                                            <li class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" style="cursor: pointer;" @onclick='() => { addTransReceiverId = u.Id; receiverSearchTerm = u.DiscordUsername ?? u.UserName ?? ""; selectedReceiverUser = u; receiverSearchResults.Clear(); AutoFillPaymentDetails(); }'>
                                                <div><strong>@u.DiscordUsername</strong> <small>(@u.FirstName @u.LastName)</small></div>
                                                <span class="badge @(u.Balance >= 0 ? "bg-success" : "bg-danger") rounded-pill">@u.Balance.ToString("N0") kr</span>
                                            </li>
                                        }
                                    </ul>
                                }
                            </div>
                                @if (selectedReceiverUser != null) {
                                    <div class="mt-2 p-2 bg-white border rounded small shadow-sm">
                                        <div class="d-flex justify-content-between text-muted"><span>User Balance:</span><span class="fw-bold @(selectedReceiverUser.Balance >= 0 ? "text-success" : "text-danger")">@selectedReceiverUser.Balance.ToString("N0") kr</span></div>
                                        <div class="text-success"><small>Selected: <strong>@selectedReceiverUser.DiscordUsername</strong> (@selectedReceiverUser.FirstName @selectedReceiverUser.LastName)</small></div>
                                    </div>
                                }
                            }
                        </div>

                    <div class="col-md-3 mb-3">
                        <label class="fw-bold">Amount (NOK)</label>
                        <input type="number" class="form-control" @bind="adminAddAmount" @bind:event="oninput" />
                    </div>
                    
                    @if (newTrans.Type == "Free Bet")
                    {
                         <div class="col-md-9 mb-3">
                            <label class="fw-bold">Reason / Promo Details (Customer-Visible)</label>
                            @if (addTransReceiverType == "CashCow") {
                                    <div class="p-2 border rounded bg-light fw-bold text-primary font-monospace shadow-sm">
                                        <i class="bi bi-wallet2 me-2"></i>@(string.IsNullOrEmpty(newTrans.PaymentDetails) ? "No details provided" : newTrans.PaymentDetails)
                                    </div>
                                } else {
                                    <input type="text" class="form-control" placeholder="e.g. Promotional, Welcome Bonus..." @bind="newTrans.PaymentDetails" />
                                }
                        </div>
                    }
                    else
                    {
                        <div class="col-md-6 mb-3">
                            <label class="fw-bold">Payment Method</label>
                            <select class="form-select" value="@newTrans.Platform" @onchange="OnPlatformChanged">
                                <option value="Vipps">Vipps</option>
                                <option value="Revolut">Revolut</option>
                                <option value="Bank Transfer">Bank Transfer</option>
                                <option value="Other">Other Payment</option>
                            </select>
                        </div>
                        
                        @if (newTrans.Platform == "Other")
                        {
                            <div class="col-md-5 mb-3">
                                <label class="fw-bold">Platform Name (e.g. PayPal)</label>
                                @if (addTransReceiverType == "CashCow" || isPaymentDetailsAutoFilled) {
                                    <div class="p-2 border rounded bg-light fw-bold text-primary shadow-sm">
                                        @(string.IsNullOrEmpty(otherPlatformName) ? "None" : otherPlatformName)
                                    </div>
                                } else {
                                    <input type="text" class="form-control" @bind="otherPlatformName" />
                                }
                            </div>
                            <div class="col-md-7 mb-3">
                                <label class="fw-bold">Payment Details</label>
                                @if (addTransReceiverType == "CashCow" || isPaymentDetailsAutoFilled) {
                                    <div class="p-2 border rounded bg-light fw-bold text-primary font-monospace shadow-sm">
                                        <i class="bi bi-wallet2 me-2"></i>@(string.IsNullOrEmpty(newTrans.PaymentDetails) ? "No details provided" : newTrans.PaymentDetails)
                                    </div>
                                } else {
                                    <input type="text" class="form-control" @bind="newTransPaymentDetailsBound" @bind:event="oninput" />
                                }
                            </div>
                        }
                        else
                        {
                            <div class="col-md-12 mb-3">
                                <label class="fw-bold">
                                    @if (newTrans.Platform == "Vipps") { <text>Phone Number</text> }
                                    else if (newTrans.Platform == "Revolut") { <text>Revtag/Username</text> }
                                    else { <text>Bank Account Number</text> }
                                </label>
                                @if (addTransReceiverType == "CashCow" || isPaymentDetailsAutoFilled) {
                                    <div class="p-2 border rounded bg-light fw-bold text-primary font-monospace shadow-sm">
                                        <i class="bi bi-wallet2 me-2"></i>@(string.IsNullOrEmpty(newTrans.PaymentDetails) ? "No details provided" : newTrans.PaymentDetails)
                                    </div>
                                } else {
                                    <input type="text" class="form-control" @bind="newTransPaymentDetailsBound" @bind:event="oninput" />
                                }
                            </div>
                        }
                    }

                    <div class="col-md-12 mb-3">
                        <label class="fw-bold">Note <span class="text-muted fw-normal small">(Optional - Internal Admin Note, Never visible to Users)</span></label>
                        <input type="text" class="form-control" @bind="newTrans.Note" />
                    </div>

                    <div class="col-md-12">
                        <button class="btn btn-primary w-100 fw-bold" @onclick="AddTransaction" disabled="@(!adminAddAmount.HasValue || adminAddAmount.Value <= 0 || (newTrans.Type != "Free Bet" && newTrans.Platform == "Other" && string.IsNullOrEmpty(otherPlatformName)))">Execute Transaction</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-3">
    <h4 class="mb-0">Transaction History (@totalTransactions)</h4>
    
    <div class="d-flex gap-2 flex-wrap align-items-start">
        <select class="form-select form-select-sm" style="width: auto;" @onchange="OnTypeFilterChanged">
            <option value="">All Types</option>
            <option value="Deposit">Deposits</option>
            <option value="Withdrawal">Withdrawals</option>
            <option value="Free Bet">Free Bets</option>
        </select>
        
        <select class="form-select form-select-sm" style="width: auto;" @onchange="OnStatusFilterChanged">
            <option value="">All Statuses</option>
            <option value="Completed">Completed</option>
            <option value="Rejected">Rejected</option>
            <option value="Cancelled">Cancelled</option>
        </select>

        <div class="position-relative" style="min-width: 250px;">
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control" 
                       placeholder="Filter by user..." 
                       @bind="filterSearchTerm" 
                       @bind:event="oninput" 
                       @bind:after="PerformFilterSearch" />
                @if (filterSelectedUser != null)
                {
                    <button class="btn btn-outline-secondary" type="button" @onclick="ClearFilterSelection">
                        <i class="bi bi-x"></i>
                    </button>
                }
            </div>
            
            @if (filterSearchResults.Any())
            {
                <ul class="list-group position-absolute w-100 shadow" style="z-index: 1050; max-height: 200px; overflow-y: auto;">
                    @foreach (var user in filterSearchResults)
                    {
                        <li class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-2" 
                            style="cursor: pointer;" 
                            @onclick="() => SelectFilterUser(user)">
                            <div>
                                <strong>@user.DiscordUsername</strong>
                                <small class="text-muted d-block">@user.FirstName @user.LastName</small>
                            </div>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th class="text-nowrap">Last Updated</th>
                <th>ID</th>
                <th>Sender</th>
                <th>Receiver</th>
                <th>Type</th>
                <th>Payment Method</th>
                <th>Amount</th>
                <th>Status</th>
                <th>Note</th>
            </tr>
        </thead>
         <tbody>
            @foreach (var t in allTransactions)
            {
                <tr>
                    <td class="text-nowrap">@ToUserLocal(t.UpdatedAt).ToString("g")</td>
                    <td><span class="text-muted small">#@t.Id</span></td>
                    <td>
                        @if (!string.IsNullOrEmpty(t.SenderId) && userLookup.TryGetValue(t.SenderId, out var su)) {
                            <strong>@su.DiscordName</strong> <small class="text-muted">(@su.FirstName @su.LastName)</small>
                        } else {
                            <strong>@t.SenderName</strong>
                        }
                        @if (t.SenderType == "CashCow") { <span class="badge bg-secondary ms-1">CC</span> }
                    </td>
                    <td>
                        @if (!string.IsNullOrEmpty(t.ReceiverId) && userLookup.TryGetValue(t.ReceiverId, out var ru)) {
                            <strong>@ru.DiscordName</strong> <small class="text-muted">(@ru.FirstName @ru.LastName)</small>
                        } else {
                            <strong>@t.ReceiverName</strong>
                        }
                        @if (t.ReceiverType == "CashCow") { <span class="badge bg-secondary ms-1">CC</span> }
                    </td>
                    <td>
                         @if (t.Type == "Deposit")
                        {
                            <span class="badge bg-success">Deposit</span>
                        }
                        else if (t.Type == "Free Bet")
                        {
                            <span class="badge bg-info text-dark">Free Bet</span>
                        }

                        else if (t.Type == "Transfer")
                        {
                            <span class="badge bg-primary text-light"><i class="bi bi-arrow-left-right me-1"></i> Transfer</span>
                        }
                         else
                        {
                            <span class="badge bg-warning text-dark">@((t.Type == "Withdrawal" ? "Withdraw" : t.Type))</span>
                        }
                    </td>
                    <td>
                        @t.Platform
                        @if(!string.IsNullOrEmpty(t.PaymentDetails)) {
                            foreach (var detail in t.PaymentDetails.Split('|', StringSplitOptions.RemoveEmptyEntries))
                            {
                                <div class="text-muted small">@detail.Trim()</div>
                            }
                        }
                    </td>
                    <td>@t.AmountNOK.ToString("N0") kr</td>
                     <td>
                        @if (t.Status == "Completed")
                        {
                            <span class="badge bg-success">@t.Status</span>
                        }
                        else if (t.Status == "Pending")
                        {
                            <span class="badge bg-warning text-dark">@t.Status</span>
                        }
                        else if (t.Status == "Rejected" || t.Status == "Cancelled")
                        {
                            <span class="badge bg-danger">@t.Status</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@t.Status</span>
                        }
                    </td>
                    <td class="text-muted small" style="max-width: 200px; word-break: break-word;">
                        @(string.IsNullOrWhiteSpace(t.Note) ? "-" : t.Note)
                    </td>
                </tr>
            }
            @if (allTransactions.Count == 0)
            {
                <tr><td colspan="9" class="text-muted text-center py-3">No transactions found for this period/user.</td></tr>
            }
        </tbody>
    </table>
    
    <div class="d-flex justify-content-between align-items-center mt-2 mb-4">
        <button class="btn btn-sm @(currentPage <= 1 ? "btn-outline-secondary" : "btn-primary shadow-sm")" @onclick="PrevPage" disabled="@(currentPage <= 1)">
            <i class="bi bi-arrow-left"></i> Previous
        </button>
        <span class="text-muted fw-bold">Page @currentPage</span>
        <button class="btn btn-sm @(!hasMoreTransactions ? "btn-outline-secondary" : "btn-primary shadow-sm fw-bold")" @onclick="NextPage" disabled="@(!hasMoreTransactions)">
             Next <i class="bi bi-arrow-right"></i>
        </button>
    </div>
</div>

}

@if (activeTab == "cashcows")
{
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    @(editingCowId == null ? "Add New Cash Cow" : "Edit Cash Cow")
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label fw-bold">First Name</label>
                            <input type="text" class="form-control" @bind="newCow.FirstName" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold">Last Name</label>
                            <input type="text" class="form-control" @bind="newCow.LastName" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold">Vipps (Phone)</label>
                            <input type="text" class="form-control" @bind="newCowVippsBound" @bind:event="oninput" placeholder="8-digit Norwegian Phone Number" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold">Revolut (Revtag)</label>
                            <input type="text" class="form-control" @bind="newCowRevolutBound" @bind:event="oninput" placeholder="Revolut Tag / Username" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold">Bank Transfer</label>
                            <input type="text" class="form-control" @bind="newCowBankTransferBound" @bind:event="oninput" placeholder="Account Number" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold">Other Platform</label>
                            <input type="text" class="form-control" placeholder="e.g. PayPal" @bind="newCow.OtherPlatformName" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold">Other Details</label>
                            <input type="text" class="form-control" placeholder="Email/Tag" @bind="newCow.OtherPaymentDetails" />
                        </div>
                        <div class="col-md-3 d-flex align-items-end justify-content-end gap-2">
                            @if (editingCowId != null)
                            {
                                <button class="btn btn-secondary w-100" @onclick="() => { editingCowId = null; newCow = new(); }">Cancel</button>
                            }
                            <button class="btn btn-primary w-100 fw-bold" @onclick="SaveCashCow">@(editingCowId == null ? "Add" : "Save Changes")</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
        
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center flex-wrap">
                    <div class="d-flex align-items-center flex-wrap gap-3 mb-2 mb-md-0">
                        <div class="btn-group" role="group">
                            <button type="button" class="btn btn-sm btn-@(viewMode == ViewMode.AllTime ? "light" : "outline-light")" @onclick="() => SetViewMode(ViewMode.AllTime)">All Time</button>
                            <button type="button" class="btn btn-sm btn-@(viewMode == ViewMode.Daily ? "light" : "outline-light")" @onclick="() => SetViewMode(ViewMode.Daily)">Daily</button>
                            <button type="button" class="btn btn-sm btn-@(viewMode == ViewMode.Weekly ? "light" : "outline-light")" @onclick="() => SetViewMode(ViewMode.Weekly)">Weekly</button>
                            <button type="button" class="btn btn-sm btn-@(viewMode == ViewMode.Monthly ? "light" : "outline-light")" @onclick="() => SetViewMode(ViewMode.Monthly)">Monthly</button>
                            <button type="button" class="btn btn-sm btn-@(viewMode == ViewMode.Yearly ? "light" : "outline-light")" @onclick="() => SetViewMode(ViewMode.Yearly)">Yearly</button>
                            <button type="button" class="btn btn-sm btn-@(viewMode == ViewMode.Custom ? "light" : "outline-light")" @onclick="() => SetViewMode(ViewMode.Custom)">Custom</button>
                        </div>
                        
                        <div class="form-check form-switch d-flex align-items-center gap-2 mb-0" style="margin-top: 2px;">
                            <input class="form-check-input mt-0" type="checkbox" role="switch" id="showInternalToggle" @bind="showInternalAccounts">
                            <label class="form-check-label small text-white" for="showInternalToggle">Show Internal (Misc)</label>
                        </div>
                    </div>
                    
                    <div class="d-flex align-items-center flex-wrap gap-2 mt-2 mt-md-0">
                        @if (viewMode == ViewMode.Custom)
                        {
                            <div class="d-flex align-items-center bg-secondary bg-opacity-25 rounded p-1 shadow-sm">
                                <input type="date" class="form-control form-control-sm border-0 text-white bg-transparent" @bind="ccStartDate" @bind:after="OnCustomDateChanged" title="From Date" />
                                <span class="mx-2 text-white fw-bold">-</span>
                                <input type="date" class="form-control form-control-sm border-0 text-white bg-transparent" @bind="ccEndDate" @bind:after="OnCustomDateChanged" title="To Date" />
                            </div>
                        }
                        else if (viewMode != ViewMode.AllTime)
                        {
                            <button class="btn btn-outline-light btn-sm" @onclick="PreviousPeriod"><i class="bi bi-chevron-left"></i></button>
                            <span class="fw-bold mx-2" style="min-width: 120px; text-align: center;">@GetPeriodDisplayString()</span>
                            <button class="btn btn-outline-light btn-sm" @onclick="NextPeriod"><i class="bi bi-chevron-right"></i></button>
                        }
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th style="cursor: pointer; user-select: none;" @onclick='() => SortCashCows("LastUpdated")'>
                                        Last Updated @GetSortIcon("LastUpdated")
                                    </th>
                                    <th>Name</th>
                                    <th>Contact / Details</th>
                                    <th style="cursor: pointer; user-select: none;" @onclick='() => SortCashCows("LifetimeBalance")'>
                                        Lifetime Balance @GetSortIcon("LifetimeBalance")
                                    </th>
                                    <th style="cursor: pointer; user-select: none;" @onclick='() => SortCashCows("PeriodNet")'>
                                        Period Net @GetSortIcon("PeriodNet")
                                    </th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!cashCows.Any())
                                {
                                    <tr><td colspan="5" class="text-center text-muted p-3">No Cash Cows configured.</td></tr>
                                }
                                @foreach (var cow in GetSortedCashCows())
                                {
                                    <tr>
                                        <td>
                                            @{
                                                var lastUpd = ccLastUpdated.TryGetValue(cow.Id, out var dt) ? dt : null;
                                                if (lastUpd.HasValue) {
                                                    <span class="text-muted small">@ToUserLocal(lastUpd.Value).ToString("g")</span>
                                                } else {
                                                    <span class="text-muted small fst-italic">No transactions</span>
                                                }
                                            }
                                        </td>
                                        <td><strong>@cow.FirstName @cow.LastName</strong></td>
                                        <td>
                                            @if(!string.IsNullOrEmpty(cow.Vipps)) { <span class="badge bg-primary">Vipps: @cow.Vipps</span> }
                                            @if(!string.IsNullOrEmpty(cow.Revolut)) { <span class="badge bg-dark">Rev: @cow.Revolut</span> }
                                            @if(!string.IsNullOrEmpty(cow.BankTransfer)) { <span class="badge bg-secondary">Bank: @cow.BankTransfer</span> }
                                            @if(!string.IsNullOrEmpty(cow.OtherPlatformName)) { <span class="badge bg-info text-dark">@cow.OtherPlatformName: @cow.OtherPaymentDetails</span> }
                                        </td>
                                        <td><strong class="@(cow.Balance >= 0 ? "text-success" : "text-danger")">@cow.Balance.ToString("N0") kr</strong></td>
                                        @{
                                            var pNet = GetCashCowPeriodNet(cow);
                                        }
                                        <td><strong class="@(pNet >= 0 ? "text-success" : "text-danger")">@pNet.ToString("N0") kr</strong></td>
                                        <td class="text-end">
                                            <button class="btn btn-sm btn-outline-info me-2" @onclick="() => OpenCowLedger(cow)">Ledger</button>
                                            <button class="btn btn-sm btn-outline-primary" @onclick="() => EditCashCow(cow)">Edit</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-light fw-bold" style="border-top: 2px solid #343a40;">
                                <tr>
                                    <td colspan="3" class="text-end pe-4">TOTAL:</td>
                                    @{
                                        var allCows = GetSortedCashCows().ToList();
                                        var totalLifetime = allCows.Sum(c => c.Balance);
                                        var totalPeriod = allCows.Sum(c => GetCashCowPeriodNet(c));
                                    }
                                    <td class="@(totalLifetime >= 0 ? "text-success" : "text-danger") fs-6">@totalLifetime.ToString("N0") kr</td>
                                    <td class="@(totalPeriod >= 0 ? "text-success" : "text-danger") fs-6">@totalPeriod.ToString("N0") kr</td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>

            @if (viewingCow != null)
            {
                <div class="card shadow-sm border-0 mt-4 border-info">
                    <div class="card-header bg-info text-dark d-flex justify-content-between align-items-center">
                        <strong>Ledger: @viewingCow.FirstName @viewingCow.LastName</strong>
                        <button class="btn-close" @onclick="() => viewingCow = null"></button>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover table-sm mb-0">
                                <thead class="table-light position-sticky top-0">
                                    <tr>
                                        <th>Date</th>
                                        <th>Type</th>
                                        <th>Platform</th>
                                        <th>Amount</th>
                                        <th>Direction</th>
                                        <th>Note</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!viewingCowTransactions.Any())
                                    {
                                        <tr><td colspan="6" class="text-center text-muted p-3">No transactions found.</td></tr>
                                    }
                                    @foreach (var t in viewingCowTransactions)
                                    {
                                        var isIncoming = t.ReceiverId == viewingCow.Id;
                                        <tr>
                                            <td>@ToUserLocal(t.UpdatedAt).ToString("g")</td>
                                            <td><span class="badge bg-secondary">@t.Type</span></td>
                                            <td><small class="text-muted">@t.Platform</small></td>
                                            <td class="@(isIncoming ? "text-success fw-bold" : "text-danger fw-bold")">
                                                @(isIncoming ? "+" : "-")@t.AmountNOK kr
                                            </td>
                                            <td>
                                                @if (isIncoming) { 
                                                    string nameDisplay = t.SenderName ?? "";
                                                    if (userLookup.TryGetValue(t.SenderId ?? "", out var u))
                                                    {
                                                        nameDisplay = string.IsNullOrEmpty(u.DiscordName) ? $"{u.FirstName} {u.LastName}".Trim() : $"{u.DiscordName} ({u.FirstName} {u.LastName})".Trim();
                                                    }
                                                    <span class="text-success"><i class="bi bi-arrow-down-left"></i> From @nameDisplay</span> 
                                                }
                                                else { 
                                                    string nameDisplay = t.ReceiverName ?? "";
                                                    if (userLookup.TryGetValue(t.ReceiverId ?? "", out var u))
                                                    {
                                                        nameDisplay = string.IsNullOrEmpty(u.DiscordName) ? $"{u.FirstName} {u.LastName}".Trim() : $"{u.DiscordName} ({u.FirstName} {u.LastName})".Trim();
                                                    }
                                                    <span class="text-danger"><i class="bi bi-arrow-up-right"></i> To @nameDisplay</span> 
                                                }
                                            </td>
                                            <td class="text-muted small">
                                                @(string.IsNullOrWhiteSpace(t.Note) ? "-" : t.Note)
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="card-footer bg-light d-flex justify-content-between align-items-center">
                        <span class="text-muted small">Page @viewingCowCurrentPage</span>
                        <div class="d-flex gap-2">
                            <button class="btn btn-sm @(viewingCowCurrentPage == 1 ? "btn-outline-secondary" : "btn-primary shadow-sm fw-bold")" @onclick="PrevCowPage" disabled="@(viewingCowCurrentPage == 1)">
                                <i class="bi bi-arrow-left"></i> Prev
                            </button>
                            <button class="btn btn-sm @(!viewingCowHasMore ? "btn-outline-secondary" : "btn-primary shadow-sm fw-bold")" @onclick="NextCowPage" disabled="@(!viewingCowHasMore)">
                                 Next <i class="bi bi-arrow-right"></i>
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}
}
