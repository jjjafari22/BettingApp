    private async Task SetupSignalR()
    {
        hubConnection = new HubConnectionBuilder().WithUrl(Nav.ToAbsoluteUri("/bethub")).Build();
        
        System.Timers.Timer? debounceTimer = null;
        
        Action triggerRefresh = () => 
        {
            if (debounceTimer == null)
            {
                debounceTimer = new System.Timers.Timer(1000);
                debounceTimer.AutoReset = false;
                debounceTimer.Elapsed += async (s, e) => 
                {
                    await InvokeAsync(async () =>
                    {
                        using var context = DbFactory.CreateDbContext();
                        await LoadTransactions(context);
                        StateHasChanged();
                    });
                };
            }
            debounceTimer.Stop();
            debounceTimer.Start();
        };

        hubConnection.On<string>("ReceiveUpdate", (message) => triggerRefresh());
        hubConnection.On<string>("ReceiveAdminNotification", (message) => triggerRefresh());
        await hubConnection.StartAsync();
        await hubConnection.InvokeAsync("JoinAdminGroup");
    }

    private async Task LoadTransactions(ApplicationDbContext context)
    {
        var query = context.Transactions.Where(t => t.Status != "Pending").AsQueryable();
        if (filterSelectedUser != null)
        {
            query = query.Where(t => t.UserId == filterSelectedUser.Id);
        }
        
        if (!string.IsNullOrEmpty(filterType))
        {
            query = query.Where(t => t.Type == filterType);
        }
        
        if (!string.IsNullOrEmpty(filterStatus))
        {
            query = query.Where(t => t.Status == filterStatus);
        }

        allTransactions = await query
            .OrderByDescending(t => t.UpdatedAt)
            .Skip((currentPage - 1) * PageSize)
            .Take(PageSize)
            .AsNoTracking()
            .ToListAsync();
        totalTransactions = await query.CountAsync();
        hasMoreTransactions = totalTransactions > (currentPage * PageSize);
        cashCows = await context.CashCows.ToListAsync();
        ccLastUpdated.Clear();
        foreach (var cow in cashCows) {
            var lastTx = await context.Transactions
                .Where(t => (t.SenderType == "CashCow" && t.SenderId == cow.Id) || (t.ReceiverType == "CashCow" && t.ReceiverId == cow.Id))
                .OrderByDescending(t => t.Date)
                .FirstOrDefaultAsync();
            ccLastUpdated[cow.Id] = lastTx?.Date;
        }
        pendingWithdrawals = await context.Transactions
            .Where(t => t.Type == "Withdrawal" && t.Status == "Pending")
            .OrderBy(t => t.Date)
            .AsNoTracking()
            .ToListAsync();
        var userIds = allTransactions.Select(t => t.UserId).Concat(pendingWithdrawals.Select(t => t.UserId)).Distinct();
        await PopulateUserLookup(userIds);
    }
    
