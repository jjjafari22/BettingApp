    }

    private int GetCashCowPeriodNet(CashCow cow)
    {
        return (ccStartDate.HasValue || ccEndDate.HasValue) 
            ? (ccPeriodNet.TryGetValue(cow.Id, out var n) ? n : 0) 
            : (int)cow.Balance;
    }

    private IEnumerable<CashCow> GetSortedCashCows()
    {
        var query = cashCows.AsEnumerable();
        if (ccSortColumn == "LifetimeBalance") {
            query = ccSortAscending ? query.OrderBy(c => c.Balance) : query.OrderByDescending(c => c.Balance);
        } else if (ccSortColumn == "PeriodNet") {
            query = ccSortAscending ? query.OrderBy(GetCashCowPeriodNet) : query.OrderByDescending(GetCashCowPeriodNet);
        } else {
            // LastUpdated (default)
            query = ccSortAscending 
                ? query.OrderBy(c => ccLastUpdated.TryGetValue(c.Id, out var d) ? (d ?? DateTime.MinValue) : DateTime.MinValue) 
                : query.OrderByDescending(c => ccLastUpdated.TryGetValue(c.Id, out var d) ? (d ?? DateTime.MinValue) : DateTime.MinValue);
        }
        return query;
    }

    private async Task ClearCashCowFilter()
    {
        ccStartDate = null;
        ccEndDate = null;
        ccPeriodNet.Clear();
        if (viewingCow != null)
        {
            viewingCowCurrentPage = 1;
            await LoadCowTransactions(viewingCow);
        }
    }

    private async Task UpdateCashCowPeriodNet()
    {
        if (ccStartDate == null && ccEndDate == null)
        {
            await ClearCashCowFilter();
            return;
        }

        using var context = DbFactory.CreateDbContext();
        var query = context.Transactions.Where(t => t.Status == "Completed");
        
        if (ccStartDate.HasValue)
        {
            var startUtc = DateTime.SpecifyKind(ccStartDate.Value.Date.AddMinutes(TimezoneOffset), DateTimeKind.Utc);
            query = query.Where(t => t.Date >= startUtc);
        }
        
        if (ccEndDate.HasValue)
        {
            var endUtc = DateTime.SpecifyKind(ccEndDate.Value.Date.AddDays(1).AddMinutes(TimezoneOffset).AddTicks(-1), DateTimeKind.Utc);
            query = query.Where(t => t.Date <= endUtc);
        }
        
        var txs = await query.ToListAsync();
        
        ccPeriodNet.Clear();
        foreach (var cow in cashCows)
        {
            var ccId = cow.Id;
            var sent = txs.Where(t => t.SenderType == "CashCow" && string.Equals(t.SenderId, ccId, StringComparison.OrdinalIgnoreCase)).Sum(t => t.AmountNOK);
            var received = txs.Where(t => t.ReceiverType == "CashCow" && string.Equals(t.ReceiverId, ccId, StringComparison.OrdinalIgnoreCase)).Sum(t => t.AmountNOK);
            ccPeriodNet[ccId] = received - sent;
        }

        if (viewingCow != null)
        {
            viewingCowCurrentPage = 1;
            await LoadCowTransactions(viewingCow);
        }
    }

    private async Task ConfirmWithdraw(Transaction t)
    {
        successMessage = null;
        errorMessage = null;
        var displayUser = userLookup.TryGetValue(t.UserId, out var u) && !string.IsNullOrEmpty(u.DiscordName) ? u.DiscordName : t.UserName;
        
        var msg = t.AmountNOK <= 0 
            ? $"This withdrawal has been fully fulfilled. Clear this {t.AmountNOK}kr request for {displayUser}?" 
            : $"Confirm payout of {t.AmountNOK} kr to {displayUser}?";
            
        var confirmed = await DialogService.ConfirmAsync(msg);
        if (!confirmed) return;

        using var context = DbFactory.CreateDbContext();
        
        var user = await context.Users.FindAsync(t.UserId);
        var dbTrans = await context.Transactions.FindAsync(t.Id);
        if (dbTrans != null)
        {
            if (dbTrans.AmountNOK <= 0)
            {
                context.Transactions.Remove(dbTrans);
                context.AuditLogs.Add(new AuditLog { AdminUserName = currentAdminName ?? "Unknown", Action = "Cleared Fulfilled Withdrawal", TargetUserName = t.UserName, Details = $"ID: {t.Id}" });
                await context.SaveChangesAsync();
                _ = ShowSuccess("Fulfilled withdrawal request cleared.");
            }
            else
            {
                dbTrans.Status = "Completed";
                dbTrans.UpdatedAt = DateTime.UtcNow;
                context.AuditLogs.Add(new AuditLog { AdminUserName = currentAdminName ?? "Unknown", Action = "Confirmed Withdrawal", TargetUserName = t.UserName, Details = $"Amount: {t.AmountNOK}, Platform: {t.Platform}" });
                await context.SaveChangesAsync();
                await HubContext.Clients.Group(t.UserId).SendAsync("ReceiveUpdate", "Withdrawal confirmed");
                
                if (user != null && !string.IsNullOrEmpty(user.DiscordUserId))
                {
                    await DiscordService.NotifyUserWithdrawalAsync(user.DiscordUserId, t, "Completed");
                }
                _ = ShowSuccess("Withdrawal confirmed.");
            }
            
            await LoadTransactions(context);
        }
    }

    private void StartEditTransaction(Transaction t)
    {
        editingTransactionId = t.Id;
        editingTransactionAmount = t.AmountNOK;
        
        editPendingVipps = "";
        editPendingRevolut = "";
        editPendingBank = "";
        editPendingOtherPlatform = "";
        editPendingOtherDetails = "";

        if (!string.IsNullOrEmpty(t.PaymentDetails))
        {
            var parts = t.PaymentDetails.Split(" | ", StringSplitOptions.RemoveEmptyEntries);
            foreach (var part in parts)
            {
                if (part.StartsWith("Vipps:")) editPendingVipps = part.Substring(6).Trim();
                else if (part.StartsWith("Revolut:")) editPendingRevolut = part.Substring(8).Trim();
                else if (part.StartsWith("Bank Transfer:")) editPendingBank = part.Substring(14).Trim();
                else
                {
                    var split = part.Split(":", 2);
                    if (split.Length == 2)
                    {
                        editPendingOtherPlatform = split[0].Trim();
                        editPendingOtherDetails = split[1].Trim();
                    }
                }
            }
        }
    }

    private void CancelTransactionEdit()
    {
        editingTransactionId = null;
    }

    private async Task SaveTransactionEdit(Transaction t)
    {
        if (editingTransactionAmount <= 0)
        {
            errorMessage = "Amount must be greater than zero.";
            return;
        }

        var validationResult = BettingApp.Services.PaymentValidationHelper.ValidatePaymentMethods(
            editPendingVipps, editPendingRevolut, editPendingBank, editPendingOtherPlatform, editPendingOtherDetails, requireAtLeastOne: true);
            
        if (!validationResult.isValid)
        {
            errorMessage = validationResult.errorMessage;
            return;
        }

        var confirmed = await DialogService.ConfirmAsync( 
            $"Save changes to pending withdrawal?");
        if (!confirmed) return;

        using var context = DbFactory.CreateDbContext();
        var dbTrans = await context.Transactions.FindAsync(t.Id);
        var user = await context.Users.FindAsync(t.UserId);
        
        if (dbTrans != null && user != null && dbTrans.Status == "Pending")
        {
            int oldAmount = dbTrans.AmountNOK;
            int difference = oldAmount - editingTransactionAmount;
            
            if (difference < 0 && user.Balance < Math.Abs(difference))
            {
                var confirmNegative = await DialogService.ConfirmAsync( 
                    $"This edit will result in a negative balance ({user.Balance + difference:N0} kr). Proceed anyway?");
                if (!confirmNegative) return;
            }

            user.Balance += difference;
            dbTrans.AmountNOK = editingTransactionAmount;
            
            var newDetailsList = new List<string>();
            if (!string.IsNullOrWhiteSpace(editPendingVipps)) newDetailsList.Add($"Vipps: {editPendingVipps.Trim()}");
            if (!string.IsNullOrWhiteSpace(editPendingRevolut)) newDetailsList.Add($"Revolut: {editPendingRevolut.Trim()}");
            if (!string.IsNullOrWhiteSpace(editPendingBank)) newDetailsList.Add($"Bank Transfer: {editPendingBank.Trim()}");
            if (!string.IsNullOrWhiteSpace(editPendingOtherPlatform) && !string.IsNullOrWhiteSpace(editPendingOtherDetails))
                newDetailsList.Add($"{editPendingOtherPlatform.Trim()}: {editPendingOtherDetails.Trim()}");

            string newDetailsStr = string.Join(" | ", newDetailsList);

            string oldDetails = dbTrans.PaymentDetails ?? "";
            dbTrans.PaymentDetails = newDetailsStr;
            
            dbTrans.UpdatedAt = DateTime.UtcNow;

            context.AuditLogs.Add(new AuditLog { 
                AdminUserName = currentAdminName ?? "Unknown", 
                Action = "Edited Pending Withdrawal", 
                TargetUserName = t.UserName, 
                Details = $"ID: {t.Id}, OldAmt: {oldAmount}, NewAmt: {editingTransactionAmount}, OldDet: {oldDetails}, NewDet: {newDetailsStr}" 
            });
            
            await context.SaveChangesAsync();
            await HubContext.Clients.Group(t.UserId).SendAsync("ReceiveUpdate", "Withdrawal amount updated");
            
            _ = ShowSuccess($"Withdrawal amount updated to {editingTransactionAmount} kr.");
            editingTransactionId = null;
            await LoadTransactions(context);
        }
    }

    private async Task RejectWithdraw(Transaction t)
    {
        var confirmed = await DialogService.ConfirmAsync( "Reject this withdrawal request?");
        if (!confirmed) return;

        using var context = DbFactory.CreateDbContext();
        var dbTrans = await context.Transactions.FindAsync(t.Id);
        var user = await context.Users.FindAsync(t.UserId);
        if (dbTrans != null && user != null)
        {
            dbTrans.Status = "Rejected";
            dbTrans.UpdatedAt = DateTime.UtcNow;
            
            user.Balance += t.AmountNOK;
            context.AuditLogs.Add(new AuditLog { AdminUserName = currentAdminName ?? "Unknown", Action = "Rejected Withdrawal", TargetUserName = t.UserName, Details = $"Amount: {t.AmountNOK}, ID: {t.Id}" });
            await context.SaveChangesAsync();
            
            await HubContext.Clients.Group(t.UserId).SendAsync("ReceiveUpdate", "Withdrawal rejected");
            if (!string.IsNullOrEmpty(user.DiscordUserId))
            {
                await DiscordService.NotifyUserWithdrawalAsync(user.DiscordUserId, t, "Rejected");
            }
            _ = ShowSuccess("Withdrawal rejected.");
            await LoadTransactions(context);
        }
    }



    private async Task AddTransaction()
    {
        successMessage = null;
        errorMessage = null;

        if (string.IsNullOrEmpty(newTrans.Platform) || !adminAddAmount.HasValue || adminAddAmount.Value <= 0)
        {
            errorMessage = "Please enter valid amount and platform.";
            return;
        }
        if (newTrans.Type != "Free Bet" && addTransSenderType == "User" && string.IsNullOrEmpty(addTransSenderId)) { errorMessage = "Select Sender User"; return; }
        if (addTransReceiverType == "User" && string.IsNullOrEmpty(addTransReceiverId)) { errorMessage = "Select Receiver User"; return; }
        
        if (newTrans.Type != "Free Bet" && addTransSenderType == addTransReceiverType && addTransSenderId == addTransReceiverId)
        {
            errorMessage = "Sender and Receiver cannot be the exact same.";
            return;
        }

        if (newTrans.Type != "Free Bet")
        {
            string? vipps = newTrans.Platform == "Vipps" ? newTrans.PaymentDetails : null;
            string? revolut = newTrans.Platform == "Revolut" ? newTrans.PaymentDetails : null;
            string? bank = newTrans.Platform == "Bank Transfer" ? newTrans.PaymentDetails : null;
            string? otherPlatform = newTrans.Platform == "Other" ? otherPlatformName : null;
            string? otherDetails = newTrans.Platform == "Other" ? newTrans.PaymentDetails : null;

            var validationResult = BettingApp.Services.PaymentValidationHelper.ValidatePaymentMethods(
                vipps, revolut, bank, otherPlatform, otherDetails, requireAtLeastOne: true);

            if (!validationResult.isValid)
            {
                errorMessage = validationResult.errorMessage;
                return;
            }
        }
        
        using var context = DbFactory.CreateDbContext();
        
        decimal amount = adminAddAmount.Value;
        
        if (newTrans.Type != "Free Bet" && newTrans.Platform == "Other") {
            newTrans.Platform = otherPlatformName;
        }
        else if (newTrans.Type == "Free Bet") {
            newTrans.Platform = "Free Bet";
        }

        
        // 1. Resolve Sender
        ApplicationUser? senderUser = null;
        CashCow? senderCC = null;
        if (addTransSenderType == "User") senderUser = await context.Users.FindAsync(addTransSenderId);
        else if (addTransSenderType == "CashCow") senderCC = await context.CashCows.FindAsync(addTransSenderId);
        
        // 2. Resolve Receiver
        ApplicationUser? receiverUser = null;
        CashCow? receiverCC = null;
        if (addTransReceiverType == "User") receiverUser = await context.Users.FindAsync(addTransReceiverId);
        else if (addTransReceiverType == "CashCow") receiverCC = await context.CashCows.FindAsync(addTransReceiverId);

        newTrans.AmountNOK = (int)amount;
        newTrans.Date = DateTime.UtcNow;
        newTrans.UpdatedAt = DateTime.UtcNow;
        newTrans.Status = "Completed";
        
        newTrans.SenderType = addTransSenderType;
        newTrans.SenderId = addTransSenderId;
        newTrans.SenderName = senderUser != null ? senderUser.FirstName + " " + senderUser.LastName : (senderCC != null ? senderCC.FirstName + " " + senderCC.LastName : "Unknown");
        
        newTrans.ReceiverType = addTransReceiverType;
        newTrans.ReceiverId = addTransReceiverId;
        newTrans.ReceiverName = receiverUser != null ? receiverUser.FirstName + " " + receiverUser.LastName : (receiverCC != null ? receiverCC.FirstName + " " + receiverCC.LastName : "Unknown");

        // Helper to create a base transaction row
        Transaction CreateBaseTx() => new Transaction
        {
            AmountNOK = (int)amount,
            Date = DateTime.UtcNow,
            UpdatedAt = DateTime.UtcNow,
            Status = "Completed",
            Platform = newTrans.Platform,
            PaymentDetails = newTrans.PaymentDetails,
            SenderType = addTransSenderType,
            SenderId = addTransSenderId,
            SenderName = senderUser != null ? $"{senderUser.FirstName} {senderUser.LastName}" : (senderCC != null ? $"{senderCC.FirstName} {senderCC.LastName}" : "Unknown"),
            ReceiverType = addTransReceiverType,
            ReceiverId = addTransReceiverId,
            ReceiverName = receiverUser != null ? $"{receiverUser.FirstName} {receiverUser.LastName}" : (receiverCC != null ? $"{receiverCC.FirstName} {receiverCC.LastName}" : "Unknown")
        };

        var transactionsToAdd = new List<Transaction>();
        
        // ==========================================
        // THE AUTOMATED ROUTING ENGINE
        // ==========================================

        if (newTrans.Type == "Free Bet")
        {
            if (receiverUser != null) {
                receiverUser.FreeBetBalance += amount;
                var tx = CreateBaseTx();
                tx.Type = "Free Bet";
                tx.UserId = receiverUser.Id;
                tx.UserName = receiverUser.UserName ?? "";
                transactionsToAdd.Add(tx);
            }
        }
        else 
        {
            // Intercept pending withdrawals to dynamically reduce their requested amount
            if (addTransReceiverType == "User" && receiverUser != null)
            {
                var pendingW = await context.Transactions
                    .Where(t => t.UserId == receiverUser.Id && t.Type == "Withdrawal" && t.Status == "Pending")
                    .OrderBy(t => t.Date)
                    .FirstOrDefaultAsync();
                    
                if (pendingW != null)
                {
                    // Deduct the amount from the pending request.
                    // We explicitly allow this to reach 0 or go negative so admins maintain manual oversight
                    // and can physically click 'Confirm' themselves.
                    pendingW.AmountNOK -= (int)amount;
                }
            }

            // 1. Process Sender (Gives physical cash => Gets digital balance / Deducts CC)
            if (addTransSenderType == "User" && senderUser != null)
            {
                senderUser.Balance += amount;
                var txSender = CreateBaseTx();
                txSender.Type = "Deposit";
                txSender.UserId = senderUser.Id;
                txSender.UserName = senderUser.UserName ?? "";
                transactionsToAdd.Add(txSender);
            }
            else if (addTransSenderType == "CashCow" && senderCC != null)
            {
                senderCC.Balance -= amount;
            }

            // 2. Process Receiver (Gets physical cash => Loses digital balance / Adds CC)
            if (addTransReceiverType == "User" && receiverUser != null)
            {
                receiverUser.Balance -= amount;
                var txReceiver = CreateBaseTx();
                txReceiver.Type = "Withdrawal";
                txReceiver.UserId = receiverUser.Id;
                txReceiver.UserName = receiverUser.UserName ?? "";
                transactionsToAdd.Add(txReceiver);
            }
            else if (addTransReceiverType == "CashCow" && receiverCC != null)
            {
                receiverCC.Balance += amount;
            }

            if (addTransSenderType == "CashCow" && addTransReceiverType == "CashCow")
            {
                var txTransfer = CreateBaseTx();
                txTransfer.Type = "Transfer";
                txTransfer.UserId = ""; 
                txTransfer.UserName = "System";
                transactionsToAdd.Add(txTransfer);
            }
        }

        context.Transactions.AddRange(transactionsToAdd);
        var auditAction = string.Join(" & ", transactionsToAdd.Select(t => t.Type).Distinct());
        context.AuditLogs.Add(new AuditLog { AdminUserName = currentAdminName ?? "Unknown", Action = $"Added {auditAction}", TargetUserName = "Multiple", Details = $"Amount: {amount}, From: {addTransSenderType}, To: {addTransReceiverType}" });
        await context.SaveChangesAsync();

        foreach (var tx in transactionsToAdd)
        {
            if (tx.Type == "Withdrawal")
            {
                var user = await context.Users.FindAsync(tx.UserId);
                if (user != null && !string.IsNullOrEmpty(user.DiscordUserId))
                {
                    await DiscordService.NotifyUserWithdrawalAsync(user.DiscordUserId, tx, "Completed");
                    await HubContext.Clients.Group(user.Id).SendAsync("ReceiveUpdate", "Withdrawal processed");
                }
            }
            else if (tx.Type == "Deposit")
            {
                var user = await context.Users.FindAsync(tx.UserId);
                if (user != null && !string.IsNullOrEmpty(user.DiscordUserId))
                {
                    await DiscordService.NotifyUserDepositAsync(user.DiscordUserId, tx.AmountNOK);
                    await HubContext.Clients.Group(user.Id).SendAsync("ReceiveUpdate", "Deposit processed");
                }
            }
        }
        
        _ = ShowSuccess("Transaction added & balances dynamically routed successfully!");
        ClearForm();
        
        await LoadTransactions(context);
    }

