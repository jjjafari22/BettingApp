@page "/admin/transactions"
<PageTitle>Transactions - Castle of Happiness</PageTitle>
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.SignalR
@using Microsoft.AspNetCore.SignalR.Client
@using BettingApp.Hubs
@using BettingApp.Data
@using BettingApp.Services
@using Microsoft.EntityFrameworkCore
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IHubContext<BetHub> HubContext
@inject IJSRuntime JSRuntime
@inject DiscordNotificationService DiscordService
@inject BettingApp.Services.DialogService DialogService
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: true))

<h3>Manage Transactions</h3>

@if (isInitializing)
{
    <LoadingData Text="Loading Transactions..." />
}
else
{

@if (successMessage != null)
{
    <div class="alert alert-success alert-dismissible fade show position-fixed top-0 start-50 translate-middle-x mt-4 shadow" role="alert" style="z-index: 1055; min-width: 300px;">
        <i class="bi bi-bell-fill me-2"></i> @successMessage
        <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
    </div>
}

@if (errorMessage != null)
{
    <div class="alert alert-danger alert-dismissible fade show position-fixed top-0 start-50 translate-middle-x mt-4 shadow" role="alert" style="z-index: 1055; min-width: 300px;">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @errorMessage
        <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
    </div>
}

<ul class="nav nav-tabs mb-4">
    <li class="nav-item">
        <a class="nav-link @(activeTab == "pending" ? "active" : "")" style="cursor: pointer;" @onclick='() => activeTab = "pending"'>
            <i class="bi bi-list-check me-2"></i> Transactions Overview
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(activeTab == "cashcows" ? "active" : "")" style="cursor: pointer;" @onclick='() => activeTab = "cashcows"'>
            <i class="bi bi-wallet2 me-2"></i> Cash Cows
        </a>
    </li>
</ul>

@if (activeTab == "pending")
{
<div class="card border-warning mb-4">
    <div class="card-header bg-warning text-dark">
        <strong>Pending Withdraw Requests</strong>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Date (Local)</th>
                        <th>Date (Norway)</th>
                        <th>Discord Username</th>
                        <th>Full Name</th>
                        <th>Payment Method</th>
                        <th>Amount</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (pendingWithdrawals.Count == 0)
                    {
                        <tr><td colspan="7" class="text-center text-muted p-3">No pending withdrawals.</td></tr>
                    }
                    @foreach (var w in pendingWithdrawals)
                    {
                        <tr>
                            <td>@ToUserLocal(w.Date).ToString("g")</td>
                            <td>@TimeHelpers.GetNorwayTime(w.Date).ToString("g")</td>
                            <td>@(userLookup.TryGetValue(w.UserId, out var u) && !string.IsNullOrEmpty(u.DiscordName) ? u.DiscordName : w.UserName)</td>
                            <td>@(userLookup.TryGetValue(w.UserId, out var u2) ? $"{u2.FirstName} {u2.LastName}".Trim() : "")</td>
                            <td>
                                @w.Platform
                                @if (editingTransactionId == w.Id)
                                {
                                    <div class="mt-1 d-flex flex-column gap-1">
                                        <input type="text" class="form-control form-control-sm" placeholder="Vipps" @bind="editPendingVippsBound" @bind:event="oninput" />
                                        <input type="text" class="form-control form-control-sm" placeholder="Revolut" @bind="editPendingRevolutBound" @bind:event="oninput" />
                                        <input type="text" class="form-control form-control-sm" placeholder="Bank" @bind="editPendingBankBound" @bind:event="oninput" />
                                        <div class="input-group input-group-sm">
                                            <input type="text" class="form-control" placeholder="Platform" @bind="editPendingOtherPlatform" />
                                            <input type="text" class="form-control" placeholder="Details" @bind="editPendingOtherDetails" />
                                        </div>
                                    </div>
                                }
                                else if(!string.IsNullOrEmpty(w.PaymentDetails)) {
                                    foreach (var detail in w.PaymentDetails.Split('|', StringSplitOptions.RemoveEmptyEntries))
                                    {
                                        <div class="text-muted small">@detail.Trim()</div>
                                    }
                                }
                            </td>
                            <td>
                                @if (editingTransactionId == w.Id)
                                {
                                    <div class="input-group input-group-sm" style="max-width: 120px;">
                                        <input type="number" class="form-control" @bind="editingTransactionAmount" />
                                        <span class="input-group-text">kr</span>
                                    </div>
                                }
                                else
                                {
                                    <strong>@w.AmountNOK.ToString("N0") kr</strong>
                                    @if(w.FulfilledAmount > 0)
                                    {
                                        <div class="text-success small">Fulfilled: @w.FulfilledAmount.ToString("N0") kr</div>
                                        <div class="text-danger small">Left: @((w.AmountNOK - w.FulfilledAmount).ToString("N0")) kr</div>
                                    }
                                }
                            </td>
                            <td>
                                @if (editingTransactionId == w.Id)
                                {
                                    <div class="d-flex flex-nowrap gap-1">
                                        <button class="btn btn-primary btn-sm" @onclick="() => SaveTransactionEdit(w)">Save</button>
                                        <button class="btn btn-secondary btn-sm" @onclick="CancelTransactionEdit">Cancel</button>
                                    </div>
                                }
                                else
                                {
                                    <div class="d-flex flex-nowrap gap-1">
                                        <button class="btn btn-success btn-sm" @onclick="() => ConfirmWithdraw(w)">Confirm</button>
                                        <button class="btn btn-warning btn-sm" @onclick="() => StartEditTransaction(w)">Edit</button>
                                        <button class="btn btn-danger btn-sm" @onclick="() => RejectWithdraw(w)">Reject</button>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12 mb-4">
        <div class="card">
             <div class="card-header bg-primary text-white">Add Transaction</div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-12 mb-3">
                        <label class="fw-bold mb-2">Transaction Type</label>
                        <div class="btn-group w-100" role="group">
                            <input type="radio" class="btn-check" name="typeRadio" id="typeTransaction" autocomplete="off" 
                                   checked="@(newTrans.Type == "Deposit")" @onclick='() => { newTrans.Type = "Deposit"; ClearForm(); }'>
                            <label class="btn btn-outline-primary" for="typeTransaction">
                                <i class="bi bi-currency-exchange me-1"></i> Transaction
                            </label>

                            <input type="radio" class="btn-check" name="typeRadio" id="typeFreeBet" autocomplete="off" 
                                   checked="@(newTrans.Type == "Free Bet")" @onclick='() => { newTrans.Type = "Free Bet"; ClearForm(); }'>
                            <label class="btn btn-outline-info" for="typeFreeBet">
                                <i class="bi bi-gift me-1"></i> Free Bet
                            </label>
                        </div>
                    </div>
                    @if (newTrans.Type != "Free Bet")
                    {
                    <!-- SENDER -->
                    <div class="col-md-5 mb-3 border rounded p-3 bg-light">
                        <h6 class="fw-bold text-success"><i class="bi bi-arrow-up-right-circle me-1"></i> Sender (Who paid the money?)</h6>
                        <div class="btn-group w-100 mb-2" role="group">
                            <input type="radio" class="btn-check" name="senderType" id="senderUser" autocomplete="off" 
                                   checked="@(addTransSenderType == "User")" @onclick='() => { addTransSenderType = "User"; addTransSenderId = ""; selectedSenderUser = null; senderSearchTerm = ""; }'>
                            <label class="btn btn-outline-secondary btn-sm" for="senderUser">User</label>
                            
                            <input type="radio" class="btn-check" name="senderType" id="senderCC" autocomplete="off" 
                                   checked="@(addTransSenderType == "CashCow")" @onclick='() => { addTransSenderType = "CashCow"; addTransSenderId = ""; selectedSenderUser = null; senderSearchTerm = ""; }'>
                            <label class="btn btn-outline-secondary btn-sm" for="senderCC">Cash Cow</label>
                        </div>
                        
                        @if (addTransSenderType == "CashCow")
                        {
                            <select class="form-select" @bind="addTransSenderId">
                                <option value="">-- Select Cash Cow --</option>
                                @foreach (var cow in cashCows) { <option value="@cow.Id">@cow.FirstName @cow.LastName</option> }
                            </select>
                            @if (!string.IsNullOrEmpty(addTransSenderId)) {
                                var cc = cashCows.FirstOrDefault(c => c.Id == addTransSenderId);
                                if (cc != null) {
                                    <div class="mt-2 p-2 bg-white border rounded small shadow-sm d-flex justify-content-between">
                                        <span class="text-muted">CC Balance:</span><span class="fw-bold @(cc.Balance >= 0 ? "text-success" : "text-danger")">@cc.Balance.ToString("N0") kr</span>
                                    </div>
                                }
                            }
                        }
                        else if (addTransSenderType == "User")
                        {
                            <div class="position-relative">
                                <input type="text" class="form-control" placeholder="Search Discord User..." @bind="senderSearchTerm" @bind:event="oninput" @bind:after="SearchSender" />
                                @if (senderSearchResults.Any())
                                {
                                    <ul class="list-group position-absolute w-100 shadow" style="z-index: 1000; max-height: 200px; overflow-y: auto;">
                                        @foreach (var u in senderSearchResults)
                                        {
                                            <li class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" style="cursor: pointer;" @onclick="() => { addTransSenderId = u.Id; senderSearchTerm = u.DiscordUsername ?? u.UserName; selectedSenderUser = u; senderSearchResults.Clear(); }">
                                                <div><strong>@u.DiscordUsername</strong> <small>(@u.FirstName @u.LastName)</small></div>
                                                <span class="badge @(u.Balance >= 0 ? "bg-success" : "bg-danger") rounded-pill">@u.Balance.ToString("N0") kr</span>
                                            </li>
                                        }
                                    </ul>
                                }
                            </div>
                            @if (selectedSenderUser != null) {
                                <div class="mt-2 p-2 bg-white border rounded small shadow-sm">
                                    <div class="d-flex justify-content-between text-muted"><span>User Balance:</span><span class="fw-bold @(selectedSenderUser.Balance >= 0 ? "text-success" : "text-danger")">@selectedSenderUser.Balance.ToString("N0") kr</span></div>
                                    <div class="text-success"><small>Selected: <strong>@selectedSenderUser.DiscordUsername</strong> (@selectedSenderUser.FirstName @selectedSenderUser.LastName)</small></div>
                                </div>
                            }
                        }
                    </div>

                    }
                    <!-- RECEIVER -->
                    <div class="col-md-5 mb-3 border rounded p-3 bg-light ms-md-3">
                        <h6 class="fw-bold text-primary"><i class="bi bi-arrow-down-right-circle me-1"></i> Receiver (Who got the money?)</h6>
                        <div class="btn-group w-100 mb-2" role="group">
                            <input type="radio" class="btn-check" name="receiverType" id="receiverUser" autocomplete="off" 
                                   checked="@(addTransReceiverType == "User")" @onclick='() => { addTransReceiverType = "User"; addTransReceiverId = ""; selectedReceiverUser = null; receiverSearchTerm = ""; AutoFillPaymentDetails(); }'>
                            <label class="btn btn-outline-secondary btn-sm" for="receiverUser">User</label>
                            
                            @if (newTrans.Type != "Free Bet") {
                                <input type="radio" class="btn-check" name="receiverType" id="receiverCC" autocomplete="off" 
                                       checked="@(addTransReceiverType == "CashCow")" @onclick='() => { addTransReceiverType = "CashCow"; addTransReceiverId = ""; selectedReceiverUser = null; receiverSearchTerm = ""; AutoFillPaymentDetails(); }'>
                                <label class="btn btn-outline-secondary btn-sm" for="receiverCC">Cash Cow</label>
                            }
                        </div>
                        
                        @if (addTransReceiverType == "CashCow")
                        {
                            <select class="form-select" @bind="addTransReceiverId" @bind:after="AutoFillPaymentDetails">
                                <option value="">-- Select Cash Cow --</option>
                                @foreach (var cow in cashCows) { <option value="@cow.Id">@cow.FirstName @cow.LastName</option> }
                            </select>
                            @if (!string.IsNullOrEmpty(addTransReceiverId)) {
                                var cc = cashCows.FirstOrDefault(c => c.Id == addTransReceiverId);
                                if (cc != null) {
                                    <div class="mt-2 p-2 bg-white border rounded small shadow-sm d-flex justify-content-between">
                                        <span class="text-muted">CC Balance:</span><span class="fw-bold @(cc.Balance >= 0 ? "text-success" : "text-danger")">@cc.Balance.ToString("N0") kr</span>
                                    </div>
                                }
                            }
                        }
                        else if (addTransReceiverType == "User")
                        {
                            <div class="position-relative">
                                <input type="text" class="form-control" placeholder="Search Discord User..." @bind="receiverSearchTerm" @bind:event="oninput" @bind:after="SearchReceiver" />
                                @if (receiverSearchResults.Any())
                                {
                                    <ul class="list-group position-absolute w-100 shadow" style="z-index: 1000; max-height: 200px; overflow-y: auto;">
                                        @foreach (var u in receiverSearchResults)
                                        {
                                            <li class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" style="cursor: pointer;" @onclick="() => { addTransReceiverId = u.Id; receiverSearchTerm = u.DiscordUsername ?? u.UserName; selectedReceiverUser = u; receiverSearchResults.Clear(); AutoFillPaymentDetails(); }">
                                                <div><strong>@u.DiscordUsername</strong> <small>(@u.FirstName @u.LastName)</small></div>
                                                <span class="badge @(u.Balance >= 0 ? "bg-success" : "bg-danger") rounded-pill">@u.Balance.ToString("N0") kr</span>
                                            </li>
                                        }
                                    </ul>
                                }
                            </div>
                                @if (selectedReceiverUser != null) {
                                    <div class="mt-2 p-2 bg-white border rounded small shadow-sm">
                                        <div class="d-flex justify-content-between text-muted"><span>User Balance:</span><span class="fw-bold @(selectedReceiverUser.Balance >= 0 ? "text-success" : "text-danger")">@selectedReceiverUser.Balance.ToString("N0") kr</span></div>
                                        <div class="text-success"><small>Selected: <strong>@selectedReceiverUser.DiscordUsername</strong> (@selectedReceiverUser.FirstName @selectedReceiverUser.LastName)</small></div>
                                    </div>
                                }
                            }
                        </div>
                        
                    <div class="col-md-12 mb-3">
                        <div class="alert alert-info py-2 small shadow-sm">
                            <i class="bi bi-info-circle-fill me-1"></i> <strong>Automated Engine:</strong> Just log who sent money to who. If the receiver has a pending withdrawal, the system will automatically fulfill it without double-deducting balances!
                        </div>
                    </div>

                    

                    <div class="col-md-3 mb-3">
                        <label class="fw-bold">Amount (NOK)</label>
                        <input type="number" class="form-control" @bind="adminAddAmount" @bind:event="oninput" />
                    </div>
                    
                    @if (newTrans.Type == "Free Bet")
                    {
                         <div class="col-md-6 mb-3">
                            <label class="fw-bold">Note (e.g. Promotional)</label>
                            @if (addTransReceiverType == "CashCow") {
                                    <div class="p-2 border rounded bg-light fw-bold text-primary font-monospace shadow-sm">
                                        <i class="bi bi-wallet2 me-2"></i>@(string.IsNullOrEmpty(newTrans.PaymentDetails) ? "No details provided" : newTrans.PaymentDetails)
                                    </div>
                                } else {
                                    <input type="text" class="form-control" @bind="newTrans.PaymentDetails" />
                                }
                        </div>
                    }
                    else
                    {
                        <div class="col-md-6 mb-3">
                            <label class="fw-bold">Payment Method</label>
                            <select class="form-select" value="@newTrans.Platform" @onchange="OnPlatformChanged">
                                <option value="Vipps">Vipps</option>
                                <option value="Revolut">Revolut</option>
                                <option value="Bank Transfer">Bank Transfer</option>
                                <option value="Other">Other Payment</option>
                            </select>
                        </div>
                        
                        @if (newTrans.Platform == "Other")
                        {
                            <div class="col-md-5 mb-3">
                                <label class="fw-bold">Platform Name (e.g. PayPal)</label>
                                @if (addTransReceiverType == "CashCow" || isPaymentDetailsAutoFilled) {
                                    <div class="p-2 border rounded bg-light fw-bold text-primary shadow-sm">
                                        @(string.IsNullOrEmpty(otherPlatformName) ? "None" : otherPlatformName)
                                    </div>
                                } else {
                                    <input type="text" class="form-control" @bind="otherPlatformName" />
                                }
                            </div>
                            <div class="col-md-7 mb-3">
                                <label class="fw-bold">Payment Details</label>
                                @if (addTransReceiverType == "CashCow" || isPaymentDetailsAutoFilled) {
                                    <div class="p-2 border rounded bg-light fw-bold text-primary font-monospace shadow-sm">
                                        <i class="bi bi-wallet2 me-2"></i>@(string.IsNullOrEmpty(newTrans.PaymentDetails) ? "No details provided" : newTrans.PaymentDetails)
                                    </div>
                                } else {
                                    <input type="text" class="form-control" @bind="newTransPaymentDetailsBound" @bind:event="oninput" />
                                }
                            </div>
                        }
                        else
                        {
                            <div class="col-md-12 mb-3">
                                <label class="fw-bold">
                                    @if (newTrans.Platform == "Vipps") { <text>Phone Number</text> }
                                    else if (newTrans.Platform == "Revolut") { <text>Revtag/Username</text> }
                                    else { <text>Bank Account Number</text> }
                                </label>
                                @if (addTransReceiverType == "CashCow" || isPaymentDetailsAutoFilled) {
                                    <div class="p-2 border rounded bg-light fw-bold text-primary font-monospace shadow-sm">
                                        <i class="bi bi-wallet2 me-2"></i>@(string.IsNullOrEmpty(newTrans.PaymentDetails) ? "No details provided" : newTrans.PaymentDetails)
                                    </div>
                                } else {
                                    <input type="text" class="form-control" @bind="newTransPaymentDetailsBound" @bind:event="oninput" />
                                }
                            </div>
                        }
                    }

                    <div class="col-md-12">
                        <button class="btn btn-primary w-100 fw-bold" @onclick="AddTransaction" disabled="@(!adminAddAmount.HasValue || adminAddAmount.Value <= 0 || (newTrans.Type != "Free Bet" && newTrans.Platform == "Other" && string.IsNullOrEmpty(otherPlatformName)))">Execute Transaction</button>
                    
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-3">
    <h4 class="mb-0">Transaction History (@totalTransactions)</h4>
    
    <div class="d-flex gap-2 flex-wrap align-items-start">
        <select class="form-select form-select-sm" style="width: auto;" @onchange="OnTypeFilterChanged">
            <option value="">All Types</option>
            <option value="Deposit">Deposits</option>
            <option value="Withdrawal">Withdrawals</option>
            <option value="Free Bet">Free Bets</option>
        </select>
        
        <select class="form-select form-select-sm" style="width: auto;" @onchange="OnStatusFilterChanged">
            <option value="">All Statuses</option>
            <option value="Completed">Completed</option>
            <option value="Rejected">Rejected</option>
            <option value="Cancelled">Cancelled</option>
        </select>

        <div class="position-relative" style="min-width: 250px;">
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control" 
                       placeholder="Filter by user..." 
                       @bind="filterSearchTerm" 
                       @bind:event="oninput" 
                       @bind:after="PerformFilterSearch" />
            </div>
        
        @if (filterSearchResults.Any())
        {
            <ul class="list-group position-absolute w-100 shadow mt-1" style="z-index: 1000; max-height: 200px; overflow-y: auto;">
                @foreach (var user in filterSearchResults)
                {
                    <li class="list-group-item list-group-item-action py-1" 
                        style="cursor: pointer;" 
                        @onclick="() => SelectFilterUser(user)">
                        <strong>@(!string.IsNullOrEmpty(user.DiscordUsername) ? user.DiscordUsername : user.UserName)</strong>
                    </li>
                }
            </ul>
        }
         @if (filterSelectedUser != null)
        {
            <div class="mt-1 small text-success d-flex justify-content-between align-items-center bg-light border rounded px-2 py-1">
                <span class="text-truncate">Filtering: <strong>@(!string.IsNullOrEmpty(filterSelectedUser.DiscordUsername) ? filterSelectedUser.DiscordUsername : filterSelectedUser.UserName)</strong></span>
                <button class="btn btn-link btn-sm p-0 text-danger text-decoration-none" @onclick="ClearFilterSelection"><i class="bi bi-x-circle-fill"></i> clear</button>
             </div>
        }
        </div>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-sm table-striped table-hover align-middle text-nowrap">
        <thead class="table-dark">
            <tr>
                <th class="text-nowrap">Last Updated</th>
                <th>Sender</th>
                <th>Receiver</th>
                <th>Type</th>
                <th>Payment Method</th>
                <th>Amount</th>
                <th>Status</th>
            </tr>
        </thead>
         <tbody>
            @foreach (var t in allTransactions)
            {
                <tr>
                    <td class="text-nowrap">@ToUserLocal(t.UpdatedAt).ToString("g")</td>
                    <td>
                        @if (!string.IsNullOrEmpty(t.SenderId) && userLookup.TryGetValue(t.SenderId, out var su)) {
                            <strong>@su.DiscordName</strong> <small class="text-muted">(@su.FirstName @su.LastName)</small>
                        } else {
                            <strong>@t.SenderName</strong>
                        }
                        @if (t.SenderType == "CashCow") { <span class="badge bg-secondary ms-1">CC</span> }
                    </td>
                    <td>
                        @if (!string.IsNullOrEmpty(t.ReceiverId) && userLookup.TryGetValue(t.ReceiverId, out var ru)) {
                            <strong>@ru.DiscordName</strong> <small class="text-muted">(@ru.FirstName @ru.LastName)</small>
                        } else {
                            <strong>@t.ReceiverName</strong>
                        }
                        @if (t.ReceiverType == "CashCow") { <span class="badge bg-secondary ms-1">CC</span> }
                    </td>
                    <td>
                         @if (t.Type == "Deposit")
                        {
                            <span class="badge bg-success">Deposit</span>
                        }
                        else if (t.Type == "Free Bet")
                        {
                            <span class="badge bg-info text-dark">Free Bet</span>
                        }

                        else if (t.Type == "Transfer")
                        {
                            <span class="badge bg-primary text-light"><i class="bi bi-arrow-left-right me-1"></i> Transfer</span>
                        }
                         else
                        {
                            <span class="badge bg-warning text-dark">@((t.Type == "Withdrawal" ? "Withdraw" : t.Type))</span>
                        }
                    </td>
                    <td>
                        @t.Platform
                        @if(!string.IsNullOrEmpty(t.PaymentDetails)) {
                            foreach (var detail in t.PaymentDetails.Split('|', StringSplitOptions.RemoveEmptyEntries))
                            {
                                <div class="text-muted small">@detail.Trim()</div>
                            }
                        }
                    </td>
                    <td>@t.AmountNOK.ToString("N0") kr</td>
                     <td>
                        @if (t.Status == "Completed")
                        {
                            <span class="badge bg-success">@t.Status</span>
                        }
                        else if (t.Status == "Pending")
                        {
                            <span class="badge bg-warning text-dark">@t.Status</span>
                        }
                        else if (t.Status == "Rejected" || t.Status == "Cancelled")
                        {
                            <span class="badge bg-danger">@t.Status</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@t.Status</span>
                        }
                    </td>
                </tr>
            }
            @if (allTransactions.Count == 0)
            {
                <tr><td colspan="8" class="text-muted text-center py-3">No transactions found for this period/user.</td></tr>
            }
        </tbody>
    </table>
    
    <div class="d-flex justify-content-between align-items-center mt-2 mb-4">
        <button class="btn btn-sm @(currentPage <= 1 ? "btn-outline-secondary" : "btn-primary shadow-sm")" @onclick="PrevPage" disabled="@(currentPage <= 1)">
            <i class="bi bi-arrow-left"></i> Previous
        </button>
        <span class="text-muted fw-bold">Page @currentPage</span>
        <button class="btn btn-sm @(!hasMoreTransactions ? "btn-outline-secondary" : "btn-primary shadow-sm fw-bold")" @onclick="NextPage" disabled="@(!hasMoreTransactions)">
