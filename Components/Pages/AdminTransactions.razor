@code {

    private string activeTab = "pending";
    private ApplicationUser? selectedSenderUser = null;
    private ApplicationUser? selectedReceiverUser = null;
    
    private string newCowVippsBound
    {
        get => newCow.Vipps;
        set
        {
            var digits = new string((value ?? "").Where(char.IsDigit).ToArray());
            if (digits.Length > 8) digits = digits.Substring(0, 8);
            newCow.Vipps = digits;
        }
    }
    
    private string newCowRevolutBound
    {
        get => newCow.Revolut;
        set
        {
            var val = (value ?? "").Trim();
            if (string.IsNullOrEmpty(val) || val == "@") { newCow.Revolut = ""; return; }
            if (!val.StartsWith("@")) val = "@" + val;
            val = "@" + val.Substring(1).Replace("@", "");
            newCow.Revolut = val;
        }
    }
    
    private string newCowBankTransferBound
    {
        get => newCow.BankTransfer;
        set
        {
            var digits = new string((value ?? "").Where(char.IsDigit).ToArray());
            if (digits.Length > 11) digits = digits.Substring(0, 11);
            if (digits.Length <= 4) newCow.BankTransfer = digits;
            else if (digits.Length <= 6) newCow.BankTransfer = $"{digits.Substring(0, 4)}.{digits.Substring(4)}";
            else newCow.BankTransfer = $"{digits.Substring(0, 4)}.{digits.Substring(4, 2)}.{digits.Substring(6)}";
        }
    }
    
    private string newTransPaymentDetailsBound
    {
        get => newTrans.PaymentDetails;
        set
        {
            if (newTrans.Platform == "Vipps")
            {
                var digits = new string((value ?? "").Where(char.IsDigit).ToArray());
                if (digits.Length > 8) digits = digits.Substring(0, 8);
                newTrans.PaymentDetails = digits;
            }
            else if (newTrans.Platform == "Revolut")
            {
                var val = (value ?? "").Trim();
                if (string.IsNullOrEmpty(val) || val == "@") { newTrans.PaymentDetails = ""; return; }
                if (!val.StartsWith("@")) val = "@" + val;
                val = "@" + val.Substring(1).Replace("@", "");
                newTrans.PaymentDetails = val;
            }
            else if (newTrans.Platform == "Bank Transfer")
            {
                var digits = new string((value ?? "").Where(char.IsDigit).ToArray());
                if (digits.Length > 11) digits = digits.Substring(0, 11);
                if (digits.Length <= 4) newTrans.PaymentDetails = digits;
                else if (digits.Length <= 6) newTrans.PaymentDetails = $"{digits.Substring(0, 4)}.{digits.Substring(4)}";
                else newTrans.PaymentDetails = $"{digits.Substring(0, 4)}.{digits.Substring(4, 2)}.{digits.Substring(6)}";
            }
            else
            {
                newTrans.PaymentDetails = value ?? "";
            }
        }
    }
    
    private string editPendingVippsBound
    {
        get => editPendingVipps;
        set
        {
            var digits = new string((value ?? "").Where(char.IsDigit).ToArray());
            if (digits.Length > 8) digits = digits.Substring(0, 8);
            editPendingVipps = digits;
        }
    }
    
    private string editPendingRevolutBound
    {
        get => editPendingRevolut;
        set
        {
            var val = (value ?? "").Trim();
            if (string.IsNullOrEmpty(val) || val == "@") { editPendingRevolut = ""; return; }
            if (!val.StartsWith("@")) val = "@" + val;
            val = "@" + val.Substring(1).Replace("@", "");
            editPendingRevolut = val;
        }
    }
    
    private string editPendingBankBound
    {
        get => editPendingBank;
        set
        {
            var digits = new string((value ?? "").Where(char.IsDigit).ToArray());
            if (digits.Length > 11) digits = digits.Substring(0, 11);
            if (digits.Length <= 4) editPendingBank = digits;
            else if (digits.Length <= 6) editPendingBank = $"{digits.Substring(0, 4)}.{digits.Substring(4)}";
            else editPendingBank = $"{digits.Substring(0, 4)}.{digits.Substring(4, 2)}.{digits.Substring(6)}";
        }
    }
    
    private void OnPlatformChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? "";
        newTrans.Platform = val;
        AutoFillPaymentDetails();
    }
    
    private void AutoFillPaymentDetails()
    {
        string autoFilled = "";
        
        if (addTransReceiverType == "CashCow" && !string.IsNullOrEmpty(addTransReceiverId))
        {
            var cow = cashCows.FirstOrDefault(c => c.Id == addTransReceiverId);
            if (cow != null)
            {
                if (newTrans.Platform == "Vipps") autoFilled = cow.Vipps;
                else if (newTrans.Platform == "Revolut") autoFilled = cow.Revolut;
                else if (newTrans.Platform == "Bank Transfer") autoFilled = cow.BankTransfer;
            }
        }
        else if (addTransReceiverType == "User" && selectedReceiverUser != null)
        {
            var pending = pendingWithdrawals.FirstOrDefault(p => p.UserId == selectedReceiverUser.Id);
            if (pending != null && !string.IsNullOrEmpty(pending.PaymentDetails))
            {
                var parts = pending.PaymentDetails.Split(" | ", StringSplitOptions.RemoveEmptyEntries);
                foreach(var part in parts)
                {
                    if (newTrans.Platform == "Other") {
                        if (!part.StartsWith("Vipps:") && !part.StartsWith("Revolut:") && !part.StartsWith("Bank Transfer:")) {
                            var split = part.Split(":", 2);
                            if (split.Length == 2) {
                                otherPlatformName = split[0].Trim();
                                autoFilled = split[1].Trim();
                            }
                            break;
                        }
                    } else if (part.StartsWith(newTrans.Platform + ":")) {
                        autoFilled = part.Substring(newTrans.Platform.Length + 1).Trim();
                        break;
                    }
                }
            }
        }

        newTrans.PaymentDetails = autoFilled ?? "";
        isPaymentDetailsAutoFilled = !string.IsNullOrEmpty(newTrans.PaymentDetails);
        if (newTrans.Platform == "Other" && string.IsNullOrEmpty(newTrans.PaymentDetails))
        {
            otherPlatformName = "";
        }
    }
    
    private async Task ShowSuccess(string message)
    {
        successMessage = message;
        StateHasChanged();
        await Task.Delay(3000);
        successMessage = null;
        StateHasChanged();
    }
    private List<CashCow> cashCows = new();
    private CashCow newCow = new();
    private CashCow? viewingCow = null;
    private List<Transaction> viewingCowTransactions = new();
    private int viewingCowCurrentPage = 1;
    private bool viewingCowHasMore = false;
    private const int ViewingCowPageSize = 20;

    private async Task OpenCowLedger(CashCow cow)
    {
        viewingCowCurrentPage = 1;
        await LoadCowTransactions(cow);
    }
    
    private async Task NextCowPage() { viewingCowCurrentPage++; await LoadCowTransactions(viewingCow!); }
    private async Task PrevCowPage() { if(viewingCowCurrentPage > 1) { viewingCowCurrentPage--; await LoadCowTransactions(viewingCow!); } }

    private async Task LoadCowTransactions(CashCow cow)
    {
        viewingCow = cow;
        using var context = DbFactory.CreateDbContext();
        
        var query = context.Transactions.Where(t => t.SenderId == cow.Id || t.ReceiverId == cow.Id);
        
        if (ccStartDate.HasValue)
        {
            var startUtc = DateTime.SpecifyKind(ccStartDate.Value.Date.AddMinutes(TimezoneOffset), DateTimeKind.Utc);
            query = query.Where(t => t.Date >= startUtc);
        }
        
        if (ccEndDate.HasValue)
        {
            var endUtc = DateTime.SpecifyKind(ccEndDate.Value.Date.AddDays(1).AddMinutes(TimezoneOffset).AddTicks(-1), DateTimeKind.Utc);
            query = query.Where(t => t.Date <= endUtc);
        }

        var total = await query.CountAsync();
        viewingCowHasMore = total > (viewingCowCurrentPage * ViewingCowPageSize);
        
        viewingCowTransactions = await query
            .OrderByDescending(t => t.UpdatedAt)
            .Skip((viewingCowCurrentPage - 1) * ViewingCowPageSize)
            .Take(ViewingCowPageSize)
            .ToListAsync();
            
        var additionalUserIds = viewingCowTransactions.Select(t => t.SenderId).Concat(viewingCowTransactions.Select(t => t.ReceiverId)).Distinct();
        await PopulateUserLookup(additionalUserIds!);
    }
    private string? editingCowId = null;

    private string addTransSenderType = "User";
    private string addTransSenderId = "";
    private string addTransReceiverType = "User";
    private string addTransReceiverId = "";
    
    private string senderSearchTerm = "";
    private List<ApplicationUser> senderSearchResults = new();
    
    private string receiverSearchTerm = "";
    private List<ApplicationUser> receiverSearchResults = new();

    private bool isInitializing = true;
    private List<Transaction> allTransactions = new();
    private List<Transaction> pendingWithdrawals = new();
    
    private Dictionary<string, (string DiscordName, string FirstName, string LastName)> userLookup = new();
    private Transaction newTrans = new() { Type = "Deposit", Platform = "Vipps", Date = DateTime.UtcNow, Status = "Completed" };
    private int? adminAddAmount; 
    private string otherPlatformName = "";
    private bool isPaymentDetailsAutoFilled = false;
    
    private DateTime? ccStartDate;
    private DateTime? ccEndDate;
    private Dictionary<string, int> ccPeriodNet = new();
    private Dictionary<string, DateTime?> ccLastUpdated = new();
    private string ccSortColumn = "LastUpdated";
    private bool ccSortAscending = false;
    
    private string searchTerm = "";

    private int? editingTransactionId = null;
    private int editingTransactionAmount = 0;
    
    private string editPendingVipps = "";
    private string editPendingRevolut = "";
    private string editPendingBank = "";
    private string editPendingOtherPlatform = "";
    private string editPendingOtherDetails = "";
    private List<ApplicationUser> searchResults = new();
    private ApplicationUser? selectedUser;

    private string filterSearchTerm = "";
    private List<ApplicationUser> filterSearchResults = new();
    private ApplicationUser? filterSelectedUser;
    
    private string? filterType;
    private string? filterStatus;
    
    private string? successMessage;
    private string? errorMessage;
    private string? currentAdminName;
    private HubConnection? hubConnection;
    
    private int currentPage = 1;
    private const int PageSize = 25;
    private bool hasMoreTransactions = false;
    private int totalTransactions = 0;

    private int TimezoneOffset { get; set; }

    private DateTime ToUserLocal(DateTime utcDate)
    {
        if (utcDate == DateTime.MinValue || utcDate == DateTime.MaxValue) return utcDate;
        return utcDate.AddMinutes(-TimezoneOffset);
    }
    
    private async Task PopulateUserLookup(IEnumerable<string> userIds)
    {
        var missingIds = userIds.Except(userLookup.Keys).Distinct().ToList();
        if (missingIds.Any())
        {
            using var context = DbFactory.CreateDbContext();
            var users = await context.Users.Where(u => missingIds.Contains(u.Id)).Select(u => new { u.Id, u.DiscordUsername, u.FirstName, u.LastName }).ToListAsync();
            foreach(var u in users) {
                userLookup[u.Id] = (u.DiscordUsername ?? "", u.FirstName ?? "", u.LastName ?? "");
            }
        }
    }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (HttpContext != null) return; // Prerendering: exit instantly to show spinner

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        currentAdminName = user.Identity?.Name;

        using var context = DbFactory.CreateDbContext();
        var userName = user.Identity?.Name;
        ApplicationUser? dbUser = null;
        if (!string.IsNullOrEmpty(userName))
        {
            dbUser = await context.Users.FirstOrDefaultAsync(u => u.UserName == userName);
        }

        if (dbUser == null || !dbUser.IsAdmin)
        {
            Nav.NavigateTo("/");
            return;
        }

        await LoadTransactions(context);
        isInitializing = false;
    }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try {
                TimezoneOffset = await JSRuntime.InvokeAsync<int>("getBrowserTimeZoneOffset");
                StateHasChanged();
            } catch { }
            
            try { await SetupSignalR(); } catch { }
        }
    }

    

    private async Task SearchSender()
    {
        if (string.IsNullOrWhiteSpace(senderSearchTerm) || senderSearchTerm.Length < 2)
        {
            senderSearchResults.Clear();
            return;
        }
        var searchLower = senderSearchTerm.ToLower();
        using var context = DbFactory.CreateDbContext();
        senderSearchResults = await context.Users
            .Where(u => (u.DiscordUsername != null && u.DiscordUsername.ToLower().Contains(searchLower)) || (u.UserName != null && u.UserName.ToLower().Contains(searchLower)))
            .OrderBy(u => u.DiscordUsername)
            .Take(10)
            .AsNoTracking()
            .ToListAsync();
    }
    
    private async Task SearchReceiver()
    {
        if (string.IsNullOrWhiteSpace(receiverSearchTerm) || receiverSearchTerm.Length < 2)
        {
            receiverSearchResults.Clear();
            return;
        }
        var searchLower = receiverSearchTerm.ToLower();
        using var context = DbFactory.CreateDbContext();
        receiverSearchResults = await context.Users
            .Where(u => (u.DiscordUsername != null && u.DiscordUsername.ToLower().Contains(searchLower)) || (u.UserName != null && u.UserName.ToLower().Contains(searchLower)))
            .OrderBy(u => u.DiscordUsername)
            .Take(10)
            .AsNoTracking()
            .ToListAsync();
    }
    
    private void EditCashCow(CashCow cow)
    {
        editingCowId = cow.Id;
        newCow = new CashCow
        {
            Id = cow.Id,
            FirstName = cow.FirstName,
            LastName = cow.LastName,
            Vipps = cow.Vipps,
            Revolut = cow.Revolut,
            BankTransfer = cow.BankTransfer,
            OtherPlatformName = cow.OtherPlatformName,
            OtherPaymentDetails = cow.OtherPaymentDetails,
            Balance = cow.Balance,
            CreatedAt = cow.CreatedAt
        };
    }

    private async Task SaveCashCow()
    {
        if (string.IsNullOrWhiteSpace(newCow.FirstName)) return;

        var validationResult = BettingApp.Services.PaymentValidationHelper.ValidatePaymentMethods(
            newCow.Vipps, newCow.Revolut, newCow.BankTransfer, newCow.OtherPlatformName, newCow.OtherPaymentDetails, requireAtLeastOne: false);
            
        if (!validationResult.isValid)
        {
            errorMessage = validationResult.errorMessage;
            return;
        }
        
        using var context = DbFactory.CreateDbContext();
        if (editingCowId == null)
        {
            context.CashCows.Add(newCow);
        }
        else
        {
            var dbCow = await context.CashCows.FindAsync(editingCowId);
            if (dbCow != null)
            {
                dbCow.FirstName = newCow.FirstName;
                dbCow.LastName = newCow.LastName;
                dbCow.Vipps = newCow.Vipps;
                dbCow.Revolut = newCow.Revolut;
                dbCow.BankTransfer = newCow.BankTransfer;
            }
        }
        await context.SaveChangesAsync();
        
        editingCowId = null;
        newCow = new CashCow();
        await LoadTransactions(context);
    }



