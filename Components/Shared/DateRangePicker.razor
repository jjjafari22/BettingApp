<div class="d-flex flex-wrap gap-2 align-items-center">
    <div class="btn-group btn-group-sm shadow-sm" role="group">
        <button type="button" class="btn @GetBtnClass("All")" @onclick='() => SetPreset("All")'>All</button>
        <button type="button" class="btn @GetBtnClass("Today")" @onclick='() => SetPreset("Today")'>Today</button>
        <button type="button" class="btn @GetBtnClass("7D")" @onclick='() => SetPreset("7D")'>Last 7D</button>
        <button type="button" class="btn @GetBtnClass("30D")" @onclick='() => SetPreset("30D")'>Last 30D</button>
        <button type="button" class="btn @GetBtnClass("Custom")" @onclick='() => SetPreset("Custom")'>Custom</button>
    </div>
    
    @if (selectedPreset == "Custom")
    {
        <div class="d-flex align-items-center gap-1 shadow-sm rounded p-1 bg-white border">
            <input type="date" class="form-control form-control-sm border-0 bg-light" style="width: auto;" @bind="customStartDate" @bind:after="ApplyCustom" />
            <span class="small text-muted fw-bold px-1">to</span>
            <input type="date" class="form-control form-control-sm border-0 bg-light" style="width: auto;" @bind="customEndDate" @bind:after="ApplyCustom" />
        </div>
    }
</div>

@inject IJSRuntime JSRuntime
@code {
    [Parameter] public DateTime? StartDate { get; set; }
    [Parameter] public EventCallback<DateTime?> StartDateChanged { get; set; }
    
    [Parameter] public DateTime? EndDate { get; set; }
    [Parameter] public EventCallback<DateTime?> EndDateChanged { get; set; }
    
    [Parameter] public EventCallback OnFilterApplied { get; set; }

    [Parameter] public string ButtonClass { get; set; } = "btn-outline-secondary";
    [Parameter] public string ActiveButtonClass { get; set; } = "btn-primary";
    
    private string selectedPreset = "All";
    
    private DateTime? customStartDate;
    private DateTime? customEndDate;
    private int timezoneOffset = 0;
    private bool hasFetchedOffset = false;
    
    private string GetBtnClass(string preset) => selectedPreset == preset ? $"{ActiveButtonClass} fw-bold" : ButtonClass;
    
    protected override void OnInitialized()
    {
        if (StartDate.HasValue || EndDate.HasValue)
        {
            selectedPreset = "Custom";
            customStartDate = StartDate;
            customEndDate = EndDate;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!hasFetchedOffset)
        {
            try
            {
                timezoneOffset = await JSRuntime.InvokeAsync<int>("getBrowserTimeZoneOffset");
                hasFetchedOffset = true;
            }
            catch { }
        }
    }

    private async Task SetPreset(string preset)
    {
        selectedPreset = preset;
        DateTime nowUtc = DateTime.UtcNow;
        DateTime nowLocal = hasFetchedOffset ? nowUtc.AddMinutes(-timezoneOffset) : nowUtc;
        
        if (preset == "All")
        {
            await UpdateDates(null, null);
        }
        else if (preset == "Today")
        {
            // Calculate boundaries in Local Time, then convert back to UTC boundaries
            DateTime startLocal = nowLocal.Date;
            DateTime endLocal = nowLocal.Date.AddDays(1).AddTicks(-1);
            await UpdateDates(hasFetchedOffset ? startLocal.AddMinutes(timezoneOffset) : startLocal, 
                              hasFetchedOffset ? endLocal.AddMinutes(timezoneOffset) : endLocal);
        }
        else if (preset == "7D")
        {
            DateTime startLocal = nowLocal.Date.AddDays(-7);
            await UpdateDates(hasFetchedOffset ? startLocal.AddMinutes(timezoneOffset) : startLocal, null);
        }
        else if (preset == "30D")
        {
            DateTime startLocal = nowLocal.Date.AddDays(-30);
            await UpdateDates(hasFetchedOffset ? startLocal.AddMinutes(timezoneOffset) : startLocal, null);
        }
        else if (preset == "Custom")
        {
            // Do not immediately update dates, wait for Apply
            customStartDate = StartDate;
            customEndDate = EndDate;
        }
    }
    
    private async Task ApplyCustom()
    {
        DateTime? finalStartUtc = null;
        DateTime? finalEndUtc = null;

        if (customStartDate.HasValue)
        {
            DateTime startLocal = customStartDate.Value.Date;
            finalStartUtc = hasFetchedOffset ? startLocal.AddMinutes(timezoneOffset) : startLocal;
        }
        
        if (customEndDate.HasValue) 
        {
            DateTime endLocal = customEndDate.Value.Date.AddDays(1).AddTicks(-1);
            finalEndUtc = hasFetchedOffset ? endLocal.AddMinutes(timezoneOffset) : endLocal;
        }

        await UpdateDates(finalStartUtc, finalEndUtc);
    }
    
    private async Task UpdateDates(DateTime? start, DateTime? end)
    {
        await StartDateChanged.InvokeAsync(start);
        await EndDateChanged.InvokeAsync(end);
        await OnFilterApplied.InvokeAsync();
    }
}
